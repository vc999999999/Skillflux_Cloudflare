cff-version: 1.2.0
message: "If you use this dataset, please cite it as below. For a single result, cite the skill's report page and the run id or commit it names."
type: dataset
title: "SkillFlux agent skill health and benchmark dataset"
version: "1.0.0"
date-released: "2026-10-29"
authors:
  - name: "SkillFlux"
    website: "https://skillflux.app"
url: "https://skillflux.app/data/"
