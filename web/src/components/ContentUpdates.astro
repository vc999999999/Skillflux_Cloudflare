---
import type { CollectionEntry } from 'astro:content';
import type { Site } from '../lib/content';
import { getSiteCopy, localizePath, type Language } from '../lib/i18n';
import Icon from './Icon.astro';

const { sites, insights, lang } = Astro.props as { sites: Site[]; insights: CollectionEntry<'insights'>[]; lang: Language };
const zh = lang === 'zh';
---
<section class="content-updates" aria-labelledby="content-updates-title">
  <header>
    <p class="eyebrow">{zh ? '持续整理 · 按任务选用' : 'RECENT EDITORIAL UPDATES'}</p>
    <h2 id="content-updates-title">{zh ? '最近更新，值得读什么' : 'What to read next'}</h2>
    <p>{zh ? '从能力说明到具体用法，看看这些 Skill 能解决什么问题。' : 'Explore skill capabilities, practical workflows and the limits to consider before using them.'}</p>
  </header>
  <div class="updates-columns">
    <div class="recent-resources">
      <div class="updates-label"><h3>{zh ? '资源能力说明' : 'Updated resource guides'}</h3><a href={localizePath('/directory/', lang)}>{zh ? '全部资源' : 'All resources'} <Icon size={14} /></a></div>
      <ol>{sites.map(site => {
        const copy = getSiteCopy(site, lang);
        return <li><a href={localizePath(`/resource/${site.resourceSlug}/`, lang)}><div><h4>{copy.name}</h4><p>{site.editorial?.primaryCapability[lang] ?? copy.tagline}</p></div><time datetime={site.updatedAt}>{site.updatedAt}</time></a></li>;
      })}</ol>
    </div>
    <div class="recent-insights">
      <div class="updates-label"><h3>{zh ? '最新 Skill 拆解' : 'Latest skill deep-dives'}</h3><a href={localizePath('/insights/', lang)}>{zh ? '全部拆解' : 'All deep-dives'} <Icon size={14} /></a></div>
      {!zh && <p class="language-note">The original articles are in Chinese.</p>}
      {insights.map(entry => <article>
        <div class="insight-label"><span lang="zh-CN">{entry.data.industry}</span><time datetime={entry.data.dateModified}>{entry.data.dateModified}</time></div>
        <h4><a href={`/insights/${entry.id}/`} lang="zh-CN" hreflang="zh-CN">{entry.data.title}</a></h4>
        <p lang="zh-CN">{entry.data.description}</p>
        <a class="read-more" href={`/insights/${entry.id}/`} hreflang="zh-CN">{zh ? '阅读拆解' : 'Read the deep-dive'} <Icon size={14} /></a>
      </article>)}
    </div>
  </div>
</section>
<style>
  .content-updates { padding-top: 56px; }
  header > .eyebrow { color: var(--muted); font-size: .72rem; margin: 0 0 12px; }
  h2 { font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 650; letter-spacing: -.025em; margin: 0 0 12px; }
  header > p:last-child { color: var(--muted); font-size: .9rem; line-height: 1.8; margin: 0 0 28px; }
  .updates-columns { display: grid; grid-template-columns: 1.15fr 1fr; gap: 44px; }
  .updates-columns > div { min-width: 0; }
  .updates-label { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--ink); padding-bottom: 14px; }
  .updates-label h3 { font-size: .88rem; margin: 0; font-weight: 600; }
  .updates-label a, .read-more { display: inline-flex; align-items: center; gap: 5px; font-size: .76rem; text-decoration: none; white-space: nowrap; }
  ol { list-style: none; padding: 0; margin: 0; }
  li { border-bottom: 1px solid var(--line); }
  li > a { display: flex; justify-content: space-between; align-items: baseline; gap: 18px; text-decoration: none; padding: 18px 0; }
  li > a > div { min-width: 0; }
  h4 { font-size: .96rem; line-height: 1.65; font-weight: 600; margin: 0; overflow-wrap: anywhere; }
  li p { color: var(--muted); font-size: .79rem; line-height: 1.7; margin: 5px 0 0; }
  time { font: .68rem var(--font-mono); color: var(--muted); flex-shrink: 0; }
  article { padding: 20px 0; border-bottom: 1px solid var(--line); }
  article h4 a { text-decoration: none; }
  article > p { color: var(--muted); font-size: .83rem; line-height: 1.8; margin: 10px 0 14px; }
  .insight-label { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: .72rem; color: var(--muted); margin-bottom: 10px; }
  .language-note { font-size: .75rem; color: var(--muted); }
  a:hover, li a:hover h4 { color: var(--accent); }
  @media (max-width: 760px) { .updates-columns { grid-template-columns: 1fr; gap: 32px; } .content-updates { padding-top: 40px; } }
  @media (max-width: 420px) { li > a { display: block; } li time { display: block; margin-top: 8px; } }
</style>
