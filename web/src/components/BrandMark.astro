---
// SkillFlux logo mark. `id` keeps the SVG mask unique when the mark appears twice on a page.
type Props = { id: string; size?: number };
const { id, size = 24 } = Astro.props;
const maskId = `sf-mark-mask-${id}`;
---
<svg class="sf-brand-mark" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true"><defs><mask id={maskId}><rect width="64" height="64" fill="#000"/><rect x="6" y="6" width="52" height="52" rx="12" ry="12" fill="#fff"/><rect x="20" y="20" width="24" height="24" rx="4" ry="4" fill="#000"/></mask></defs><g mask={`url(#${maskId})`}><rect x="6" y="6" width="14" height="52" fill="#34A853"/><rect x="6" y="44" width="52" height="14" fill="#FBBC04"/><rect x="6" y="44" width="14" height="14" fill="#188038"/><rect x="44" y="6" width="14" height="52" fill="#EA4335"/><rect x="44" y="44" width="14" height="14" fill="#F29900"/><rect x="6" y="6" width="52" height="14" fill="#4285F4"/><rect x="44" y="6" width="14" height="14" fill="#D93025"/><rect x="6" y="6" width="14" height="14" fill="#1967D2"/></g></svg>
<style>
  .sf-brand-mark { display: block; flex-shrink: 0; }
</style>
