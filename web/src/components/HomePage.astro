---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentUpdates from './ContentUpdates.astro';
import Icon from './Icon.astro';
import RegistryExplorer from './RegistryExplorer.astro';
import { absoluteUrl, getCategories, getDirectoryStats, getIndexableSites, getSiteBySlug, getTagIndex } from '../lib/content';
import { localizePath, translateCategory, translateTag, type Language } from '../lib/i18n';
import { getGuides } from '../lib/guides';
import { scenarios } from '../lib/scenarios';
import { getPublication } from '../lib/publication';
const { lang = 'zh' } = Astro.props as { lang?: Language };
const zh = lang === 'zh';
const href = (path: string) => localizePath(path, lang);
const stats = getDirectoryStats();
const updatedSites = getIndexableSites().sort((a, b) => b.updatedAt.localeCompare(a.updatedAt) || a.resourceSlug.localeCompare(b.resourceSlug)).slice(0, 5);
const latestInsights = (await getCollection('insights', entry => !entry.data.draft))
  .sort((a, b) => b.data.dateModified.localeCompare(a.data.dateModified) || a.id.localeCompare(b.id)).slice(0, 2);
// Keep the editorial date of this page and the dates of the content shown on it.
const homeUpdatedAt = ['2026-10-10', stats.updatedAt, ...latestInsights.map(entry => entry.data.dateModified), ...getGuides().map(guide => guide.dateModified), ...scenarios.slice(1).map(scenario => scenario.updatedAt)].sort().at(-1);
const categories = getCategories();
const tags = getTagIndex().slice(0, 9);
const title = zh ? '想给你的 Agent 增加什么能力？· AI Agent 功能黄页' : 'Capabilities You Want to Add to Your AI Agent · Yellow Pages';
const description = zh ? 'AI Agent 开放功能黄页：想给你的 Agent 增加什么能力？涵盖全网 Skills、MCP 工具、插件与开源生态。按需检索、透明选型，即插即用。' : 'What capabilities do you want to add to your AI agent? The open yellow pages for skills, MCP tools, plugins, and workflows. Search by task, verify quality, and connect on demand.';
const picks = [
  { slug: 'github-com-anthropics-skills', name: 'Anthropic Skills', badge: zh ? '参考实现' : 'Reference', reason: zh ? '从 Anthropic 的开源仓库入手，直接阅读 Skill 的结构与实现。' : 'Read the skill structure and implementations directly in Anthropic’s open-source repository.', best: zh ? '了解 Skill 格式，建立自己的技能库' : 'Learning the format and building a skill library' },
  { slug: 'modelscope-cn-skills', name: 'ModelScope Skills', badge: zh ? '编辑推荐' : 'Recommended', reason: zh ? '中文 Skill 的集中发现入口，适合先浏览场景，再回到原始资料比较。' : 'A starting point for discovering Chinese-language skills and comparing their original sources.', best: zh ? '中文资源发现与场景选型' : 'Finding Chinese-language skill resources' },
  { slug: 'github-com-op7418-humanizer-zh', name: 'Humanizer-zh', badge: zh ? '用途明确' : 'Focused', reason: zh ? '围绕中文写作提供可阅读的规则，方便检查是否符合自己的编辑习惯。' : 'Readable rules for Chinese writing, so you can judge whether the editorial approach fits your work.', best: zh ? '中文文稿编辑与语言润色' : 'Editing and refining Chinese writing' },
].flatMap(pick => { const site = getSiteBySlug(pick.slug); return site ? [{ ...pick, site }] : []; });
const reading = [
  ...getGuides().map(guide => ({ title: guide.title[lang], summary: guide.description[lang], path: `/guides/${guide.slug}/`, type: zh ? '选型指南' : 'GUIDE' })),
  ...scenarios.slice(1).map(scenario => ({ title: scenario.title[lang], summary: scenario.summary[lang], path: `/scenarios/${scenario.slug}/`, type: zh ? '实践指南' : 'WORKFLOW' })),
];
const categoryNotes: Record<string, [string, string]> = {
  official: ['厂商维护的官方资源入口。', 'Resources maintained by tool and platform makers.'],
  marketplace: ['带有发现与安装流程的市场。', 'Catalogs with discovery and installation flows.'],
  repo: ['可阅读源码的仓库与项目。', 'Repositories and projects you can inspect.'],
  community: ['社区整理的榜单与推荐。', 'Community lists and discovery signals.'],
  directory: ['跨来源聚合的导航入口。', 'Directories spanning multiple sources.'],
};
const publication = getPublication();
const command = 'skillflux search "code review"';
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={href('/')} pageClass="sf-home" jsonLd={[
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SkillFlux', url: absoluteUrl(href('/')), description },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: absoluteUrl(href('/')), description, dateModified: homeUpdatedAt }
]}>
  <main id="main-content">
    <section class="home-hero">
      <div class="home-container">
        <p class="hero-label"><span></span> {zh ? '为你的 AI AGENT 扩充能力' : 'CAPABILITIES TO ADD TO YOUR AGENT'}</p>
        <h1>{zh ? <>想给你的 Agent <span class="keep-together">增加什么能力？</span></> : 'Capabilities you want to add to your AI agent.'}<br /><span class="hero-secondary">{zh ? '全网功能黄页 · 按需查找，即插即用。' : 'The open yellow pages · Find and connect on demand.'}</span></h1>
        <p class="hero-description">{description}</p>
        <div class="hero-actions">
          <a class="button primary" href={href('/directory/')}>{zh ? '查找想增加的能力' : 'Find capabilities for your agent'} <Icon size={16} /></a>
          <a class="button secondary" href={href('/install/')}>{zh ? '接入项目' : 'Connect to project'}</a>
          <div class="command-bar"><span aria-hidden="true">$</span><code>{command}</code><button type="button" data-copy-text={command} aria-label={zh ? '复制搜索命令' : 'Copy search command'}><Icon name="copy" size={16} /></button></div>
        </div>
        <div class="works-with"><span>{zh ? '项目接入' : 'Connect with'}</span><span><Icon name="spark" size={15} /> Claude</span><span><Icon name="external" size={15} /> Cursor</span><span><Icon name="terminal" size={15} /> Codex</span><a href={href('/install/')}>{zh ? '查看安装步骤' : 'Setup required'} <span aria-hidden="true">↗</span></a></div>
        <div class="decision-signals"><span>{zh ? '选择线索' : 'DECISION SIGNALS'}</span>{[zh ? '精选推荐' : 'Curated', zh ? '官方来源' : 'Official sources', zh ? '开源生态' : 'Open source', zh ? '按任务选型' : 'Choose by task', zh ? '版本级审核' : 'Reviewed releases'].map(label => <span class="signal">{label}</span>)}<a href={href('/quality/')}>{zh ? '了解标准' : 'How we review'} ↗</a></div>
        <div class="value-steps">
          {[
            ['01 · Discover', zh ? '想增加能力？' : 'Need Capabilities?', zh ? '无论是编程 Skill、MCP 工具、外部插件还是特定工作流，全网一站式查找。' : 'Whether you need specialized coding skills, database MCP tools, or automation plugins, find them here.'],
            ['02 · Verify', zh ? '透明决策' : 'Verify First', zh ? '按任务场景、来源背景与可信度，直观比较与挑选，杜绝劣质垃圾。' : 'Inspect provenance, task fit, and review records before giving anything to your agent.'],
            ['03 · Connect', zh ? '即插即用' : 'Plug & Play', zh ? '通过统一 CLI 与 MCP，将能力安全按需接入 Claude、Cursor、Codex 等项目。' : 'Wire capabilities directly into Claude, Cursor, and Codex on demand with a single runtime.'],
          ].map(([label, name, note], index) => <article><div><span>{label}</span>{index === 1 && <small>{zh ? '核心' : 'core'}</small>}</div><h2>{name}</h2><p>{note}</p></article>)}
        </div>
      </div>
    </section>
    <div class="home-container">
      <dl class="home-stats">
        {[[stats.resourceCount, zh ? '已收录能力' : 'Indexed capabilities', zh ? 'Skills、MCP、工具与插件' : 'Skills, MCP, tools & sources'], [stats.labelCount, zh ? '能力主题' : 'Topics & categories', zh ? '按场景与技术栈发现' : 'Explore by task & domain'], [stats.recommendedCount, zh ? '精选推荐' : 'Curated picks', zh ? '有选用理由与适用边界' : 'High-signal recommendations'], [categories.length, zh ? '来源类别' : 'Source categories', zh ? '从官方厂商到开源社区' : 'Vendors to communities']].map(([count, name, note]) => <div><dd>{count}</dd><dt>{name}</dt><p>{note}</p></div>)}
      </dl>
      <ContentUpdates sites={updatedSites} insights={latestInsights} lang={lang} />
      <section class="home-section" aria-labelledby="picks-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '精选推荐 · 高价值能力' : 'EDITORIAL · CURATED CAPABILITIES'}</p><h2 id="picks-title">SkillFlux Picks</h2><p>{zh ? '从用途明确、资料可追溯的能力来源开始。查看推荐理由和适用场景，再决定是否采用。' : 'High-signal starting points with transparent rationale and practical use cases.'}</p></div><a href={href('/directory/')}>{zh ? '浏览黄页' : 'Browse yellow pages'} <Icon size={16} /></a></div>
        <div class="picks-grid">{picks.map(pick => <article class="pick-card"><div class="pick-label"><span>{pick.badge}</span><small>{translateCategory(pick.site.category, pick.site.category, lang)}</small></div><h3><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{pick.name}</a></h3><div><h4>{zh ? '为什么推荐' : 'WHY WE RECOMMEND IT'}</h4><p>{pick.reason}</p></div><div><h4>{zh ? '适合' : 'BEST FOR'}</h4><p>{pick.best}</p></div><div class="pick-bottom"><span>{zh ? '来源推荐' : 'Source recommendation'}</span><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{zh ? '详情' : 'Details'} <Icon size={14} /></a></div></article>)}</div>
        <p class="quiet-note">{zh ? '功能黄页帮助你发现来源；可安装的审核版本请查看' : 'The yellow pages help you discover sources. For reviewed, installable releases, visit the'} <a href={href('/registry/')}>{zh ? '精品能力库' : 'curated registry'} ↗</a></p>
      </section>
    </div>
    <section class="install-section" aria-labelledby="install-title">
      <div class="home-container">
        <div class="install-grid"><div class="install-intro"><p class="eyebrow">{zh ? '接入运行时 · LOCAL CLI & MCP' : 'CONNECT · RUNTIME LAYER'}</p><h2 id="install-title">{zh ? <>从黄页发现，<br />走向项目落地。</> : <>From discovery<br />to a working project.</>}</h2><p>{zh ? '为项目配置 SkillFlux 入口。按需检索、审核安装计划，随时扩展 Agent 所需的能力。' : 'Connect one SkillFlux runtime to your project. Search, inspect an installation plan, and load reviewed capabilities on demand.'}</p><a class="button primary" href={href('/install/')}>{zh ? '查看安装指南' : 'Open setup guide'} <Icon size={16} /></a><p class="source-note">{zh ? '通过 npm 安装 SkillFlux，需 Node.js ≥ 22.13。' : 'Install SkillFlux from npm. Requires Node.js ≥ 22.13.'}</p><div class="install-flow"><span>{zh ? '发现' : 'Discover'}</span><Icon size={13} /><span>{zh ? '选择' : 'Select'}</span><Icon size={13} /><span>{zh ? '检查' : 'Review'}</span><Icon size={13} /><span>{zh ? '加载' : 'Load'}</span></div></div>
          <div class="terminal-demo"><div class="terminal-title"><span><i></i><i></i><i></i></span><span>~/my-project</span><span>CLI</span></div><div class="terminal-body"><p class="terminal-comment"># {zh ? '完成本地安装和初始化之后' : 'After local installation and project init'}</p><p><span>$</span> skillflux search "code review"</p><p class="terminal-comment"># {zh ? '选定搜索结果中的能力与版本' : 'Choose a capability and version from the results'}</p><p><span>$</span> skillflux plan &lt;skill-id&gt;@&lt;version&gt;</p><p class="terminal-comment"># {zh ? '检查计划，然后使用返回的 plan ID' : 'Inspect the plan, then use its returned ID'}</p><p><span>$</span> skillflux install &lt;plan-id&gt;</p><p><span>$</span> skillflux load &lt;skill-id&gt;</p><div class="terminal-foot"><span class="tiny-dot"></span>{zh ? '项目内安装 · 固定版本 · 显式加载' : 'Project scoped · versioned · explicitly invoked'}</div></div></div>
        </div>
        <div class="install-benefits">{[["terminal", zh ? '一个接入入口' : 'One entry point', zh ? 'CLI 与 MCP 共用同一套版本流程。' : 'One version workflow for CLI and MCP.'], ['layers', zh ? '按项目管理' : 'Per-project installation', zh ? '能力与配置跟随需要它们的项目。' : 'Keep capabilities with the project that uses them.'], ['book', zh ? '可查看的审核记录' : 'Reviewable evidence', zh ? '发布版本附带公开的测试摘要。' : 'Published releases include public test summaries.'], ['code', zh ? '宿主配置适配' : 'Host-specific setup', zh ? '为 Claude、Cursor 和 Codex 生成配置。' : 'Configuration for Claude, Cursor and Codex.']].map(([icon, title, note]) => <div><Icon name={icon} size={19} /><h3>{title}</h3><p>{note}</p></div>)}</div>
      </div>
    </section>
    <div class="home-container">
      {publication.latest.length > 0 && <section class="home-section"><div class="section-top"><div><p class="eyebrow">REVIEWED RELEASES</p><h2>{zh ? '经过审核的能力版本' : 'Reviewed capability releases'}</h2></div><a href={href('/registry/')}>{zh ? '全部版本' : 'All releases'} <Icon size={16} /></a></div><RegistryExplorer lang={lang} mode="preview" /></section>}
      <section class="home-section sources-section" aria-labelledby="sources-title">
        <div class="section-top"><div><p class="eyebrow">NAVIGATE THE ECOSYSTEM</p><h2 id="sources-title">{zh ? '来源类别与主题' : 'Source categories & topics'}</h2><p>{zh ? '了解能力从哪里来，再决定从哪里开始。' : 'Understand where capabilities come from, then decide where to start.'}</p></div><a href={href('/directory/')}>{zh ? '全部黄页来源' : 'All sources'} <Icon size={16} /></a></div>
        <div class="source-type-grid">{categories.map(category => <a href={href(`/source-type/${category.slug}/`)}><div><h3>{translateCategory(category.slug, category.label, lang)}</h3><span>{category.count}</span></div><p>{categoryNotes[category.slug]?.[zh ? 0 : 1]}</p><small>{category.shortLabel.toUpperCase()} <Icon name="external" size={13} /></small></a>)}</div>
        <div class="topic-row"><span>{zh ? '主题' : 'TOPICS'}</span>{tags.map(tag => <a href={href(`/tag/${tag.slug}/`)}># {translateTag(tag.tag, lang)}</a>)}</div>
      </section>
      <section class="home-section" aria-labelledby="guides-title">
        <div class="section-top"><div><p class="eyebrow">GUIDES</p><h2 id="guides-title">{zh ? 'Agent 能力选型与实战指南' : 'Learn the agent ecosystem'}</h2></div><a href={href('/guides/')}>{zh ? '全部指南' : 'All guides'} <Icon size={16} /></a></div>
        <div class="reading-grid">{reading.map(item => <a href={href(item.path)}><small>{item.type}</small><h3>{item.title}</h3><p>{item.summary}</p><span>{zh ? '阅读指南' : 'Read guide'} <Icon size={14} /></span></a>)}</div>
      </section>
      <section class="machine-section"><div><p class="eyebrow">FOR AI</p><h2>{zh ? '为人，也为 Agent。' : 'Built for humans and agents.'}</h2><p>{zh ? '功能黄页、选型指南与审核版本均有机器可读入口，让能力发现直接融入智能体工作流。' : 'Structured access to the capability directory, guides, and reviewed releases. Make capability discovery native to your agent.'}</p><a href={href('/for-ai/')}>{zh ? '探索机器可读入口' : 'Open the machine layer'} <Icon size={16} /></a></div><div class="endpoint-list">{[['/llms.txt', zh ? '简明站点与能力黄页索引' : 'A concise map for LLM context'], ['/llms-full.txt', zh ? '完整能力黄页，纯文本' : 'Full capability yellow pages, plain text'], ['/index.json', zh ? '结构化能力发现数据' : 'Structured discovery data'], ['/feed.xml', zh ? '能力更新订阅' : 'Capability updates via RSS']].map(([path, note]) => <a href={path}><span>GET</span><code>{path}</code><small>{note}</small><Icon name="external" size={14} /></a>)}</div></section>
    </div>
  </main>
</BaseLayout>
<style>
  .home-container { width: min(1088px, calc(100% - 48px)); margin: 0 auto; }
  .home-hero { padding: 80px 0 52px; border-bottom: 1px solid var(--line); }
  .hero-label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 20px; background: var(--paper-strong); font: 500 .75rem var(--font-mono); color: var(--muted); letter-spacing: .06em; box-shadow: var(--shadow-sm); }
  .hero-label > span, .tiny-dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: var(--green); flex: 0 0 auto; }
  h1 { font-size: clamp(2.3rem, 4.4vw, 3.8rem); margin: 0; line-height: 1.12; letter-spacing: -.04em; font-weight: 650; }
  h1 .hero-secondary { color: var(--faint); font-weight: 550; }
  .keep-together { white-space: nowrap; }
  :global(html[lang="zh-CN"]) h1 { line-height: 1.25; letter-spacing: -.04em; }
  .hero-description { max-width: 760px; margin: 24px 0 32px; color: var(--muted); font-size: 1.12rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .command-bar { display: flex; align-items: center; gap: 14px; min-height: 44px; padding: 0 14px; border-radius: var(--radius-md); background: var(--ink); color: var(--paper-strong); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: var(--shadow-card); }
  .command-bar > span { color: var(--dark-muted); }
  .command-bar code { font-size: .8rem; letter-spacing: .01em; }
  .command-bar button { display: inline-flex; align-items: center; justify-content: center; padding: 6px; background: none; border: 0; color: #beb9aa; transition: color .15s ease, transform .15s ease; border-radius: 4px; }
  .command-bar button:hover { color: #fdfcf8; transform: scale(1.05); }
  .command-bar button:active { transform: scale(0.95); }
  .works-with { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 26px; color: var(--muted); font-size: .85rem; }
  .works-with > span { display: inline-flex; gap: 7px; align-items: center; }
  .works-with > span:first-child { font: 500 .75rem var(--font-mono); color: var(--faint); letter-spacing: .04em; }
  .works-with a { color: var(--faint); text-decoration: none; font-size: .8rem; transition: color .15s; }
  .works-with a:hover { color: var(--ink); }
  .decision-signals { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 32px; font-size: .78rem; color: var(--muted); }
  .decision-signals > span:first-child { margin-right: 6px; font: 500 .75rem var(--font-mono); letter-spacing: .06em; color: var(--faint); }
  .signal { border: 1px solid var(--line); padding: 5px 11px; border-radius: 20px; background: var(--paper-strong); font-size: .78rem; color: var(--muted); box-shadow: var(--shadow-sm); }
  .decision-signals a { margin-left: 6px; text-decoration: none; font-size: .78rem; color: var(--muted); }
  .decision-signals a:hover { color: var(--ink); }
  .value-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); margin-top: 48px; box-shadow: var(--shadow-card); }
  .value-steps article { padding: 24px; }
  .value-steps article + article { border-left: 1px solid var(--line); }
  .value-steps article > div { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font: 500 .75rem var(--font-mono); letter-spacing: .04em; }
  .value-steps small { padding: 3px 8px; border-radius: var(--radius-sm); background: var(--green-subtle); color: var(--green); font-size: .75rem; font-weight: 600; }
  .value-steps h2 { font-size: 1.08rem; margin: 12px 0 6px; font-weight: 620; letter-spacing: -.02em; }
  .value-steps p { font-size: .85rem; line-height: 1.65; color: var(--muted); margin: 0; }
  .home-stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 36px 0; margin: 0; border-bottom: 1px solid var(--line); }
  .home-stats div { padding: 4px 28px; border-left: 1px solid var(--line); }
  .home-stats div:first-child { border: 0; padding-left: 0; }
  .home-stats dd { margin: 0 0 8px; font: 500 2.2rem var(--font-mono); letter-spacing: -.06em; color: var(--ink); }
  .home-stats dt { font-size: .88rem; font-weight: 600; color: var(--ink); }
  .home-stats p { font-size: .8rem; margin: 6px 0 0; color: var(--muted); line-height: 1.5; }
  .home-section { padding: 64px 0 0; }
  .section-top { display: flex; gap: 24px; justify-content: space-between; align-items: end; margin-bottom: 28px; }
  .section-top h2, .machine-section h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 650; line-height: 1.2; letter-spacing: -.035em; margin: 0; }
  .section-top .eyebrow { margin-bottom: 12px; font-size: .75rem; }
  .section-top p:not(.eyebrow) { font-size: .92rem; line-height: 1.7; color: var(--muted); max-width: 720px; margin: 12px 0 0; }
  .section-top > a { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: .84rem; text-decoration: none; padding-bottom: 2px; color: var(--ink); font-weight: 500; }
  .section-top > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .picks-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .pick-card { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; background: var(--paper-strong); display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .pick-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); border-color: rgba(23, 21, 15, 0.25); }
  .pick-label { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
  .pick-label > span { font-size: .75rem; padding: 4px 8px; border: 1px solid var(--line); background: var(--cream); border-radius: var(--radius-sm); color: var(--green); font-weight: 550; }
  .pick-label small { color: var(--faint); font: 500 .72rem var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
  .pick-card h3 { font-size: 1.2rem; font-weight: 650; margin: 20px 0 20px; letter-spacing: -.025em; }
  .pick-card h3 a { text-decoration: none; }
  .pick-card h3 a:hover { color: var(--accent); }
  .pick-card h4 { font: 500 .75rem var(--font-mono); letter-spacing: .05em; color: var(--faint); margin: 0 0 8px; text-transform: uppercase; }
  .pick-card p { font-size: .86rem; line-height: 1.75; margin: 0 0 20px; color: var(--muted); }
