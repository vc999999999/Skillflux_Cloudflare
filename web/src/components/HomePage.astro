---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentUpdates from './ContentUpdates.astro';
import Icon from './Icon.astro';
import { absoluteUrl, getCategories, getDirectoryStats, getIndexableSites, getTagIndex } from '../lib/content';
import { getHomePicks } from '../lib/home-picks';
import { getSourceAudits } from '../lib/source-audits';
import { bestTopics, comparePairs } from '../lib/source-compare';
import { getSiteCopy, localizePath, translateCategory, translateTag, type Language } from '../lib/i18n';
import { getGuides } from '../lib/guides';
import { scenarios } from '../lib/scenarios';
import { CHECK_REGISTRY } from '@skillflux/bench/checks';
import { aggregateFindings } from '../lib/skill-data';
import { getIndexableSkillViews, getRuns, getSkillCategories } from '../lib/skills';
import { datasetModified } from '../lib/dataset';
const { lang = 'en' } = Astro.props as { lang?: Language };
const zh = lang === 'zh';
const href = (path: string) => localizePath(path, lang);
const stats = getDirectoryStats();
const updatedSites = getIndexableSites().sort((a, b) => b.updatedAt.localeCompare(a.updatedAt) || a.resourceSlug.localeCompare(b.resourceSlug)).slice(0, 5);
const latestInsights = (await getCollection('insights', entry => !entry.data.draft))
  .sort((a, b) => b.data.dateModified.localeCompare(a.data.dateModified) || a.id.localeCompare(b.id)).slice(0, 2);
// Keep the editorial date of this page and the dates of the content shown on it.
const homeUpdatedAt = ['2026-10-10', stats.updatedAt, datasetModified(), ...latestInsights.map(entry => entry.data.dateModified), ...getGuides().map(guide => guide.dateModified), ...scenarios.slice(1).map(scenario => scenario.updatedAt)].sort().at(-1);
const categories = getCategories();
const tags = getTagIndex().slice(0, 9);
const skillViews = getIndexableSkillViews();
const benchmarkedCount = skillViews.filter(view => view.result).length;
const findings = aggregateFindings(skillViews);
const dataDate = datasetModified();
const runCount = getRuns().filter(run => run.status === 'published').length;
// Skill categories as a yellow-pages index: count plus a few example skills each.
const skillGroups = getSkillCategories().map(category => {
  const members = skillViews.filter(view => view.skill.category === category.slug).sort((a, b) => Number(Boolean(b.result)) - Number(Boolean(a.result)) || a.skill.displayName[lang].localeCompare(b.skill.displayName[lang]));
  return { category, count: members.length, examples: members.slice(0, 3) };
}).filter(group => group.count > 0).sort((a, b) => b.count - a.count);
const title = zh ? 'Agent Skill 黄页与实测数据' : 'Agent skill directory and test data';
const description = zh
  ? `按任务找 Agent Skill，按来源找它们出自哪里。收录 ${stats.resourceCount} 个 Skill 来源；${skillViews.length} 个公开 Skill 钉定到具体提交做静态体检，数据以 CC BY 4.0 公开。`
  : `Find agent skills by task, and the sources they come from. ${stats.resourceCount} skill sources listed; ${skillViews.length} public skills health-checked at pinned commits, with all data open under CC BY 4.0.`;
const picks = getHomePicks();
const audits = getSourceAudits();
const sampledEntries = audits.reduce((sum, audit) => sum + audit.summary.sampled, 0);
const topics = bestTopics();
const audited = new Set(audits.map(audit => audit.siteSlug));
// Pairs where both sides have sample data, vendor-to-vendor first, so the comparison has numbers on both columns.
const featuredPairs = comparePairs().filter(pair => audited.has(pair.a.slug) && audited.has(pair.b.slug))
  .sort((x, y) => Number(y.a.category === 'official' && y.b.category === 'official') - Number(x.a.category === 'official' && x.b.category === 'official') || x.slug.localeCompare(y.slug))
  .slice(0, 6);
const reading = [
  ...getGuides().map(guide => ({ title: guide.title[lang], summary: guide.description[lang], path: `/guides/${guide.slug}/`, type: zh ? '选型指南' : 'GUIDE' })),
  ...scenarios.slice(1).map(scenario => ({ title: scenario.title[lang], summary: scenario.summary[lang], path: `/scenarios/${scenario.slug}/`, type: zh ? '实践指南' : 'WORKFLOW' })),
];
const categoryNotes: Record<string, [string, string]> = {
  official: ['厂商维护的官方资源入口。', 'Resources maintained by tool and platform makers.'],
  marketplace: ['带有发现与安装流程的市场。', 'Catalogs with discovery and installation flows.'],
  repo: ['可阅读源码的仓库与项目。', 'Repositories and projects you can inspect.'],
  community: ['社区整理的榜单与推荐。', 'Community lists and discovery signals.'],
  directory: ['跨来源聚合的导航入口。', 'Directories spanning multiple sources.'],
};
const searchExamples = zh ? ['PDF', '测试', 'Android', '中文写作', 'MCP'] : ['PDF', 'testing', 'Android', 'design', 'MCP'];
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={href('/')} pageClass="sf-home" jsonLd={[
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SkillFlux', url: absoluteUrl(href('/')), description, potentialAction: { '@type': 'SearchAction', target: `${absoluteUrl(href('/directory/'))}?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: absoluteUrl(href('/')), description, dateModified: homeUpdatedAt }
]}>
  <main id="main-content">
    <section class="home-hero">
      <div class="home-container">
        <p class="hero-label"><span></span> {zh ? 'AGENT SKILL 黄页' : 'THE AGENT SKILL YELLOW PAGES'}</p>
        <h1>{zh ? <>找 Agent Skill，<span class="keep-together">看清它从哪来。</span></> : 'Find agent skills, and where they come from.'}</h1>
        <p class="hero-description">{zh ? '按任务浏览 Skill，按来源浏览市场、官方合集与开源仓库。每个条目都链接原始出处；每个数字都能在开放数据里复核。' : 'Browse skills by task and sources by type: marketplaces, vendor collections and open-source repos. Every entry links to the original; every number can be checked in the open data.'}</p>
        <form class="hero-search" action={href('/directory/')} method="get" role="search">
          <label><Icon name="search" size={18} /><span class="sr-only">{zh ? '搜索来源黄页' : 'Search the directory'}</span><input type="search" name="q" placeholder={zh ? '搜索 Skill、来源或标签，例如 PDF、Android…' : 'Search skills, sources or tags, e.g. PDF, Android…'} maxlength="200" autocomplete="off" /></label>
          <button class="button primary" type="submit">{zh ? '搜索' : 'Search'}</button>
        </form>
        <p class="hero-examples"><span>{zh ? '试试' : 'Try'}</span>{searchExamples.map(term => <a href={`${href('/directory/')}?q=${encodeURIComponent(term)}`}>{term}</a>)}</p>
        <dl class="home-stats data-stats">
          <div><dt>{zh ? '个来源已收录' : 'sources listed'}</dt><dd>{stats.resourceCount}</dd><small>{zh ? '市场、官方合集与仓库' : 'Marketplaces, vendors, repos'}</small></div>
          <div><dt>{zh ? '个来源已抽样体检' : 'sources sample-checked'}</dt><dd>{audits.length}</dd><small>{zh ? `共抽查 ${sampledEntries} 个条目` : `${sampledEntries} entries sampled`}</small></div>
          <div><dt>{zh ? '个 Skill 已体检' : 'skills health-checked'}</dt><dd>{skillViews.length}</dd><small>{zh ? `钉定提交 · 每个 ${CHECK_REGISTRY.length} 项检查` : `Pinned commits · ${CHECK_REGISTRY.length} checks each`}</small></div>
          <div><dt>{zh ? '对照实测' : 'benchmarks'}</dt>{benchmarkedCount > 0 ? <dd>{benchmarkedCount}</dd> : <dd class="pending">{zh ? '筹备中' : 'In progress'}</dd>}<small>{benchmarkedCount > 0 ? (zh ? `${runCount} 个已发布批次` : `${runCount} published runs`) : (zh ? '首批结果发布前不显示数字' : 'No numbers until the first run is published')}</small></div>
        </dl>
      </div>
    </section>
    <div class="home-container">
      <section class="home-section" aria-labelledby="tasks-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '按任务找 Skill' : 'SKILLS BY TASK'}</p><h2 id="tasks-title">{zh ? '你想让 Agent 做什么？' : 'What do you want your agent to do?'}</h2><p>{zh ? '每个 Skill 都有一页报告：它是什么、出自哪个提交、体检结果和许可证。' : 'Each skill has a report: what it is, which commit we checked, the health check result and its license.'}</p></div><a href={href('/skills/')}>{zh ? `全部 ${skillViews.length} 个 Skill` : `All ${skillViews.length} skills`} <Icon size={16} /></a></div>
        <div class="task-grid">{skillGroups.map(group => <article><a class="task-head" href={`${href('/skills/')}?category=${group.category.slug}`}><h3>{group.category.label[lang]}</h3><span>{group.count}</span></a><p>{group.category.description[lang]}</p><ul>{group.examples.map(view => <li><a href={href(`/skills/${view.skill.id}/`)}>{view.skill.displayName[lang]}</a><small>{view.skill.author.name}</small></li>)}</ul></article>)}</div>
      </section>
      <section class="home-section" aria-labelledby="sources-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '按来源找' : 'SOURCES BY TYPE'}</p><h2 id="sources-title">{zh ? 'Skill 都发布在哪里' : 'Where skills are published'}</h2><p>{zh ? '收录说明来源存在且可访问，不代表其中每个 Skill 都经过测试。' : 'A listing means the source exists and is reachable, not that every skill in it was tested.'}</p></div><a href={href('/directory/')}>{zh ? `全部 ${stats.resourceCount} 个来源` : `All ${stats.resourceCount} sources`} <Icon size={16} /></a></div>
        <div class="source-type-grid">{categories.map(category => <a href={href(`/source-type/${category.slug}/`)}><div><h3>{translateCategory(category.slug, category.label, lang)}</h3><span>{category.count}</span></div><p>{categoryNotes[category.slug]?.[zh ? 0 : 1]}</p><small>{category.shortLabel.toUpperCase()} <Icon size={13} /></small></a>)}</div>
        <div class="topic-row"><span>{zh ? '主题' : 'TOPICS'}</span>{tags.map(tag => <a href={href(`/tag/${tag.slug}/`)}># {translateTag(tag.tag, lang)}</a>)}</div>
      </section>
      <section class="home-section" aria-labelledby="compare-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '用数据对比' : 'COMPARE WITH DATA'}</p><h2 id="compare-title">{zh ? '哪个来源更靠谱？' : 'Which source holds up?'}</h2><p>{zh ? `SkillFlux 从 ${audits.length} 个 GitHub 来源中按固定种子抽样，用同一套静态体检逐个检查；盘点页和对比页都写明了排序方法。` : `SkillFlux draws a seeded sample from ${audits.length} GitHub sources and runs the same static check on each entry. Roundups and comparisons state how they are ordered.`}</p></div><a href={href('/best/')}>{zh ? '全部盘点' : 'All roundups'} <Icon size={16} /></a></div>
        <div class="topic-row topic-row-wide">{topics.map(topic => <a href={href(`/best/${topic.slug}/`)}>{topic.title[lang].replace(/^Agent skill sources: |^Agent Skill 来源：/, '')}</a>)}</div>
        <ul class="pair-list">{featuredPairs.map(pair => <li><a href={href(`/compare/${pair.slug}/`)}>{getSiteCopy(pair.a, lang).name} <span>vs</span> {getSiteCopy(pair.b, lang).name}</a></li>)}</ul>
        <p class="data-note"><a href={href('/compare/')}>{zh ? '查看全部对比' : 'See every comparison'}</a></p>
      </section>
      <section class="home-section" aria-labelledby="picks-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '编辑推荐' : 'EDITOR’S PICKS'}</p><h2 id="picks-title">{zh ? '从这里开始' : 'Good places to start'}</h2><p>{zh ? '用途明确、资料可追溯的来源，附推荐理由和适用场景。' : 'Sources with a clear purpose and traceable material, with the reason we picked each.'}</p></div><a href={`${href('/directory/')}?recommended=yes`}>{zh ? '更多推荐' : 'More picks'} <Icon size={16} /></a></div>
        <div class="picks-grid">{picks.map(pick => <article class="pick-card"><div class="pick-label"><span>{pick.badge[lang]}</span><small>{translateCategory(pick.site.category, pick.site.category, lang)}</small></div><h3><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{getSiteCopy(pick.site, lang).name}</a></h3><div><h4>{zh ? '为什么推荐' : 'WHY WE PICKED IT'}</h4><p>{pick.reason[lang]}</p></div><div><h4>{zh ? '适合' : 'BEST FOR'}</h4><p>{pick.best[lang]}</p></div><div class="pick-bottom"><span>{getSiteCopy(pick.site, lang).tagline}</span><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{zh ? '详情' : 'Details'} <Icon size={14} /></a></div></article>)}</div>
      </section>
      <ContentUpdates sites={updatedSites} insights={latestInsights} lang={lang} />
      <section class="home-section" aria-labelledby="findings-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? `开放数据 · 截至 ${dataDate}` : `OPEN DATA · AS OF ${dataDate}`}</p><h2 id="findings-title">{zh ? `${skillViews.length} 个 Skill 的体检发现` : `What the health check found in ${skillViews.length} skills`}</h2><p>{zh ? `每个 Skill 钉定到一个 Git 提交，按 ${CHECK_REGISTRY.length} 项规则只读检查，不调用模型。每项都是可复核的计数；标记描述 Skill 包含什么，不是结论。` : `Each skill is pinned to a Git commit and read against ${CHECK_REGISTRY.length} rules, with no model calls. Each line is a count you can verify; flags describe what a skill contains, not a verdict.`}</p></div><a href={href('/methodology/v1/')}>{zh ? '检查方法' : 'How we check'} <Icon size={16} /></a></div>
        <ul class="findings-grid">{findings.map(item => <li><strong>{item.count}<small>/{item.total}</small></strong><span>{zh ? `个 Skill ${item.zh}` : `skills ${item.en}`}</span></li>)}</ul>
        <p class="data-note">{zh ? <>原始记录：<a href="/data/health.csv">/data/health.csv</a> · 数据集清单与 sha256：<a href="/data/index.json">/data/index.json</a> · <a href={href('/benchmarks/')}>有/无 Skill 对照实测</a>{benchmarkedCount > 0 ? '' : '（首批结果发布中）'}</> : <>Raw records: <a href="/data/health.csv">/data/health.csv</a> · Manifest with sha256: <a href="/data/index.json">/data/index.json</a> · <a href={href('/benchmarks/')}>With/without benchmarks</a>{benchmarkedCount > 0 ? '' : ' are being prepared'}</>}</p>
      </section>
      <section class="home-section" aria-labelledby="guides-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '指南' : 'GUIDES'}</p><h2 id="guides-title">{zh ? '选型与实战指南' : 'Choosing and using skills'}</h2></div><a href={href('/guides/')}>{zh ? '全部指南' : 'All guides'} <Icon size={16} /></a></div>
        <div class="reading-grid">{reading.map(item => <a href={href(item.path)}><small>{item.type}</small><h3>{item.title}</h3><p>{item.summary}</p><span>{zh ? '阅读指南' : 'Read guide'} <Icon size={14} /></span></a>)}</div>
      </section>
      <section class="machine-section"><div><p class="eyebrow">{zh ? '给 AI 读' : 'FOR AI'}</p><h2>{zh ? '给 Agent 的是证据，不是宣传。' : 'Agents get evidence, not marketing.'}</h2><p>{zh ? '机器入口只给可复核的东西：钉定的提交、逐项检查结果、原始试验、sha256 清单和引用规则。' : 'The machine layer carries only what can be checked: pinned commits, per-check results, raw trials, a sha256 manifest and citation rules.'}</p><a href={href('/for-ai/')}>{zh ? '查看机器可读入口' : 'Open the machine layer'} <Icon size={16} /></a></div><div class="endpoint-list">{[['/AGENTS.md', zh ? '阅读顺序、引用规则与问题路由' : 'Reading order, citation rules, routing'], ['/llms.txt', zh ? '测量内容与每个 Skill 的结果' : 'What is measured and each result'], ['/data/index.json', zh ? '数据文件清单与 sha256' : 'Data files with sha256'], ['/index.json', zh ? '结构化的 Skill 结果与来源' : 'Structured results and sources']].map(([path, note]) => <a href={path}><span>GET</span><code>{path}</code><small>{note}</small><Icon name="external" size={14} /></a>)}</div></section>
    </div>
  </main>
</BaseLayout>
<style>
  .home-container { width: min(1088px, calc(100% - 48px)); margin: 0 auto; }
  .home-hero { padding: 80px 0 52px; border-bottom: 1px solid var(--line); }
  .hero-label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 20px; background: var(--paper-strong); font: 500 .75rem var(--font-mono); color: var(--muted); letter-spacing: .06em; box-shadow: var(--shadow-sm); }
  .hero-label > span, .tiny-dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: var(--green); flex: 0 0 auto; }
  h1 { font-size: clamp(2.3rem, 4.4vw, 3.8rem); margin: 0; line-height: 1.12; letter-spacing: -.04em; font-weight: 650; }
  h1 .hero-secondary { color: var(--faint); font-weight: 550; }
  .keep-together { white-space: nowrap; }
  :global(html[lang="zh-CN"]) h1 { line-height: 1.25; letter-spacing: -.04em; }
  .hero-description { max-width: 760px; margin: 24px 0 32px; color: var(--muted); font-size: 1.12rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .home-stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 36px 0; margin: 0; border-bottom: 1px solid var(--line); }
  .home-stats div { padding: 4px 28px; border-left: 1px solid var(--line); }
  .home-stats div:first-child { border: 0; padding-left: 0; }
  .home-stats dd { margin: 0 0 8px; font: 500 2.2rem var(--font-mono); letter-spacing: -.06em; color: var(--ink); }
  .home-stats dt { font-size: .88rem; font-weight: 600; color: var(--ink); }
  .home-section { padding: 64px 0 0; }
  .section-top { display: flex; gap: 24px; justify-content: space-between; align-items: end; margin-bottom: 28px; }
  .section-top h2, .machine-section h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 650; line-height: 1.2; letter-spacing: -.035em; margin: 0; }
  .section-top .eyebrow { margin-bottom: 12px; font-size: .75rem; }
  .section-top p:not(.eyebrow) { font-size: .92rem; line-height: 1.7; color: var(--muted); max-width: 720px; margin: 12px 0 0; }
  .section-top > a { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: .84rem; text-decoration: none; padding-bottom: 2px; color: var(--ink); font-weight: 500; }
  .section-top > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .picks-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .pick-card { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; background: var(--paper-strong); display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .pick-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); border-color: rgba(23, 21, 15, 0.25); }
  .pick-label { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
  .pick-label > span { font-size: .75rem; padding: 4px 8px; border: 1px solid var(--line); background: var(--cream); border-radius: var(--radius-sm); color: var(--green); font-weight: 550; }
  .pick-label small { color: var(--faint); font: 500 .72rem var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
  .pick-card h3 { font-size: 1.2rem; font-weight: 650; margin: 20px 0 20px; letter-spacing: -.025em; }
  .pick-card h3 a { text-decoration: none; }
  .pick-card h3 a:hover { color: var(--accent); }
  .pick-card h4 { font: 500 .75rem var(--font-mono); letter-spacing: .05em; color: var(--faint); margin: 0 0 8px; text-transform: uppercase; }
  .pick-card p { font-size: .86rem; line-height: 1.75; margin: 0 0 20px; color: var(--muted); }
  .pick-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 16px; margin-top: auto; gap: 8px; }
  .pick-bottom > span { font-size: .76rem; color: var(--faint); }
  .pick-bottom a { display: flex; align-items: center; gap: 6px; font-size: .82rem; text-decoration: none; font-weight: 550; color: var(--ink); }
  .pick-bottom a:hover { color: var(--accent); }
  .source-type-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .source-type-grid > a { border: 1px solid var(--line); border-radius: var(--radius-md); padding: 18px; text-decoration: none; display: flex; flex-direction: column; background: var(--paper-strong); box-shadow: var(--shadow-sm); transition: all .16s ease; }
  .source-type-grid > a:hover { border-color: rgba(23, 21, 15, 0.28); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .source-type-grid a > div { display: flex; justify-content: space-between; align-items: start; gap: 8px; }
  .source-type-grid h3 { font-size: .88rem; margin: 0; font-weight: 600; line-height: 1.5; color: var(--ink); }
  .source-type-grid a > div > span { font: 500 .72rem var(--font-mono); color: var(--muted); background: var(--cream); padding: 3px 6px; border-radius: 3px; }
  .source-type-grid p { font-size: .8rem; line-height: 1.7; color: var(--muted); margin: 12px 0 18px; }
  .source-type-grid small { display: flex; justify-content: space-between; align-items: center; margin-top: auto; font: 500 .72rem var(--font-mono); color: var(--faint); }
  .topic-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 24px; }
  .topic-row > span { font: 500 .75rem var(--font-mono); margin-right: 6px; color: var(--faint); letter-spacing: .04em; }
  .topic-row a { font-size: .78rem; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 5px 10px; color: var(--muted); text-decoration: none; background: var(--paper-strong); transition: all .15s ease; }
  .topic-row a:hover { color: var(--ink); border-color: var(--line-strong); background: var(--cream); }
  .reading-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .reading-grid a { display: flex; flex-direction: column; border-top: 1px solid var(--line); padding-top: 20px; text-decoration: none; transition: all .16s ease; }
  .reading-grid small { font: 500 .72rem var(--font-mono); color: var(--faint); letter-spacing: .05em; text-transform: uppercase; }
  .reading-grid h3 { margin: 12px 0 8px; font-size: .98rem; line-height: 1.6; font-weight: 600; color: var(--ink); }
  .reading-grid p { font-size: .82rem; line-height: 1.75; color: var(--muted); margin: 0 0 18px; }
