---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentUpdates from './ContentUpdates.astro';
import Icon from './Icon.astro';
import { absoluteUrl, getCategories, getDirectoryStats, getIndexableSites, getSiteBySlug, getTagIndex } from '../lib/content';
import { localizePath, translateCategory, translateTag, type Language } from '../lib/i18n';
import { getGuides } from '../lib/guides';
import { scenarios } from '../lib/scenarios';
import { CHECK_REGISTRY } from '@skillflux/bench/checks';
import { aggregateFindings, keyFinding, pct } from '../lib/skill-data';
import { getIndexableSkillViews, getRuns } from '../lib/skills';
import { datasetModified } from '../lib/dataset';
const { lang = 'en' } = Astro.props as { lang?: Language };
const zh = lang === 'zh';
const href = (path: string) => localizePath(path, lang);
const stats = getDirectoryStats();
const updatedSites = getIndexableSites().sort((a, b) => b.updatedAt.localeCompare(a.updatedAt) || a.resourceSlug.localeCompare(b.resourceSlug)).slice(0, 5);
const latestInsights = (await getCollection('insights', entry => !entry.data.draft))
  .sort((a, b) => b.data.dateModified.localeCompare(a.data.dateModified) || a.id.localeCompare(b.id)).slice(0, 2);
// Keep the editorial date of this page and the dates of the content shown on it.
const homeUpdatedAt = ['2026-10-10', stats.updatedAt, datasetModified(), ...latestInsights.map(entry => entry.data.dateModified), ...getGuides().map(guide => guide.dateModified), ...scenarios.slice(1).map(scenario => scenario.updatedAt)].sort().at(-1);
const categories = getCategories();
const tags = getTagIndex().slice(0, 9);
const skillViews = getIndexableSkillViews();
const benchmarkedCount = skillViews.filter(view => view.result).length;
const findings = aggregateFindings(skillViews);
const dataDate = datasetModified();
const featuredReports = [...skillViews].sort((a, b) => Number(Boolean(b.result)) - Number(Boolean(a.result)) || b.dateModified.localeCompare(a.dateModified) || a.skill.id.localeCompare(b.skill.id)).slice(0, 6);
const runCount = getRuns().filter(run => run.status === 'published').length;
const title = zh ? 'Agent Skill 实测数据与来源目录' : 'Agent skill test data and source directory';
const description = zh
  ? `哪些 Agent Skill 真的有用？SkillFlux 把 ${skillViews.length} 个公开 Skill 钉定到具体提交做静态体检，并在 Claude Code 中与不装 Skill 的基线对照实测，以 CC BY 4.0 公开全部数据。`
  : `Which agent skills actually help? SkillFlux pins ${skillViews.length} public skills to exact commits, runs a static health check, benchmarks them in Claude Code against a no-skill baseline, and publishes all the data under CC BY 4.0.`;
// The H1 already asks the question, so the visible lede starts after it.
const heroText = description.replace(/^[^?？]*[?？]\s*/, '');
// Until the first run is published, a large "0" reads as a result; show a dash and say why.
const benchmarkStat = benchmarkedCount > 0
  ? { value: String(benchmarkedCount), note: zh ? `${runCount} 个已发布批次` : `${runCount} published runs`, empty: false }
  : { value: '—', note: zh ? '首个实测批次尚未发布' : 'First run not yet published', empty: true };
const heroStats = [
  { value: String(skillViews.length), label: zh ? '个 Skill 已体检' : 'skills health-checked', note: zh ? `每个 ${CHECK_REGISTRY.length} 项检查` : `${CHECK_REGISTRY.length} checks each`, empty: false },
  { ...benchmarkStat, label: zh ? '个 Skill 已实测' : 'skills benchmarked' },
  { value: String(stats.resourceCount), label: zh ? '个来源已收录' : 'sources in the directory', note: zh ? '市场、官方合集与仓库' : 'Marketplaces, vendors, repos', empty: false },
];
const picks = [
  { slug: 'github-com-anthropics-skills', name: 'Anthropic Skills', badge: zh ? '参考实现' : 'Reference', reason: zh ? '从 Anthropic 的开源仓库入手，直接阅读 Skill 的结构与实现。' : 'Read the skill structure and implementations directly in Anthropic’s open-source repository.', best: zh ? '了解 Skill 格式，建立自己的技能库' : 'Learning the format and building a skill library' },
  { slug: 'modelscope-cn-skills', name: 'ModelScope Skills', badge: zh ? '编辑推荐' : 'Recommended', reason: zh ? '中文 Skill 的集中发现入口，适合先浏览场景，再回到原始资料比较。' : 'A starting point for discovering Chinese-language skills and comparing their original sources.', best: zh ? '中文资源发现与场景选型' : 'Finding Chinese-language skill resources' },
  { slug: 'github-com-op7418-humanizer-zh', name: 'Humanizer-zh', badge: zh ? '用途明确' : 'Focused', reason: zh ? '围绕中文写作提供可阅读的规则，方便检查是否符合自己的编辑习惯。' : 'Readable rules for Chinese writing, so you can judge whether the editorial approach fits your work.', best: zh ? '中文文稿编辑与语言润色' : 'Editing and refining Chinese writing' },
].flatMap(pick => { const site = getSiteBySlug(pick.slug); return site ? [{ ...pick, site }] : []; });
const reading = [
  ...getGuides().map(guide => ({ title: guide.title[lang], summary: guide.description[lang], path: `/guides/${guide.slug}/`, type: zh ? '选型指南' : 'GUIDE' })),
  ...scenarios.slice(1).map(scenario => ({ title: scenario.title[lang], summary: scenario.summary[lang], path: `/scenarios/${scenario.slug}/`, type: zh ? '实践指南' : 'WORKFLOW' })),
];
const categoryNotes: Record<string, [string, string]> = {
  official: ['厂商维护的官方资源入口。', 'Resources maintained by tool and platform makers.'],
  marketplace: ['带有发现与安装流程的市场。', 'Catalogs with discovery and installation flows.'],
  repo: ['可阅读源码的仓库与项目。', 'Repositories and projects you can inspect.'],
  community: ['社区整理的榜单与推荐。', 'Community lists and discovery signals.'],
  directory: ['跨来源聚合的导航入口。', 'Directories spanning multiple sources.'],
};
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={href('/')} pageClass="sf-home" jsonLd={[
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SkillFlux', url: absoluteUrl(href('/')), description },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: absoluteUrl(href('/')), description, dateModified: homeUpdatedAt }
]}>
  <main id="main-content">
    <section class="home-hero">
      <div class="home-container">
        <p class="hero-label"><span></span> {zh ? 'AGENT SKILL 开放数据' : 'OPEN DATA ON AGENT SKILLS'}</p>
        <h1>{zh ? <>哪些 Agent Skill <span class="keep-together">真的有用？</span></> : 'Which agent skills actually help?'}<br /><span class="hero-secondary">{zh ? '我们逐个测试，并公开数据。' : 'We test them and publish the data.'}</span></h1>
        <p class="hero-description">{heroText}</p>
        <div class="hero-actions">
          <a class="button primary" href={href('/skills/')}>{zh ? '查看 Skill 报告' : 'Browse skill reports'} <Icon size={16} /></a>
          <a class="button secondary" href={href('/data/')}>{zh ? '下载数据集' : 'Download the dataset'}</a>
        </div>
        <dl class="home-stats">
          {heroStats.map(stat => <div class:list={[stat.empty && 'is-empty']}><dt>{stat.label}</dt><dd class="stat-value">{stat.value}</dd><dd class="stat-note">{stat.note}</dd></div>)}
        </dl>
      </div>
    </section>
    <div class="home-container">
      <section class="home-section" aria-labelledby="findings-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? `体检发现 · 截至 ${dataDate}` : `FINDINGS · AS OF ${dataDate}`}</p><h2 id="findings-title">{zh ? `${skillViews.length} 个公开 Skill 的静态体检` : `What the health check found in ${skillViews.length} public skills`}</h2><p>{zh ? '每项都是可复核的计数，原始记录见 /data/health.csv。标记描述 Skill 包含什么，不是结论。' : 'Each line is a count you can verify in /data/health.csv. Flags describe what a skill contains; they are not verdicts.'}</p></div><a href={href('/methodology/v1/')}>{zh ? '检查方法' : 'How we check'} <Icon size={16} /></a></div>
        <ul class="findings-grid">{findings.map(item => <li><strong>{item.count}<small>/{item.total}</small></strong><span>{zh ? `个 Skill ${item.zh}` : `skills ${item.en}`}</span></li>)}</ul>
      </section>
      <section class="home-section" aria-labelledby="method-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '方法' : 'METHOD'}</p><h2 id="method-title">{zh ? '两层测试，分开报告' : 'Two kinds of evidence, reported separately'}</h2></div><a href={href('/methodology/v1/')}>{zh ? '方法论 v1' : 'Methodology v1'} <Icon size={16} /></a></div>
        <div class="value-steps">
          <article><div><span>L1</span></div><h2>{zh ? '静态体检' : 'Static health check'}</h2><p>{zh ? `把 Skill 钉定到一个 Git 提交，检查 frontmatter、体积、断链、附带脚本、网络调用、破坏性命令、疑似密钥、许可证和维护状态，共 ${CHECK_REGISTRY.length} 项。不调用模型。` : `Each skill is pinned to a Git commit and checked for frontmatter, size, broken links, bundled scripts, network calls, destructive commands, secrets, license and maintenance — ${CHECK_REGISTRY.length} checks, no model calls.`}</p></article>
          <article><div><span>L2</span><small>{zh ? '核心' : 'core'}</small></div><h2>{zh ? '有/无 Skill 对照实测' : 'With vs without benchmark'}</h2><p>{zh ? '同样的任务在 Claude Code 中各跑多次：一组装 Skill，一组不装。确定性脚本评分，报告通过率、95% 置信区间、调用率与成本。' : 'The same tasks run several times in Claude Code, once with the skill installed and once without. Scripts grade the output; reports give pass rates with 95% intervals, invocation rate and cost.'}</p></article>
          <article><div><span>CC BY</span></div><h2>{zh ? '开放可引用' : 'Open and citable'}</h2><p>{zh ? '每个数字都能下载、校验 sha256，并从原始试验重新计算。每份报告都给出引用格式和不可变的批次 id。' : 'Every number can be downloaded, checked against a sha256 and recomputed from raw trials. Each report gives a citation and an immutable run id.'}</p></article>
        </div>
      </section>
      <section class="home-section" aria-labelledby="reports-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? 'Skill 报告' : 'SKILL REPORTS'}</p><h2 id="reports-title">{zh ? '最新报告' : 'Latest reports'}</h2></div><a href={href('/skills/')}>{zh ? `全部 ${skillViews.length} 个` : `All ${skillViews.length}`} <Icon size={16} /></a></div>
        <div class="reading-grid">{featuredReports.map(view => <a href={href(`/skills/${view.skill.id}/`)}><small>{view.result ? (zh ? `实测 · ${pct(view.result.skill.pooled.with.passRate)} vs ${pct(view.result.skill.pooled.without.passRate)}` : `BENCHMARK · ${pct(view.result.skill.pooled.with.passRate)} vs ${pct(view.result.skill.pooled.without.passRate)}`) : (zh ? `体检 · ${view.counts.pass} 通过 · ${view.counts.warn} 警告 · ${view.counts.fail} 失败` : `HEALTH · ${view.counts.pass} pass · ${view.counts.warn} warn · ${view.counts.fail} fail`)}</small><h3>{view.skill.displayName[lang]}</h3><p>{keyFinding(view, lang)}</p><span>{zh ? '查看报告' : 'Read report'} <Icon size={14} /></span></a>)}</div>
      </section>
      <ContentUpdates sites={updatedSites} insights={latestInsights} lang={lang} />
      <section class="home-section" aria-labelledby="picks-title">
        <div class="section-top"><div><p class="eyebrow">{zh ? '来源目录 · 编辑推荐' : 'DIRECTORY · EDITOR’S PICKS'}</p><h2 id="picks-title">{zh ? '从哪里找 Skill' : 'Where to find skills'}</h2><p>{zh ? '从用途明确、资料可追溯的能力来源开始。查看推荐理由和适用场景，再决定是否采用。' : 'High-signal starting points with transparent rationale and practical use cases.'}</p></div><a href={href('/directory/')}>{zh ? '浏览黄页' : 'Browse yellow pages'} <Icon size={16} /></a></div>
        <div class="picks-grid">{picks.map(pick => <article class="pick-card"><div class="pick-label"><span>{pick.badge}</span><small>{translateCategory(pick.site.category, pick.site.category, lang)}</small></div><h3><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{pick.name}</a></h3><div><h4>{zh ? '为什么推荐' : 'WHY WE RECOMMEND IT'}</h4><p>{pick.reason}</p></div><div><h4>{zh ? '适合' : 'BEST FOR'}</h4><p>{pick.best}</p></div><div class="pick-bottom"><span>{zh ? '来源推荐' : 'Source recommendation'}</span><a href={href(`/resource/${pick.site.resourceSlug}/`)}>{zh ? '详情' : 'Details'} <Icon size={14} /></a></div></article>)}</div>
      </section>
    </div>
    <div class="home-container">
      <section class="home-section sources-section" aria-labelledby="sources-title">
        <div class="section-top"><div><p class="eyebrow">NAVIGATE THE ECOSYSTEM</p><h2 id="sources-title">{zh ? '来源类别与主题' : 'Source categories & topics'}</h2><p>{zh ? '了解能力从哪里来，再决定从哪里开始。' : 'Understand where capabilities come from, then decide where to start.'}</p></div><a href={href('/directory/')}>{zh ? '全部黄页来源' : 'All sources'} <Icon size={16} /></a></div>
        <div class="source-type-grid">{categories.map(category => <a href={href(`/source-type/${category.slug}/`)}><div><h3>{translateCategory(category.slug, category.label, lang)}</h3><span>{category.count}</span></div><p>{categoryNotes[category.slug]?.[zh ? 0 : 1]}</p><small>{category.shortLabel.toUpperCase()} <Icon size={13} /></small></a>)}</div>
        <div class="topic-row"><span>{zh ? '主题' : 'TOPICS'}</span>{tags.map(tag => <a href={href(`/tag/${tag.slug}/`)}># {translateTag(tag.tag, lang)}</a>)}</div>
      </section>
      <section class="home-section" aria-labelledby="guides-title">
        <div class="section-top"><div><p class="eyebrow">GUIDES</p><h2 id="guides-title">{zh ? 'Agent 能力选型与实战指南' : 'Learn the agent ecosystem'}</h2></div><a href={href('/guides/')}>{zh ? '全部指南' : 'All guides'} <Icon size={16} /></a></div>
        <div class="reading-grid">{reading.map(item => <a href={href(item.path)}><small>{item.type}</small><h3>{item.title}</h3><p>{item.summary}</p><span>{zh ? '阅读指南' : 'Read guide'} <Icon size={14} /></span></a>)}</div>
      </section>
      <section class="machine-section"><div><p class="eyebrow">FOR AI</p><h2>{zh ? '为人，也为 Agent。' : 'Built for humans and agents.'}</h2><p>{zh ? '体检与实测数据、来源目录都有机器可读入口，并附明确的引用规则。' : 'Health checks, benchmarks and the directory are all machine-readable, with explicit citation rules.'}</p><a href={href('/for-ai/')}>{zh ? '探索机器可读入口' : 'Open the machine layer'} <Icon size={16} /></a></div><div class="endpoint-list">{[['/llms.txt', zh ? '测量内容、各 Skill 结果与引用规则' : 'What is measured, each result, citation rules'], ['/data/index.json', zh ? '数据集清单与 sha256' : 'Dataset manifest with sha256'], ['/index.json', zh ? '结构化的 Skill 结果与来源' : 'Structured results and sources'], ['/feed.xml', zh ? '资源与文章更新订阅' : 'Resource and article updates via RSS']].map(([path, note]) => <a href={path}><span>GET</span><code>{path}</code><small>{note}</small><Icon size={14} /></a>)}</div></section>
    </div>
  </main>
</BaseLayout>
<style>
  .home-container { width: min(var(--container), calc(100% - var(--gutter) * 2)); margin: 0 auto; }
  .home-hero { padding: 80px 0 52px; border-bottom: 1px solid var(--line); }
  .hero-label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 20px; background: var(--paper-strong); font: 500 .75rem var(--font-mono); color: var(--muted); letter-spacing: .06em; box-shadow: var(--shadow-sm); }
  .hero-label > span { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: var(--green); flex: 0 0 auto; }
  h1 { font-size: clamp(2.3rem, 4.4vw, 3.8rem); margin: 0; line-height: 1.12; letter-spacing: -.04em; font-weight: 700; }
  h1 .hero-secondary { color: var(--faint); font-weight: 600; }
  .keep-together { white-space: nowrap; }
  :global(html[lang="zh-CN"]) h1 { line-height: 1.25; letter-spacing: -.04em; }
  .hero-description { max-width: 760px; margin: 24px 0 32px; color: var(--muted); font-size: 1.12rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .value-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); margin-top: 48px; box-shadow: var(--shadow-card); }
  .value-steps article { padding: 24px; }
  .value-steps article + article { border-left: 1px solid var(--line); }
  .value-steps article > div { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font: 500 .75rem var(--font-mono); letter-spacing: .04em; }
  .value-steps small { padding: 3px 8px; border-radius: var(--radius-sm); background: var(--green-subtle); color: var(--green); font-size: .75rem; font-weight: 600; }
  .value-steps h2 { font-size: 1.08rem; margin: 12px 0 6px; font-weight: 600; letter-spacing: -.02em; }
  .value-steps p { font-size: .85rem; line-height: 1.65; color: var(--muted); margin: 0; }
  .home-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 40px 0 0; padding: 36px 0; border-bottom: 1px solid var(--line); }
  .home-stats div { display: flex; flex-direction: column; padding: 4px 28px; border-left: 1px solid var(--line); }
  .home-stats div:first-child { border: 0; padding-left: 0; }
  .home-stats dt { font-size: .88rem; font-weight: 600; color: var(--ink); }
  .home-stats dd { margin: 0; }
  .home-stats .stat-value { order: -1; margin-bottom: 8px; font: 500 2.2rem var(--font-mono); letter-spacing: -.06em; color: var(--ink); }
  .home-stats .stat-note { font-size: .8rem; margin-top: 6px; color: var(--muted); line-height: 1.5; }
  .home-stats .is-empty .stat-value { color: var(--faint); }
  .home-section { padding: 64px 0 0; }
  .section-top { display: flex; gap: 24px; justify-content: space-between; align-items: end; margin-bottom: 28px; }
  .section-top h2, .machine-section h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 600; line-height: 1.2; letter-spacing: -.035em; margin: 0; }
  .section-top .eyebrow { margin-bottom: 12px; font-size: .75rem; }
  .section-top p:not(.eyebrow) { font-size: .92rem; line-height: 1.7; color: var(--muted); max-width: 720px; margin: 12px 0 0; }
  .section-top > a { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: .84rem; text-decoration: none; padding-bottom: 2px; color: var(--ink); font-weight: 500; }
  .section-top > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .picks-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .pick-card { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; background: var(--paper-strong); display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .pick-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); border-color: var(--line-hover); }
  .pick-label { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
  .pick-label > span { font-size: .75rem; padding: 4px 8px; border: 1px solid var(--line); background: var(--cream); border-radius: var(--radius-sm); color: var(--green); font-weight: 500; }
  .pick-label small { color: var(--faint); font: 500 .72rem var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
  .pick-card h3 { font-size: 1.2rem; font-weight: 600; margin: 20px 0 20px; letter-spacing: -.025em; }
  .pick-card h3 a { text-decoration: none; }
  .pick-card h3 a:hover { color: var(--accent); }
  .pick-card h4 { font: 500 .75rem var(--font-mono); letter-spacing: .05em; color: var(--faint); margin: 0 0 8px; text-transform: uppercase; }
  .pick-card p { font-size: .86rem; line-height: 1.75; margin: 0 0 20px; color: var(--muted); }
  .pick-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 16px; margin-top: auto; gap: 8px; }
  .pick-bottom > span { font-size: .76rem; color: var(--faint); }
  .pick-bottom a { display: flex; align-items: center; gap: 6px; font-size: .82rem; text-decoration: none; font-weight: 500; color: var(--ink); }
  .pick-bottom a:hover { color: var(--accent); }
  .source-type-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .source-type-grid > a { border: 1px solid var(--line); border-radius: var(--radius-md); padding: 18px; text-decoration: none; display: flex; flex-direction: column; background: var(--paper-strong); box-shadow: var(--shadow-sm); transition: all .16s ease; }
  .source-type-grid > a:hover { border-color: var(--line-hover); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .source-type-grid a > div { display: flex; justify-content: space-between; align-items: start; gap: 8px; }
  .source-type-grid h3 { font-size: .88rem; margin: 0; font-weight: 600; line-height: 1.5; color: var(--ink); }
  .source-type-grid a > div > span { font: 500 .72rem var(--font-mono); color: var(--muted); background: var(--cream); padding: 3px 6px; border-radius: 3px; }
  .source-type-grid p { font-size: .8rem; line-height: 1.7; color: var(--muted); margin: 12px 0 18px; }
  .source-type-grid small { display: flex; justify-content: space-between; align-items: center; margin-top: auto; font: 500 .72rem var(--font-mono); color: var(--faint); }
  .topic-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 24px; }
  .topic-row > span { font: 500 .75rem var(--font-mono); margin-right: 6px; color: var(--faint); letter-spacing: .04em; }
  .topic-row a { font-size: .78rem; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 5px 10px; color: var(--muted); text-decoration: none; background: var(--paper-strong); transition: all .15s ease; }
  .topic-row a:hover { color: var(--ink); border-color: var(--line-strong); background: var(--cream); }
  .reading-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
