---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import { absoluteUrl, getCategories } from '../lib/content';
import { getScenario } from '../lib/scenarios';
import { localizePath, translateCategory, type Language } from '../lib/i18n';
const { slug, lang = 'en' } = Astro.props as { slug: string; lang?: Language };
const scenario = getScenario(slug)!;
const zh = lang === 'zh';
const categories = getCategories();
const canonicalPath = localizePath(`/scenarios/${slug}/`, lang);
---
<BaseLayout lang={lang} title={scenario.title[lang]} description={scenario.summary[lang]} canonicalPath={canonicalPath} jsonLd={{ '@context': 'https://schema.org', '@type': 'TechArticle', headline: scenario.title[lang], description: scenario.summary[lang], dateModified: scenario.updatedAt, inLanguage: zh ? 'zh-CN' : 'en', url: absoluteUrl(canonicalPath) }}>
  <main id="main-content" class="page-shell">
    <article><PageHeader title={scenario.title[lang]} eyebrow={zh ? '选型场景' : 'SCENARIO'} lede={scenario.summary[lang]} breadcrumb={[{ label: zh ? '首页' : 'Home', href: localizePath('/', lang) }, { label: zh ? '场景与选型' : 'Scenarios & selection', href: localizePath('/scenarios/', lang) }, { label: scenario.title[lang] }]}><p class="page-meta">{zh ? '维护于' : 'Maintained'} <time datetime={scenario.updatedAt}>{scenario.updatedAt}</time> · {zh ? '产品使用与选型说明，不是外部 Skill 实测报告' : 'Product guidance, not an external skill evaluation'}</p></PageHeader>
      {scenario.sections.map(section => <section><h2>{section.title[lang]}</h2><p>{section.body[lang]}</p>{section.command && <div class="callout scenario-command"><code>{section.command}</code><button class="button secondary" type="button" data-copy-text={section.command}>{zh ? '复制' : 'Copy'}</button></div>}</section>)}
    </article>
    <aside><h2>{zh ? '继续查找' : 'Continue exploring'}</h2><ul><li><a href={localizePath('/directory/', lang)}>{zh ? '完整来源黄页' : 'Full source directory'}</a></li>{categories.map(category => <li><a href={localizePath(`/source-type/${category.slug}/`, lang)}>{translateCategory(category.slug, category.label, lang)} ({category.count})</a></li>)}<li><a href={localizePath('/insights/', lang)}>{zh ? 'Skill 拆解' : 'Skill deep-dives'}</a></li></ul></aside>
  </main>
</BaseLayout>
<style>
  article { max-width: 850px; }
  article section + section { margin-top: 36px; }
  article h2 { margin: 0 0 12px; font-size: 1.4rem; font-weight: 600; letter-spacing: -.02em; }
  article section p { max-width: 65ch; margin: 0; font-size: 1.03rem; line-height: 1.9; }
  .scenario-command { display: flex; gap: 16px; justify-content: space-between; align-items: center; margin-bottom: 0; background: var(--cream); }
  .scenario-command code { overflow-wrap: anywhere; font-size: .86rem; }
  .scenario-command .button { flex-shrink: 0; min-height: 34px; padding: 6px 14px; }
  aside { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  aside h2 { margin: 0 0 8px; font-size: 1.15rem; font-weight: 600; }
  aside ul { columns: 2; padding-left: 20px; }
  aside li { line-height: 1.7; padding-block: 6px; break-inside: avoid; }
  @media (max-width: 600px) { aside ul { columns: 1; } .scenario-command { flex-direction: column; align-items: stretch; } }
</style>
