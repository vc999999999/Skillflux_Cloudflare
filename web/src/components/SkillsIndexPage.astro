---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import { CHECK_REGISTRY } from "@skillflux/bench/checks";
import { absoluteUrl } from "../lib/content";
import { localizePath, type Language } from "../lib/i18n";
import HealthBadges from "./HealthBadges.astro";
import { flagShort, flagLabel, pct, signedPoints } from "../lib/skill-data";
import { getIndexableSkillViews, getSkillCategories } from "../lib/skills";
import { datasetModified } from "../lib/dataset";

type Props = { lang: Language };
const { lang } = Astro.props;
const zh = lang === "zh";
const t = (en: string, cn: string) => zh ? cn : en;
const views = getIndexableSkillViews().sort((a, b) => Number(Boolean(b.result)) - Number(Boolean(a.result)) || a.skill.displayName[lang].localeCompare(b.skill.displayName[lang]));
const categories = getSkillCategories().map(category => ({ ...category, count: views.filter(view => view.skill.category === category.slug).length })).filter(category => category.count > 0);
const benchmarked = views.filter(view => view.result).length;
const flagged = views.filter(view => (view.health?.flags.length ?? 0) > 0).length;
const path = localizePath("/skills/", lang);
const title = t("Agent skill health checks and benchmarks", "Agent Skill 体检与实测数据");
// The benchmark column and count only mean something once a run is published.
const showBenchmark = benchmarked > 0;
const description = showBenchmark ? t(
  `${views.length} agent skills from public repositories, each pinned to a commit and checked against ${CHECK_REGISTRY.length} static rules; ${benchmarked} benchmarked with Claude Code against a no-skill baseline.`,
  `${views.length} 个来自公开仓库的 Agent Skill，均钉定到具体提交并按 ${CHECK_REGISTRY.length} 条静态规则体检；其中 ${benchmarked} 个在 Claude Code 中与不装 Skill 的基线做过对照实测。`
) : t(
  `${views.length} agent skills from public repositories, each pinned to a commit and checked against ${CHECK_REGISTRY.length} static rules. No benchmark run against a no-skill baseline has been published yet.`,
  `${views.length} 个来自公开仓库的 Agent Skill，均钉定到具体提交并按 ${CHECK_REGISTRY.length} 条静态规则体检。与不装 Skill 基线的对照实测尚未发布。`
);
const modified = datasetModified();
const jsonLd = [
  { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: absoluteUrl(path), inLanguage: zh ? "zh-CN" : "en", dateModified: modified,
    mainEntity: { "@type": "ItemList", numberOfItems: views.length, itemListElement: views.map((view, index) => ({ "@type": "ListItem", position: index + 1, url: absoluteUrl(localizePath(`/skills/${view.skill.id}/`, lang)), name: view.skill.displayName[lang] })) } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: t("Home", "首页"), item: absoluteUrl(localizePath("/", lang)) },
    { "@type": "ListItem", position: 2, name: t("Skills", "Skill 数据"), item: absoluteUrl(path) },
  ] },
];
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={path} jsonLd={jsonLd}>
  <main id="main-content" class="page-shell">
    <PageHeader title={title} breadcrumb={[{ label: t("Home", "首页"), href: localizePath("/", lang) }, { label: t("Skills", "Skill 数据") }]}>
      <Fragment slot="eyebrow">{t("OPEN DATA · UPDATED ", "公开数据 · 更新于 ")}<time datetime={modified}>{modified}</time></Fragment>
      <p class="page-lede">{description} {t("Every skill page links to its pinned source and to the raw data.", "每个 Skill 页面都链接到钉定的源码和原始数据。")}</p>
      <p class="page-meta"><a href={localizePath("/methodology/v1/", lang)}>{t("How we test", "测试方法")}</a> · <a href={localizePath("/data/", lang)}>{t("Download the dataset", "下载数据集")}</a></p>
      <div slot="aside" class="page-meta-panel stats-panel">
        <dl>
          <div><dt>{t("skills checked", "个 Skill 已体检")}</dt><dd>{views.length}</dd></div>
          {showBenchmark && <div><dt>{t("benchmarked", "个已实测")}</dt><dd>{benchmarked}</dd></div>}
          <div><dt>{t("with at least one flag", "个至少有一项标记")}</dt><dd>{flagged}</dd></div>
        </dl>
        {!showBenchmark && <p class="stats-status"><span aria-hidden="true"></span>{t("Benchmarks: none published yet", "实测：尚未发布")}</p>}
      </div>
    </PageHeader>
    <nav class="category-filter" aria-label={t("Filter by category", "按分类筛选")}>
      <a href={path} data-category-link="all" aria-current="true">{t("All", "全部")} <small>{views.length}</small></a>
      {categories.map(category => <a href={`${path}?category=${category.slug}`} data-category-link={category.slug}>{category.label[lang]} <small>{category.count}</small></a>)}
    </nav>
    <p class="health-legend"><span>{t("Health check:", "体检：")}</span><span class="tone-pass">{t("pass", "通过")}</span><span class="tone-warn">{t("warning", "警告")}</span><span class="tone-fail">{t("fail", "失败")}</span><span class="legend-note">{t("Flags describe what a skill contains; they are not verdicts.", "标记描述 Skill 包含什么，并非结论。")}</span></p>
    <div class="table-scroll">
      <table class="data-table skills-table">
        <thead><tr>
          <th scope="col">{t("Skill", "Skill")}</th>
          <th scope="col">{t("Health check", "体检")}</th>
          {showBenchmark && <th scope="col">{t("Benchmark (with vs without)", "实测（装 vs 不装）")}</th>}
          <th scope="col">{t("License", "许可证")}</th>
        </tr></thead>
        <tbody>
          {views.map(view => (
            <tr data-skill-row data-category={view.skill.category}>
              <th scope="row"><a href={localizePath(`/skills/${view.skill.id}/`, lang)}>{view.skill.displayName[lang]}</a><small>{view.skill.author.name} · {view.category.label[lang]}</small></th>
              <td data-label={t("Health check", "体检")}><HealthBadges counts={view.counts} lang={lang} />{(view.health?.flags.length ?? 0) > 0 && (() => { const full = view.health!.flags.map(flag => flagLabel(flag, lang)).join(zh ? "；" : "; "); const short = view.health!.flags.map(flag => flagShort(flag, lang)).join(zh ? "、" : ", "); return <small class="flag-line" title={full}>{short}</small>; })()}</td>
              {showBenchmark && <td data-label={t("Benchmark", "实测")}>{view.result ? <span>{pct(view.result.skill.pooled.with.passRate)} vs {pct(view.result.skill.pooled.without.passRate)} <small>{signedPoints(view.result.skill.pooled.comparison.passRateDelta)} · n={view.result.skill.pooled.with.n}</small></span> : <span class="muted">{t("Not yet", "暂未")}</span>}</td>}
              <td data-label={t("License", "许可证")}>{view.skill.license.spdx ?? (view.skill.license.file ? t("License file in repo", "仓库内附许可证") : <span class="muted">{t("Not found", "未找到")}</span>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {!showBenchmark && <p class="section-note">{t("Benchmark results will be added to this table when the first run is published.", "首个实测批次发布后，结果会加入此表。")} <a href={localizePath("/benchmarks/", lang)}>{t("About the benchmarks", "了解实测")}</a></p>}
  </main>
</BaseLayout>
<script>
  const apply = () => {
    const category = new URL(location.href).searchParams.get('category') ?? 'all';
    document.querySelectorAll<HTMLElement>('[data-skill-row]').forEach(row => { row.hidden = category !== 'all' && row.dataset.category !== category; });
    document.querySelectorAll<HTMLAnchorElement>('[data-category-link]').forEach(link => link.setAttribute('aria-current', String(link.dataset.categoryLink === category)));
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-category-link]').forEach(link => link.addEventListener('click', event => {
    event.preventDefault();
    history.pushState(null, '', link.href);
    apply();
  }));
  window.addEventListener('popstate', apply);
  apply();
</script>
<style>
  .stats-panel { display: block; }
  .stats-panel dl { display: grid; gap: 14px; margin: 0; }
  .stats-panel dl div { display: flex; flex-direction: column; }
  .stats-panel dt { color: var(--muted); font-size: .82rem; }
  .stats-panel dd { order: -1; margin: 0 0 4px; font: 500 2.1rem var(--font-mono); letter-spacing: -.04em; }
  /* With no published run there is no number to show, so the state reads as a status line, not a statistic. */
  .stats-status { display: flex; align-items: center; gap: 8px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; }
  .stats-status span { margin: 0; width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--warn-subtle); box-shadow: inset 0 0 0 2px var(--warn); }
  @media (max-width: 900px) { .stats-panel dl { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); } }
  .health-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 16px 0 0; color: var(--muted); font-size: .8rem; }
  .health-legend > span[class^="tone-"] { padding: 1px 8px; border-radius: 8px; font-size: .76rem; }
  .legend-note { color: var(--faint); }
  .flag-line { max-width: 34ch; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .category-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
  .category-filter a { padding: 6px 12px; border: 1px solid var(--line); border-radius: 16px; text-decoration: none; font-size: .84rem; background: var(--paper-strong); }
  .category-filter a[aria-current="true"] { background: var(--ink); color: var(--paper-strong); border-color: var(--ink); }
  .category-filter small { color: var(--muted); opacity: 1; margin-left: 6px; font-weight: 500; }
  .category-filter a[aria-current="true"] small { color: var(--paper-strong); opacity: .85; }
  .data-table tbody th a { font-weight: 600; }
  .muted { color: var(--faint); }
  /* Phones: each row becomes a card, with column names from data-label. */
  @media (max-width: 640px) {
    .skills-table thead { display: none; }
    .skills-table, .skills-table tbody, .skills-table tr, .skills-table th, .skills-table td { display: block; }
    .skills-table tr { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .skills-table tr[hidden] { display: none; }
    .skills-table th, .skills-table td { padding: 0; border: 0; }
    .skills-table td { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; margin-top: 10px; padding-left: 92px; }
    .skills-table td::before { content: attr(data-label); flex: 0 0 86px; margin-left: -92px; color: var(--faint); font-size: .76rem; }
    .skills-table td small { flex-basis: 100%; margin-top: 2px; }
    .flag-line { max-width: none; white-space: normal; }
  }
</style>
