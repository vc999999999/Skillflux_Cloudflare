---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { useCases, collections, getEditorialSites } from '../lib/editorial';
import { absoluteUrl } from '../lib/content';
import { localizePath, type Language } from '../lib/i18n';
type Props = { kind: 'use-cases' | 'collections'; lang?: Language };
const { kind, lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
const isCases = kind === 'use-cases';
const entries = isCases ? useCases : collections;
const singular = isCases ? 'use-case' : 'collection';
const title = isCases ? (zh ? '从你的任务开始' : 'Start with your task') : (zh ? '少一些查找，多一点方向。' : 'Less searching. More direction.');
const summary = isCases ? (zh ? '你想让 Agent 完成什么？从具体场景出发，找到相关来源和清晰的选择建议。' : 'What do you want your agent to do? Find relevant sources and practical selection advice for a specific job.') : (zh ? '把分散的资源整理成有目的的短名单。每个合集，都有一个清晰的出发点。' : 'Focused shortlists that bring scattered resources together. Every collection starts with a clear purpose.');
const path = localizePath(`/${kind}/`, lang);
---
<BaseLayout lang={lang} title={isCases ? (zh ? '使用场景' : 'Use cases') : (zh ? '精选合集' : 'Curated collections')} description={summary} canonicalPath={path} jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description: summary, url: absoluteUrl(path), mainEntity: { '@type': 'ItemList', numberOfItems: entries.length, itemListElement: entries.map((entry, index) => ({ '@type': 'ListItem', position: index + 1, name: entry.title[lang], url: absoluteUrl(localizePath(`/${singular}/${entry.slug}/`, lang)) })) } }}>
  <main id="main-content" class="page-shell editorial-index">
    <header><p class="eyebrow">{isCases ? 'CHOOSE BY TASK' : 'CURATED COLLECTIONS'}</p><h1>{title}</h1><p class="intro">{summary}</p><div class="index-meta"><span>{entries.length} {isCases ? (zh ? '个使用场景' : 'use cases') : (zh ? '个编辑合集' : 'editorial collections')}</span><span>{zh ? '基于真实来源整理' : 'Built around real sources'}</span></div></header>
    <div class:list={['editorial-grid', !isCases && 'collection-grid']}>
      {entries.map((entry, index) => <a class="editorial-card" href={localizePath(`/${singular}/${entry.slug}/`, lang)}>
        <div class="card-top"><span class="entry-icon"><Icon name={entry.icon} size={24} /></span><span class="card-index">{String(index + 1).padStart(2, '0')}</span></div>
        {!isCases && 'kicker' in entry && <p class="collection-kicker">{entry.kicker[lang]}</p>}
        <h2>{entry.title[lang]}</h2><p class="entry-summary">{entry.summary[lang]}</p>
        {!isCases && <div class="collection-sources">{getEditorialSites(entry).slice(0, 3).map(site => <span>{site.name}</span>)}</div>}
        <div class="card-bottom"><span>{getEditorialSites(entry).length} {zh ? '个相关来源' : 'related sources'}</span><span>{zh ? '开始探索' : 'Explore'} <Icon name="arrow" size={15} /></span></div>
      </a>)}
    </div>
    <aside class="editorial-note"><div><h2>{zh ? '已经知道要找什么？' : 'Know what you are looking for?'}</h2><p>{zh ? '打开完整目录，按关键词、类型和来源筛选。需要安装版本时，查看精品 Registry。' : 'Search the full directory by keyword, type and source. For installable releases, explore the curated Registry.'}</p></div><a href={localizePath('/directory/', lang)}>{zh ? '探索资源目录' : 'Explore the directory'} <Icon name="arrow" size={16} /></a></aside>
  </main>
</BaseLayout>
<style>
  .editorial-index { padding-top: 60px; padding-bottom: 70px; }
  header { max-width: 800px; margin-bottom: 45px; }
  .eyebrow { margin: 0 0 15px; font-size: .67rem; letter-spacing: .12em; color: var(--muted); }
  h1 { font-size: clamp(2rem, 4vw, 3.1rem); letter-spacing: -.045em; line-height: 1.25; margin: 0 0 18px; }
  .intro { color: var(--muted); font-size: .91rem; line-height: 1.8; margin: 0; }
  .index-meta { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 25px; color: var(--muted); font-size: .7rem; }
  .index-meta span + span { padding-left: 20px; border-left: 1px solid var(--line); }
  .editorial-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .editorial-card { display: flex; flex-direction: column; min-width: 0; text-decoration: none; border: 1px solid var(--line); border-radius: 8px; padding: 26px; background: var(--paper, #fff); transition: transform .18s, border-color .18s; }
  .editorial-card:hover { transform: translateY(-3px); border-color: #777; }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .entry-icon { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 9px; }
  .card-index { font-size: .7rem; color: #999; font-family: monospace; }
  .editorial-card h2 { font-size: 1.03rem; line-height: 1.4; margin: 0 0 12px; letter-spacing: -.025em; }
  .entry-summary { color: var(--muted); font-size: .8rem; line-height: 1.8; margin: 0 0 25px; }
  .card-bottom { display: flex; justify-content: space-between; gap: 15px; padding-top: 18px; border-top: 1px solid var(--line); margin-top: auto; font-size: .7rem; color: var(--muted); }
  .card-bottom > span:last-child { display: flex; align-items: center; gap: 10px; color: var(--ink); }
  .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .collection-grid .editorial-card { padding: 32px; }.collection-grid .card-top { margin-bottom: 28px; }.collection-grid .editorial-card h2 { font-size: 1.4rem; }
  .collection-kicker { margin: 0 0 10px; color: var(--muted); font-size: .66rem; letter-spacing: .08em; }.collection-sources { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 27px; }.collection-sources span { border: 1px solid var(--line); border-radius: 4px; background: var(--cream, #f6f6f6); color: var(--muted); font-size: .62rem; padding: 4px 7px; overflow-wrap: anywhere; }
  .editorial-note { margin-top: 50px; padding: 29px 32px; background: var(--cream, #f6f6f6); border: 1px solid var(--line); border-radius: 8px; display: flex; justify-content: space-between; align-items: center; gap: 30px; }.editorial-note h2 { margin: 0 0 10px; font-size: 1rem; }.editorial-note p { margin: 0; font-size: .78rem; line-height: 1.8; color: var(--muted); max-width: 670px; }.editorial-note a { display: flex; align-items: center; flex-shrink: 0; gap: 14px; font-size: .77rem; text-decoration: none; font-weight: 600; }
  @media (max-width: 960px) { .editorial-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .editorial-index { padding-top: 35px; }header { margin-bottom: 30px; }.editorial-grid { grid-template-columns: 1fr; }.editorial-card, .collection-grid .editorial-card { padding: 24px; }.card-top { margin-bottom: 18px; }.editorial-note { display: block; padding: 23px; }.editorial-note a { margin-top: 20px; }.intro { font-size: .83rem; } }
</style>
