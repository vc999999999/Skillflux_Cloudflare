---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEVELOPMENT_REGISTRY_URL } from "../lib/registry-client";
const registryUrl = String(import.meta.env.PUBLIC_REGISTRY_URL ?? "").trim() || (import.meta.env.DEV ? DEVELOPMENT_REGISTRY_URL : "");
const modules = [
  { key: "skills", title: "Skill 审核队列", statuses: ["pending", "approved", "rejected", "revoked"] },
  { key: "campaigns", title: "广告活动", statuses: ["active", "paused"] },
  { key: "inquiries", title: "商务咨询", statuses: ["new", "following-up", "completed", "invalid"] },
  { key: "reports", title: "广告举报", statuses: ["new", "dismissed", "paused"] },
  { key: "audit", title: "审计日志", statuses: [] }
];
---
<BaseLayout lang="zh" canonicalPath="/console/" title="运营控制台" description="SkillFlux 内部审核、广告、咨询与审计工具。" pageClass="console-page" noindex={true}>
  <main id="main-content" class="console-shell" data-console-root data-registry-url={registryUrl}>
    <section class="console-heading">
      <div><p class="eyebrow"><span></span>OPERATOR SURFACE</p><h1>Registry<br /><em>控制台。</em></h1></div>
      <aside><strong>内部运营入口</strong><p>普通用户无需账号。管理员 Token 只驻留当前页面内存；断开、离开或刷新即清除。原始测试记录及咨询信息仅供授权运营人员查看。</p></aside>
    </section>
    <section class="console-connect">
      <form data-connect-form>
        <label><span>Registry API</span><input name="registry" value={registryUrl} placeholder="https://registry.example.com" required /></label>
        <label><span>Operator Bearer Token</span><input name="token" type="password" autocomplete="off" required /></label>
        <button type="submit">连接后端</button>
      </form>
      <p data-connect-message role="status" aria-live="polite">{registryUrl ? "等待管理员凭据。" : "未配置生产 API，请输入实际 Registry 地址。"}</p>
    </section>
    <div class="console-app" data-console-app hidden>
      <div class="console-session-bar"><span data-session-label></span><div><button type="button" data-refresh-all>刷新全部</button><button type="button" data-disconnect>断开并清除</button></div></div>
      <nav class="console-tabs" aria-label="运营模块">
        <a href="#metrics">统计</a>{modules.map(module => <a href={"#" + module.key}>{module.title}</a>)}<a href="#submission">录入</a>
      </nav>
      <section id="metrics" class="console-workspace">
        <header class="console-section-head"><div><span>01</span><h2>统计与导出</h2></div><p>花费与预留是广告账本金额，不代表回款。日期按 UTC。</p></header>
        <form class="console-filters" data-metrics-filter>
          <label>开始日期<input type="date" name="from" /></label><label>结束日期<input type="date" name="to" /></label>
          <label>活动 ID<input name="campaignId" /></label><label>分组<select name="groupBy"><option value="day">日期</option><option value="campaign">广告活动</option></select></label>
          <button type="submit">查询</button><button type="button" data-export-csv>导出当前 CSV</button>
        </form>
        <p class="console-metric-note">CTR 按付费展示发生的 UTC 日期归组：该批后来被首次点击的唯一展示 ÷ 该批付费唯一展示。House 不计入；花费仍按点击日期记录。无付费展示时显示「—」。</p>
        <div class="metric-grid" data-metrics-grid aria-live="polite"></div><div class="console-table-wrap" data-metrics-rows></div>
      </section>
      {modules.map((module, index) => (
        <section id={module.key} class="console-workspace" data-module={module.key}>
          <header class="console-section-head"><div><span>{String(index + 2).padStart(2, "0")}</span><h2>{module.title}</h2></div><button type="button" data-module-refresh>刷新此模块</button></header>
          <form class="console-filters" data-list-filter>
            <label>搜索<input name="q" placeholder={module.key === "audit" ? "操作、对象或内容" : "名称、ID 或内容"} /></label>
            {module.statuses.length > 0 && <label>状态<select name="status"><option value="">全部</option>{module.statuses.map(status => <option value={status}>{status}</option>)}</select></label>}
            {module.key === "audit" && <><label>操作<input name="action" placeholder="精确操作名称（可选）" /></label><label>开始<input type="date" name="from" /></label><label>结束<input type="date" name="to" /></label></>}
            <button type="submit">搜索 / 筛选</button>
          </form>
          <div class="console-list" data-list aria-live="polite"></div>
          <div class="console-pagination"><button type="button" data-prev>上一页</button><span data-page-info></span><button type="button" data-next>下一页</button></div>
          {module.key === "skills" && <section class="console-detail" data-skill-detail hidden aria-label="Skill 审核详情"></section>}
          {module.key === "campaigns" && <details class="submission-panel" data-campaign-editor>
            <summary>新建 / 编辑广告活动</summary>
            <form class="campaign-form" data-campaign-form>
              <header><strong data-campaign-form-title>新建活动</strong><button type="button" data-campaign-cancel>重置 / 取消编辑</button></header>
              <div class="campaign-fields">
                <label><span>名称</span><input name="name" maxlength="120" required /></label><label><span>赞助方</span><input name="sponsor" maxlength="120" required /></label>
                <label class="is-wide"><span>广告文案（单行，最多 280 字符）</span><input name="text" maxlength="280" required /></label>
                <label class="is-wide"><span>HTTPS 目标网址</span><input name="url" type="url" required /></label>
                <label class="is-wide"><span>分类（逗号分隔）</span><input name="categories" /></label>
                <label><span>预算（分）</span><input name="budgetCents" type="number" min="0" step="1" required /></label>
                <label><span>CPC（分）</span><input name="cpcCents" type="number" min="0" max="100000000" step="1" required /></label>
                <label><span>UTC 每日分配上限</span><input name="dailyCap" type="number" min="0" max="10000000" step="1" required /></label>
                <label><span>状态</span><select name="active"><option value="false">暂停</option><option value="true">启用</option></select></label>
                <label><span>开始（浏览器本地时间）</span><input name="startsAt" type="datetime-local" required /></label>
                <label><span>结束（浏览器本地时间）</span><input name="endsAt" type="datetime-local" required /></label>
              </div>
              <p>分配会预留 CPC；实际有效点击才记花费。日上限按 UTC 重置，暂停会使旧广告凭证失效。</p>
              <button type="submit">保存活动</button><p data-form-message role="status"></p>
            </form>
          </details>}
        </section>
      ))}
      <section id="submission" class="console-workspace">
        <header class="console-section-head"><div><span>07</span><h2>提交待审版本</h2></div><p>自动检查后进入待审；新版本需独立实测、审核，不覆盖旧版本。</p></header>
        <p>当前 Registry 只接受无网络、Shell 或密钥权限的文本包。全部资源都需录入 files；自动检查不能替代人工实测。</p>
        <form class="campaign-form" data-submission-form>
          <div class="campaign-fields">
            <label>Skill ID<input name="id" pattern="[a-z0-9][a-z0-9-]*" required /></label><label>版本<input name="version" placeholder="1.0.0" required /></label>
            <label>名称<input name="name" required /></label><label>分类<input name="category" required /></label>
            <label class="is-wide">描述<textarea name="description" rows="2" required></textarea></label>
            <label>发布者<input name="publisher" required /></label><label>许可证<input name="license" required /></label>
            <label>标签（逗号分隔）<input name="tags" /></label><label>声明宿主（逗号分隔）<input name="hosts" placeholder="codex,claude,cursor,generic" required /></label>
            <label>入口路径<input name="entry" value="SKILL.md" required /></label><label>最低客户端版本<input name="minClientVersion" placeholder="1.0.0" required /></label>
            <label>维护者<input name="maintainedBy" required /></label><label>维护时间<input name="maintainedAt" type="datetime-local" required /></label>
            <label class="is-wide">更新说明<textarea name="notes" rows="2" required></textarea></label>
            <label class="console-check"><input name="breaking" type="checkbox" />包含破坏性变更</label>
            <label class="is-wide">权限 JSON<textarea name="permissions" rows="3" required set:html={JSON.stringify({network:[],shell:false,secrets:[]})}></textarea></label>
            <label class="is-wide">依赖 JSON<textarea name="dependencies" rows="2" required set:html={"[]"}></textarea></label>
            <label class="is-wide">全部文本文件 JSON（路径 → 文本；不得遗漏资源）<textarea name="files" rows="8" spellcheck="false" placeholder='{"SKILL.md":"..."}' required></textarea></label>
          </div>
          <details><summary>从完整 JSON 文本导入</summary><label>Submission JSON<textarea name="import" rows="10" spellcheck="false"></textarea></label><button type="button" data-import-submission>读取 JSON 到表单</button></details>
          <button type="submit">提交到审核队列</button><p data-form-message role="status"></p>
        </form>
      </section>
    </div>
    <p class="console-toast" data-console-toast role="status" aria-live="polite" hidden></p>
  </main>
</BaseLayout>
<script>
  import { fetchJson, fetchCsv, normalizeRegistryUrl, isPageResponse, isObject, RegistryError, safeExternalUrl, validateCampaign } from "../lib/registry-client";
  import type { AdminSkillDetail, AuditItem, Campaign, CampaignInput, CampaignPreview, EvaluationInput, Host, Inquiry, AdReport, Metrics, PageResponse, SkillSummary, Submission } from "../lib/registry-types";
  const root = document.querySelector<HTMLElement>("[data-console-root]");
  if (root) {
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text = "", className = "") => {
      const node = document.createElement(tag); node.textContent = text; if (className) node.className = className; return node;
    };
    const button = (text: string, run: (button: HTMLButtonElement) => void | Promise<void>) => {
      const node = el("button", text); node.type = "button"; node.addEventListener("click", () => void run(node)); return node;
    };
    const app = root.querySelector<HTMLElement>("[data-console-app]")!;
    const connect = root.querySelector<HTMLFormElement>("[data-connect-form]")!;
    const connectMessage = root.querySelector<HTMLElement>("[data-connect-message]")!;
    const detail = root.querySelector<HTMLElement>("[data-skill-detail]")!;
    const toast = root.querySelector<HTMLElement>("[data-console-toast]")!;
    const metricsForm = root.querySelector<HTMLFormElement>("[data-metrics-filter]")!;
    const campaignForm = root.querySelector<HTMLFormElement>("[data-campaign-form]")!;
    let apiBase = "", token = "", session = 0, toastTimer = 0;
    let sessionController = new AbortController();
    let editingCampaign: Campaign | null = null;
    let detailSequence = 0, metricsSequence = 0;
    const listState = new Map<string, { offset: number; total: number; request: number }>();
    const errorText = (error: unknown) => error instanceof Error ? error.message : String(error);
    const notify = (text: string, failed = false) => {
      clearTimeout(toastTimer); toast.textContent = text; toast.classList.toggle("is-error", failed); toast.hidden = false;
      toastTimer = window.setTimeout(() => { toast.hidden = true; }, 9000);
    };
    function disconnect() {
      session++; sessionController.abort(); sessionController = new AbortController(); token = ""; editingCampaign = null;
      (connect.elements.namedItem("token") as HTMLInputElement).value = "";
      app.hidden = true; detail.replaceChildren(); detail.hidden = true;
      root!.querySelectorAll<HTMLElement>("[data-list], [data-metrics-grid], [data-metrics-rows]").forEach(node => node.replaceChildren());
      connectMessage.textContent = "连接已断开，管理员 Token 已清除。";
    }
    async function request<T>(path: string, init?: RequestInit, validate?: (value: unknown) => boolean): Promise<T> {
      if (!token) throw new Error("请连接管理员凭据。");
      const current = session;
      try {
        return await fetchJson<T>(apiBase, path, { ...init, signal: sessionController.signal, headers: { ...init?.headers, Authorization: "Bearer " + token } }, { validate });
      } catch (error) {
        if (error instanceof RegistryError && error.status === 401 && current === session) disconnect();
        throw error;
      }
    }
    const date = (value: string) => new Date(value).toLocaleString("zh-CN");
    const money = (value: number) => "¥" + (value / 100).toFixed(2);
    const pathForSkill = (skill: SkillSummary) => "/v1/admin/skills/" + encodeURIComponent(skill.id) + "/" + encodeURIComponent(skill.version);
    const jsonSection = (label: string, value: unknown, opened = false) => {
      const section = el("details"); section.open = opened; section.append(el("summary", label), el("pre", JSON.stringify(value, null, 2))); return section;
    };
    function inputField(form: HTMLElement, label: string, name: string, type = "text", required = true, value = "") {
      const wrapper = el("label", label);
      const input = type === "textarea" ? el("textarea") : el("input");
      input.name = name; input.required = required; input.value = value;
      if (input instanceof HTMLInputElement) input.type = type; else input.rows = 3;
      wrapper.append(input); form.append(wrapper); return input;
    }
    const value = (form: HTMLFormElement, key: string) => String(new FormData(form).get(key) ?? "").trim();
    function updateForm(form: HTMLFormElement, key: string, next: string) {
      const field = form.elements.namedItem(key); if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) field.value = next;
    }
    async function mutate(form: HTMLFormElement, operation: () => Promise<void>) {
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.querySelector<HTMLElement>("[data-form-message]")!;
      submit.disabled = true; status.textContent = "正在保存…"; status.classList.remove("is-error");
      try { await operation(); status.textContent = "后端已保存。"; }
      catch (error) { status.textContent = errorText(error); status.classList.add("is-error"); }
      finally { submit.disabled = false; }
    }
    function formFooter(form: HTMLFormElement, text: string) {
      const submit = el("button", text); submit.type = "submit"; const status = el("p"); status.dataset.formMessage = ""; status.setAttribute("role", "status"); form.append(submit, status);
    }
    function renderSkills(items: SkillSummary[], target: HTMLElement) {
      items.forEach(skill => {
        const row = el("article", "", "console-record"); const header = el("header");
        header.append(el("strong", skill.name), el("code", skill.id + "@" + skill.version), el("span", skill.status));
        row.append(header, el("p", skill.description), el("p", "自动检查：" + (skill.quality.automated.passed ? "通过" : "未通过") + " · 人工实测：" + (skill.quality.evaluation ? "已记录" : "无合格记录")));
        row.append(button("查看全部文件、实测与审核", () => openSkill(skill))); target.append(row);
      });
    }
    async function openSkill(skill: SkillSummary) {
      const current = session, sequence = ++detailSequence; detail.hidden = false; detail.replaceChildren(el("p", "正在读取原始待审包与历史…")); detail.scrollIntoView({ block: "start" });
      try {
        const data = await request<AdminSkillDetail>(pathForSkill(skill), undefined, result => isObject(result) && isObject(result.skill) && isObject(result.manifest) && isObject(result.files) && typeof result.contentHash === "string" && Array.isArray(result.evaluations) && Array.isArray(result.reviews) && isObject(result.diff));
        if (current !== session || sequence !== detailSequence) return; renderSkillDetail(data);
      } catch (error) { if (current === session && sequence === detailSequence) detail.replaceChildren(el("p", errorText(error), "is-error"), button("重试详情", () => openSkill(skill))); }
    }
    function renderSkillDetail(data: AdminSkillDetail) {
      const skill = data.skill; detail.replaceChildren();
      const heading = el("header"); heading.append(el("h3", skill.name + " · " + skill.version), button("关闭详情", () => { detail.hidden = true; })); detail.append(heading);
      detail.append(el("code", "内容指纹 " + data.contentHash), el("p", "只把实际执行过的测试记为人工实测。模拟结果不能批准发布；下面的私有测试过程不会自动公开。"));
      detail.append(button("导出完整文本包 JSON，供本地复测", () => {
        const blob = new Blob([JSON.stringify({ manifest: data.manifest, files: data.files }, null, 2)], { type: "application/json" });
        const objectUrl = URL.createObjectURL(blob), anchor = el("a");
        anchor.href = objectUrl; anchor.download = skill.id + "-" + skill.version + "-review-bundle.json"; anchor.click(); setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
        notify("已导出原始文本包。请在隔离项目中安装并复测；导出不代表批准发布。");
      }));
      detail.append(jsonSection("权限、依赖与自动检查", { permissions: data.manifest.permissions, dependencies: data.manifest.dependencies, securityChecks: data.manifest.quality.automated }, true));
      detail.append(jsonSection("发布元数据", data.manifest.release ?? "旧版本未声明更新元数据"), jsonSection("与上一版本的文件差异", data.diff, true));
      const files = el("section"); files.append(el("h4", "包内全部文本文件 · " + Object.keys(data.files).length));
      Object.entries(data.files).forEach(([path, content]) => { const file = el("details"); file.append(el("summary", path), el("pre", content)); files.append(file); }); detail.append(files);
      detail.append(jsonSection("完整 manifest", data.manifest), jsonSection("人工 / 模拟实测历史（原始记录）", data.evaluations), jsonSection("审批、拒绝与撤销历史", data.reviews));
      const needsEvaluation = skill.status === "pending" || (skill.status === "approved" && skill.qualification === "needs-testing");
      if (needsEvaluation) {
        if (skill.status === "approved") detail.append(el("p", "这是缺少合格实测的历史版本。可对原始字节补测；保存测试不会自动恢复公开资格，需再单独批准。包内容与摘要保持不变。"));
        const form = el("form", "", "console-evaluation"); form.append(el("h4", "记录实际测试"));
        inputField(form, "测试者", "tester"); inputField(form, "真实测试时间", "testedAt", "datetime-local");
        inputField(form, "环境：宿主版本 / 模型名称与版本 / 系统", "environment", "textarea");
        const kindLabel = el("label", "记录类型"); const kind = el("select"); kind.name = "kind"; [["human","人工实际执行"],["simulation","模拟（不能用于发布）"]].forEach(([key,text]) => { const option = el("option", text); option.value = key!; kind.append(option); }); kindLabel.append(kind); form.append(kindLabel);
        ["purpose", "boundary"].forEach(testCase => {
          const fieldset = el("fieldset"); fieldset.append(el("legend", testCase === "purpose" ? "主要用途测试" : "边界 / 失败场景测试"));
          [["input","场景与输入"],["expected","预期结果"],["actual","实际结果"],["steps","执行步骤"],["limitations","限制与已知问题（没有则如实写明）"],["evidence","证据：日志摘录或内部证据链接"]].forEach(([key,label]) => inputField(fieldset, label!, testCase + "." + key, "textarea"));
          const passedLabel = el("label", "结果"); const passed = el("select"); passed.name = testCase + ".passed";
          [["","请选择实际结果"],["true","通过"],["false","未通过"]].forEach(([key,text]) => { const option = el("option",text); option.value = key!; passed.append(option); }); passed.required = true; passedLabel.append(passed); fieldset.append(passedLabel); form.append(fieldset);
        });
        data.manifest.hosts.forEach(host => {
          const hostSection = el("fieldset"); hostSection.append(el("legend", host + " · 实际安装和读取"));
          ["installed", "read"].forEach(check => { const label = el("label", check === "installed" ? "已实际安装成功" : "宿主已实际读取"); label.className = "console-check"; const checkbox = el("input"); checkbox.type = "checkbox"; checkbox.name = host + "." + check; label.prepend(checkbox); hostSection.append(label); });
          inputField(hostSection, "宿主版本、操作步骤及证据", host + ".notes", "textarea"); form.append(hostSection);
        });
        inputField(form, "公开摘要（独立填写，先移除个人信息、密钥和敏感输入）", "publicSummary", "textarea");
        const attestation = inputField(form, "我确认类型与证据如实填写：人工记录来自真实执行，模拟结果未冒充人审", "attest", "checkbox"); attestation.parentElement?.classList.add("console-check");
        formFooter(form, "保存实测记录");
        form.addEventListener("submit", event => { event.preventDefault(); void mutate(form, async () => {
          const record = (prefix: string) => ({ input: value(form,prefix + ".input"), expected: value(form,prefix + ".expected"), actual: value(form,prefix + ".actual"), steps: value(form,prefix + ".steps"), limitations: value(form,prefix + ".limitations"), evidence: value(form,prefix + ".evidence"), passed: value(form,prefix + ".passed") === "true" });
          const payload: EvaluationInput = { contentHash: data.contentHash, tester: value(form,"tester"), testedAt: new Date(value(form,"testedAt")).toISOString(), environment: value(form,"environment"), kind: value(form,"kind") as "human" | "simulation", purpose: record("purpose"), boundary: record("boundary"), hostChecks: data.manifest.hosts.map(host => ({host, installed: value(form,host + ".installed") === "on", read: value(form,host + ".read") === "on", notes: value(form,host + ".notes")})), publicSummary: value(form,"publicSummary") };
          await request(pathForSkill(skill) + "/evaluations", { method: "POST", body: JSON.stringify(payload) }); notify("实测记录已保存。"); await openSkill(skill);
        }); }); detail.append(form);
      }
      if (skill.status === "pending" || skill.status === "approved") {
        const review = el("form", "", "console-review"); review.append(el("h4", "审核决定"));
        inputField(review, "审核人", "reviewer"); inputField(review, "理由（批准、拒绝、撤销均必填）", "notes", "textarea");
        const select = el("select"); select.name = "action"; select.required = true; select.setAttribute("aria-label","审核动作");
        const chooseAction = el("option", "请选择审核动作"); chooseAction.value = ""; select.append(chooseAction);
        const qualified = skill.quality.automated.passed && data.evaluations.some(item => item.kind === "human" && item.contentHash === data.contentHash && item.purpose.passed && item.boundary.passed && data.manifest.hosts.every(host => item.hostChecks.some(check => check.host === host && check.installed && check.read)));
        (skill.status === "approved" ? needsEvaluation ? [["approve","单独批准，恢复公开资格"],["revoke","撤销发布"]] : [["revoke","撤销发布"]] : [["reject","拒绝"],["approve","批准发布"]]).forEach(([key,label]) => { const option = el("option",label); option.value = key!; option.disabled = key === "approve" && !qualified; select.append(option); });
        review.append(select); if (!qualified && needsEvaluation) review.append(el("p", "批准不可用：需要当前内容指纹下，主要用途、边界及全部声明宿主通过的人工实测记录。"));
        formFooter(review, "提交审核决定");
