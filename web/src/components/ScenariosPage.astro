---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from "./PageHeader.astro";
import { scenarios } from '../lib/scenarios';
import { getGuides } from '../lib/guides';
import { insightPath, localizePath, type Language } from '../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Language };
const zh = lang === 'zh';
const insights = await getCollection('insights', entry => !entry.data.draft);
const title = zh ? '场景与选型' : 'Scenarios & selection';
---
<BaseLayout lang={lang} title={title} description={zh ? '从具体任务开始，了解 Skill 来源、接入、版本维护和使用边界。' : 'Start with a task and understand skill sources, setup, release maintenance and limitations.'} canonicalPath={localizePath('/scenarios/', lang)}>
  <main id="main-content" class="page-shell">
    <PageHeader title={title} eyebrow={zh ? '实践笔记' : 'FIELD NOTES'} lede={zh ? '把问题说清楚，再找合适的 Skill。这里整理选择依据和操作路径，不把文章数量当作质量。' : 'Clarify the task, then find a suitable skill. These guides explain decisions and practical steps.'} breadcrumb={[{ label: zh ? '首页' : 'Home', href: localizePath('/', lang) }, { label: title }]} />
    <section class="scenario-list">{scenarios.map((scenario, index) => <article><span class="resource-number">{String(index + 1).padStart(2, '0')}</span><div><h2><a href={localizePath(`/scenarios/${scenario.slug}/`, lang)}>{scenario.title[lang]}</a></h2><p>{scenario.summary[lang]}</p><small>{zh ? '更新' : 'Updated'} {scenario.updatedAt}</small></div></article>)}</section>
    <section class="scenario-archive"><h2>{zh ? '来源研究与已有指南' : 'Source research and existing guides'}</h2><p>{zh ? '旧链接继续保留。外部来源解读不是平台对其内容完成了人工实测。' : 'Existing URLs remain available. Editorial analysis of an external source is not a platform usage-test certification.'}</p><ul>{getGuides().map(guide => <li><a href={localizePath(`/guides/${guide.slug}/`, lang)}>{guide.title[lang]}</a></li>)}{insights.map(entry => <li><a href={insightPath(entry)}>{entry.data.title}</a>{!zh && <span> · Chinese original</span>}</li>)}</ul></section>
  </main>
</BaseLayout>
<style>
  .scenario-list { display: grid; }
  .scenario-list article { display: grid; grid-template-columns: 56px 1fr; gap: 24px; padding: 28px 0; }
  .scenario-list article:first-child { padding-top: 0; }
  .scenario-list article + article { border-top: 1px solid var(--line); }
  .resource-number { padding-top: 6px; color: var(--faint); font: 500 .8rem var(--font-mono); }
  .scenario-list h2 { margin: 0 0 10px; font-size: clamp(1.25rem, 2.2vw, 1.55rem); font-weight: 600; line-height: 1.35; letter-spacing: -.02em; }
  .scenario-list h2 a { text-decoration: none; }
  .scenario-list h2 a:hover { color: var(--accent); }
  .scenario-list p { max-width: 65ch; margin: 0 0 10px; color: var(--muted); line-height: 1.8; }
  .scenario-list small { color: var(--faint); font: .75rem var(--font-mono); }
  .scenario-archive { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--line); line-height: 1.8; }
  .scenario-archive h2 { margin: 0 0 8px; font-size: 1.15rem; font-weight: 600; }
  .scenario-archive p { margin: 0; color: var(--muted); font-size: .9rem; }
  .scenario-archive li { margin: 10px 0; }
  @media (max-width: 600px) { .scenario-list article { grid-template-columns: 32px 1fr; gap: 12px; } }
</style>
