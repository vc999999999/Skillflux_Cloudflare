---
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, getDirectoryStats, getSites } from '../lib/content';
import { DEFAULT_LANGUAGE, getSiteCopy, localizePath, type Language } from '../lib/i18n';
import ResourceTable from './ResourceTable.astro';
type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const zh = lang === 'zh';
const sites = getSites();
const stats = getDirectoryStats();
const canonicalPath = localizePath('/directory/', lang);
const title = zh ? '功能黄页 · 想给 Agent 增加的能力' : 'Capabilities to Add to Your Agent';
const description = zh ? '面向 AI Agent 的开放功能黄页：想给你的 Agent 增加什么能力？浏览与检索全网 Skills、MCP 工具、插件与开源生态。按场景和可信度筛选，即插即用。' : 'The yellow pages for everything you want your AI agent to do: discover skills, MCP tools, plugins, and open-source capabilities. Filter by task and trust, then wire into your project.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: absoluteUrl(canonicalPath), description, inLanguage: zh ? 'zh-CN' : 'en', isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url }, mainEntity: { '@type': 'ItemList', numberOfItems: sites.length, itemListElement: sites.map((site, index) => ({ '@type': 'ListItem', position: index + 1, name: getSiteCopy(site, lang).name, url: absoluteUrl(localizePath(`/resource/${site.resourceSlug}/`, lang)) })) } };
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <main id="main-content" class="page-shell directory-page">
    <header class="directory-heading"><div><p class="eyebrow">{zh ? 'AI AGENT 功能黄页' : 'THE AGENT CAPABILITY YELLOW PAGES'}</p><h1>{title}<span>{stats.resourceCount}</span></h1><p>{description}</p></div><a href={localizePath('/registry/', lang)}>{zh ? '查看可安装的精品能力' : 'Explore installable curated capabilities'} <span aria-hidden="true">↗</span></a></header>
    <ResourceTable sites={sites} showControls heading={title} lang={lang} />
    <aside class="source-note"><strong>{zh ? '从黄页到落地' : 'From discovery to execution'}</strong><p>{zh ? '本黄页收录全网开放来源。进入详情可追溯原始网站；通过 SkillFlux 安装的审核版本与测试记录，请前往精品库。' : 'This yellow pages directory lists open ecosystem sources. Follow each detail page to original sources; find releases and review records ready for installation in the curated Registry.'}</p><a href={localizePath('/registry/', lang)}>{zh ? '精品能力库 →' : 'Curated Registry →'}</a></aside>
  </main>
</BaseLayout>
<style>
  .directory-page { padding-top: 48px; padding-bottom: 72px; }
  .directory-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; }
  .directory-heading .eyebrow { font-size: .75rem; letter-spacing: .08em; margin: 0 0 16px; color: var(--muted); }
  .directory-heading h1 { display: flex; align-items: center; gap: 14px; margin: 0 0 14px; font-size: clamp(2rem, 3.2vw, 2.75rem); letter-spacing: -.04em; line-height: 1.2; font-weight: 650; }
  .directory-heading h1 span { font-size: .8rem; color: var(--muted); letter-spacing: 0; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 4px 9px; font-weight: 550; background: var(--paper-strong); }
  .directory-heading p:last-child { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.75; max-width: 680px; }
  .directory-heading > a { flex-shrink: 0; font-size: .84rem; font-weight: 550; text-decoration: none; margin-bottom: 4px; color: var(--ink); }
  .directory-heading > a:hover { color: var(--accent); }
  .directory-heading > a span { margin-left: 6px; }
  .source-note { display: flex; align-items: center; gap: 28px; padding: 24px 28px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--cream); margin-top: 48px; }
  .source-note strong { font-size: .9rem; white-space: nowrap; color: var(--ink); }
  .source-note p { margin: 0; font-size: .86rem; line-height: 1.75; color: var(--muted); flex: 1; }
  .source-note a { white-space: nowrap; font-size: .84rem; font-weight: 600; text-decoration: none; color: var(--ink); }
  .source-note a:hover { color: var(--accent); }
  @media (max-width: 760px) {
    .directory-page { padding-top: 32px; }
    .directory-heading { display: block; }
    .directory-heading > a { display: inline-block; margin-top: 16px; }
    .directory-heading p:last-child { font-size: .88rem; }
    .source-note { display: block; padding: 20px; }
    .source-note p { margin: 8px 0 12px; }
  }
</style>

<script>
  import { directoryFacets, readDirectoryFilters, writeDirectoryFilters, matchesDirectoryRow } from '../lib/directory-search';
  import { updateClientRobots } from '../lib/indexing';
  document.querySelectorAll<HTMLElement>('[data-directory="true"]').forEach(root => {
    const input = root.querySelector<HTMLInputElement>('[data-directory-search]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-site-row]')];
    const list = root.querySelector<HTMLElement>('[data-resource-list]')!;
    const count = root.querySelector<HTMLElement>('[data-result-count]')!;
    const activeFilters = root.querySelector<HTMLElement>('[data-active-filters]')!;
    const empty = root.querySelector<HTMLElement>('[data-directory-empty]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-directory-sort]')!;
    const sidebar = root.querySelector<HTMLDetailsElement>('[data-directory-sidebar]')!;
    const mobile = window.matchMedia('(max-width: 760px)');
    const setSidebar = () => { sidebar.open = !mobile.matches; };
    setSidebar();
    mobile.addEventListener('change', setSidebar);
    let state = readDirectoryFilters(new URLSearchParams(location.search));
    function render() {
      updateClientRobots();
      input.value = state.q;
      sort.value = state.sort;
      for (const facet of directoryFacets) root.querySelectorAll<HTMLButtonElement>(`[data-${facet}-filter]`).forEach(button => button.setAttribute('aria-pressed', String(button.getAttribute(`data-${facet}-filter`) === state[facet])));
      const active = directoryFacets.filter(facet => state[facet] !== 'all').length;
      activeFilters.textContent = active ? String(active) : '';
      const ordered = [...rows].sort((a, b) => state.sort === 'name' ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', document.documentElement.lang) : state.sort === 'newest' ? (b.dataset.updated ?? '').localeCompare(a.dataset.updated ?? '') || Number(a.dataset.position) - Number(b.dataset.position) : Number(a.dataset.position) - Number(b.dataset.position));
      let visible = 0;
      for (const row of ordered) {
        row.hidden = !matchesDirectoryRow({ search: row.dataset.search ?? '', category: row.dataset.category ?? '', region: row.dataset.region ?? '', trust: row.dataset.trust ?? '', kind: row.dataset.kind, usecase: row.dataset.usecase, recommended: row.dataset.recommended }, state);
        if (!row.hidden) visible++;
        list.append(row);
      }
      count.textContent = `${visible} ${root.dataset.countSuffix ?? ''}`;
      empty.hidden = visible > 0;
    }
    function commit(replace = false) {
      const url = writeDirectoryFilters(new URL(location.href), state);
      if (url.href !== location.href) history[replace ? 'replaceState' : 'pushState'](null, '', url);
      render();
      document.dispatchEvent(new Event('skillflux:filters'));
    }
    for (const facet of directoryFacets) root.querySelectorAll<HTMLButtonElement>(`[data-${facet}-filter]`).forEach(button => button.addEventListener('click', () => {
      const value = button.getAttribute(`data-${facet}-filter`) ?? 'all';
      state[facet] = state[facet] === value ? 'all' : value;
      commit();
    }));
    input.addEventListener('input', () => { state.q = input.value; commit(true); });
    sort.addEventListener('change', () => { state.sort = sort.value as typeof state.sort; commit(); });
    root.querySelectorAll('[data-directory-reset]').forEach(button => button.addEventListener('click', () => { state = readDirectoryFilters(new URLSearchParams()); commit(); input.focus(); }));
    window.addEventListener('popstate', () => { state = readDirectoryFilters(new URLSearchParams(location.search)); render(); });
    document.addEventListener('keydown', event => {
      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !(event.target instanceof HTMLElement && (event.target.isContentEditable || /INPUT|TEXTAREA|SELECT/.test(event.target.tagName)))) { event.preventDefault(); input.focus(); }
    });
    render();
  });
</script>
