---
import { SITE } from "../config";
import { DEFAULT_LANGUAGE, localizePath, type Language } from "../lib/i18n";
type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const zh = lang === "zh";
const groups = [
  { title: zh ? "探索" : "Explore", links: [
    { href: "/directory/", label: zh ? "资源目录" : "Resource directory" },
    { href: "/scenarios/", label: zh ? "实践指南" : "Scenarios" },
    { href: "/registry/", label: zh ? "精品 Skill" : "Curated skills" },
    { href: "/agents/claude/", label: "Claude" },
    { href: "/agents/codex/", label: "Codex" },
    { href: "/agents/cursor/", label: "Cursor" }
  ] },
  { title: zh ? "资源" : "Resources", links: [
    { href: "/guides/", label: zh ? "使用指南" : "Guides" },
    { href: "/insights/", label: zh ? "Skill 拆解" : "Skill deep-dives" },
    { href: "/install/", label: zh ? "安装与接入" : "Installation & setup" },
    { href: "/for-ai/", label: "For AI" },
    { href: "/quality/", label: zh ? "收录与质检标准" : "Curation & quality" }
  ] },
  { title: zh ? "参与" : "Connect", links: [
    { href: "/about/", label: zh ? "关于 SkillFlux" : "About SkillFlux" },
    { href: "/submit/", label: zh ? "提交资源" : "Submit a resource" },
    { href: SITE.repoUrl, label: "GitHub ↗", external: true },
    { href: "/contact/", label: zh ? "联系我们" : "Contact" },
    { href: "/feed.xml", label: "RSS", raw: true }
  ] }
];
---
<footer class="sf-footer">
  <div class="sf-footer-inner">
    <div class="sf-footer-grid">
      <div class="sf-footer-intro">
        <a class="sf-footer-brand" href={localizePath("/", lang)}><svg class="sf-brand-mark" width="24" height="24" viewBox="0 0 64 64" fill="none" aria-hidden="true"><defs><mask id="sfFooterMask"><rect width="64" height="64" fill="#000"/><rect x="6" y="6" width="52" height="52" rx="12" ry="12" fill="#fff"/><rect x="20" y="20" width="24" height="24" rx="4" ry="4" fill="#000"/></mask></defs><g mask="url(#sfFooterMask)"><rect x="6" y="6" width="14" height="52" fill="#34A853"/><rect x="6" y="44" width="52" height="14" fill="#FBBC04"/><rect x="6" y="44" width="14" height="14" fill="#188038"/><rect x="44" y="6" width="14" height="52" fill="#EA4335"/><rect x="44" y="44" width="14" height="14" fill="#F29900"/><rect x="6" y="6" width="52" height="14" fill="#4285F4"/><rect x="44" y="6" width="14" height="14" fill="#D93025"/><rect x="6" y="6" width="14" height="14" fill="#1967D2"/></g></svg><span class="sf-footer-word">SkillFlux</span></a>
        <p>{zh ? "AI Agent 开放功能黄页：\n让每一个想法，都有匹配的能力。" : "The yellow pages for AI agent capabilities:\nempowering every idea with the right tool."}</p>
        <span class="sf-footer-note">{zh ? "面向开发者与自主智能体" : "Built for developers and autonomous agents"}</span>
      </div>
      {groups.map(group => <div class="sf-footer-column"><h2>{group.title}</h2><ul>{group.links.map(link => <li><a href={'external' in link || 'raw' in link ? link.href : localizePath(link.href, lang)} rel={'external' in link ? 'noopener noreferrer' : undefined}>{link.label}</a></li>)}</ul></div>)}
    </div>
    <div class="sf-footer-bottom">
      <div class="sf-footer-copyright"><span>© {new Date().getFullYear()} SkillFlux</span><span>{zh ? "砚垚信息科技（上海）有限公司" : "Yanyao Information Tech (Shanghai) Co., Ltd."}</span></div>
      <div class="sf-footer-legal"><a href={localizePath("/privacy/", lang)}>{zh ? "隐私政策" : "Privacy"}</a><a href={localizePath("/terms/", lang)}>{zh ? "使用条款" : "Terms"}</a></div>
    </div>
  </div>
</footer>
<style>
  .sf-footer { margin-top: 0; background: var(--cream); border-top: 1px solid var(--line); color: var(--muted); }
  .sf-footer-inner { max-width: 1216px; margin: 0 auto; padding: 64px 32px 32px; }
  .sf-footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 64px; padding-bottom: 52px; }
  .sf-footer-brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); line-height: 1; }
  .sf-footer-word { font-size: 1.25rem; font-weight: 700; letter-spacing: -.03em; }
  .sf-footer-brand svg { display: block; flex-shrink: 0; }
  .sf-footer-intro p { margin: 18px 0 16px; color: var(--muted); font-size: 13px; line-height: 1.8; white-space: pre-line; }
  .sf-footer-note { font: 500 12px var(--font-mono); color: var(--faint); letter-spacing: .02em; }
  .sf-footer-column h2 { font: 600 12px var(--font-mono); margin: 3px 0 20px; letter-spacing: .06em; color: var(--ink); text-transform: uppercase; }
  .sf-footer-column ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sf-footer-column a { color: var(--muted); font-size: 13px; text-decoration: none; line-height: 1.5; transition: color .15s ease; }
  .sf-footer a:hover { color: var(--ink); }
  .sf-footer a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .sf-footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px 24px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 12px; color: var(--faint); }
  .sf-footer-copyright, .sf-footer-legal { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .sf-footer-legal a { color: var(--muted); text-decoration: none; transition: color .15s ease; }
  .sf-footer-legal a:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 800px) { .sf-footer-grid { grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 32px; } .sf-footer-inner { padding: 48px 24px 28px; } }
  @media (max-width: 600px) { .sf-footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 20px; padding-bottom: 36px; } .sf-footer-intro { grid-column: 1 / -1; } .sf-footer-intro p { margin: 16px 0 12px; } .sf-footer-column h2 { margin-bottom: 16px; } .sf-footer-bottom { font-size: 11px; } }
</style>
