---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEVELOPMENT_REGISTRY_URL } from "../lib/registry-client";
import { localizePath, type Language } from "../lib/i18n";
type Props = { lang?: Language; kind: "inquiry" | "report" };
const { lang = "zh", kind } = Astro.props;
const zh = lang === "zh", inquiry = kind === "inquiry";
const t = (cn: string, en: string) => zh ? cn : en;
const registryUrl = String(import.meta.env.PUBLIC_REGISTRY_URL ?? "").trim() || (import.meta.env.DEV ? DEVELOPMENT_REGISTRY_URL : "");
const title = inquiry ? t("广告合作，先聊需求。", "Tell us about your campaign.") : t("报告一条有问题的广告。", "Report an ad.");
const description = inquiry ? t("留下产品、公司和联系方式，供 SkillFlux 运营人员评估广告合作。", "Share your product, company and contact details for a SkillFlux advertising inquiry.") : t("提交广告活动 ID 与具体问题，交由运营人员复核。", "Send an advertising campaign ID and specific concerns for operator review.");
---
<BaseLayout lang={lang} canonicalPath={localizePath(inquiry ? "/advertise/" : "/report/", lang)} title={inquiry ? t("广告合作", "Advertise") : t("广告举报", "Report an ad")} description={description} pageClass="public-form-page">
  <main id="main-content" class="public-form-shell" data-public-form data-kind={kind} data-registry-url={registryUrl} data-lang={lang}>
    <a class="form-back" href={localizePath("/", lang)}>← {t("返回首页", "Home")}</a>
    <header class="form-heading"><p class="eyebrow"><span></span>{inquiry ? "ADVERTISING INQUIRY" : "AD REVIEW"}</p><h1>{title}</h1><p>{description}</p></header>
    <div class="form-layout">
      <aside>
        <h2>{inquiry ? t("透明的广告位，明确的边界。", "Clear placements. Clear limits.") : t("让我们能找到并复核问题。", "Help us locate the problem.")}</h2>
        {inquiry ? <>
          <p>{t("付费内容明确标记「广告」。宿主原生回答只能尽力提示；只有 SkillFlux 管理输出的模式能确定性追加广告。敏感场景跳过广告，广告不得改变 Skill 搜索排序或安装决策。", "Paid content is labelled “广告” (advertisement). Native host responses use best-effort display; only SkillFlux managed output can append an ad deterministically. Sensitive contexts skip ads, and ads do not control skill ranking or installation.")}</p>
          <p>{t("合作采用有效点击计费，后台分别记录预算、预留与花费。此表只是咨询，不下单、不收款，也不保证展示量、转化或被 AI 收录。", "Campaigns account for valid clicks and track budget, reserved funds and spend separately. This form is an inquiry, not an order or payment. It does not promise impressions, conversions or AI indexing.")}</p>
          <p>{t("咨询无须账号，但不是匿名提交。我们需要可联系的人评估需求；请勿提交密钥、客户数据或其他敏感信息。", "No account is required, but this inquiry is not anonymous. We need a contact to assess your request. Do not send secrets, customer records or other sensitive information.")}</p>
        </> : <>
          <p>{t("请填写广告活动 ID（campaignId）和能复现的问题。可描述虚假宣传、目标网址风险、不适当内容或披露问题；不要粘贴私人对话、密钥或个人资料。", "Provide the campaign ID and enough detail to reproduce the issue. Examples include misleading claims, an unsafe destination, inappropriate content or missing disclosure. Do not paste private conversations, secrets or personal data.")}</p>
          <p>{t("提交无需账号或联系方式。受理只表示记录已保存，处理人员核查后会驳回举报或暂停广告；不能承诺每条举报都会下架。", "No account or contact details are required. Acceptance means the report was saved. Operators can dismiss it or pause the campaign after review; submission does not guarantee removal.")}</p>
        </>}
        <nav><a href={localizePath("/privacy/", lang)}>{t("隐私说明", "Privacy")}</a><a href={localizePath("/terms/", lang)}>{t("服务与广告条款", "Service and advertising terms")}</a>{inquiry && <a href={localizePath("/report/",lang)}>{t("举报广告", "Report an ad")}</a>}</nav>
      </aside>
      <form data-request-form>
        <p class="form-api-note" data-api-note>{registryUrl ? t("提交成功后会显示后端记录编号。", "A successful submission will show the registry record ID.") : t("本站尚未配置接收表单的 Registry API，当前无法提交。请稍后重新访问。", "A registry API has not been configured to receive this form. Submission is currently unavailable; please return later.")}</p>
        <fieldset>
          <legend class="visually-hidden">{inquiry ? t("广告合作咨询表", "Advertising inquiry form") : t("举报表", "Report form")}</legend>
          {inquiry ? <>
            <label>{t("产品名称", "Product name")}<input name="product" maxlength="120" required autocomplete="off" /></label>
            <label>{t("公司 / 组织", "Company / organization")}<input name="company" maxlength="120" required autocomplete="organization" /></label>
            <label>{t("产品官网（HTTPS）", "Product website (HTTPS)")}<input name="website" type="url" placeholder="https://" required maxlength="2048" inputmode="url" /></label>
            <label>{t("联系人", "Contact name")}<input name="name" maxlength="120" required autocomplete="name" /></label>
            <label>{t("联系方式类型", "Contact method")}<select name="contactType"><option value="email">{t("邮箱", "Email")}</option><option value="phone">{t("电话", "Phone")}</option><option value="wechat">{t("微信", "WeChat")}</option></select></label>
            <label>{t("联系方式（至少一种）", "Contact details (one method required)")}<input name="contact" type="email" maxlength="240" required autocomplete="email" /></label>
            <label>{t("合作需求、目标人群与计划", "Campaign needs, audience and plans")}<textarea name="message" rows="6" minlength="10" maxlength="4000" required></textarea></label>
            <label class="form-consent"><input type="checkbox" name="consent" required /><span>{t("我同意 SkillFlux 使用上述资料评估和联系此次合作，并已阅读隐私说明。", "I agree that SkillFlux may use these details to assess and contact me about this inquiry, and I have read the privacy notice.")}</span></label>
          </> : <>
            <label>{t("广告活动 ID", "Campaign ID")}<input name="campaignId" maxlength="120" required autocomplete="off" /></label>
            <label>{t("具体问题及复现线索", "Issue and reproduction details")}<textarea name="reason" rows="9" minlength="10" maxlength="2000" required></textarea></label>
          </>}
          <button type="submit" disabled={!registryUrl}>{inquiry ? t("提交咨询", "Submit inquiry") : t("提交举报", "Submit report")} <span>→</span></button>
        </fieldset>
        <p data-submit-status role="status" aria-live="polite"></p>
        <noscript><p>{t("提交需要浏览器 JavaScript；静态说明仍可阅读。", "Submission requires browser JavaScript; the static information remains readable.")}</p></noscript>
      </form>
    </div>
  </main>
</BaseLayout>
<script>
  import { fetchJson, isObject, safeExternalUrl } from "../lib/registry-client";
  const root = document.querySelector<HTMLElement>("[data-public-form]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-request-form]")!;
    const status = root.querySelector<HTMLElement>("[data-submit-status]")!;
    const fieldset = form.querySelector<HTMLFieldSetElement>("fieldset")!;
    const inquiry = root.dataset.kind === "inquiry";
    const locale = root.dataset.lang === "en" ? "en" : "zh";
    const t = (zh: string, en: string) => locale === "zh" ? zh : en;
    let requestId = crypto.randomUUID();
    form.addEventListener("input", () => { requestId = crypto.randomUUID(); status.textContent = ""; });
    const contactType = form.elements.namedItem("contactType") as HTMLSelectElement | null;
    const contact = form.elements.namedItem("contact") as HTMLInputElement | null;
    contactType?.addEventListener("change", () => {
      if (contact) { contact.type = contactType.value === "email" ? "email" : "text"; contact.autocomplete = contactType.value === "email" ? "email" : contactType.value === "phone" ? "tel" : "off"; contact.inputMode = contactType.value === "phone" ? "tel" : contactType.value === "email" ? "email" : "text"; }
    });
    if (!inquiry) {
      const campaignId = new URLSearchParams(location.search).get("campaignId");
      if (campaignId && campaignId.length <= 120) (form.elements.namedItem("campaignId") as HTMLInputElement).value = campaignId;
    }
    form.addEventListener("submit", async event => {
      event.preventDefault();
      const data = new FormData(form);
      const get = (name: string) => String(data.get(name) ?? "").trim();
      let payload: Record<string, unknown>;
      if (inquiry) {
        const website = safeExternalUrl(get("website"));
        if (!website) { status.textContent = t("请填写不含账号信息的 HTTPS 官网。", "Enter an HTTPS website without embedded credentials."); status.className = "is-error"; return; }
        if (get("contactType") === "phone" && !/^[+\d][\d\s().-]{5,29}$/.test(get("contact"))) { status.textContent = t("请检查联系电话格式。", "Check the phone number format."); status.className = "is-error"; return; }
        payload = { requestId, product: get("product"), company: get("company"), website, name: get("name"), contact: get("contactType") + ": " + get("contact"), message: get("message"), consent: data.get("consent") === "on" };
      } else payload = { requestId, campaignId: get("campaignId"), reason: get("reason") };
      fieldset.disabled = true; status.className = ""; status.textContent = t("正在保存，请稍候…", "Saving your request…");
      try {
        const result = await fetchJson<{ id: string; accepted: true }>(root.dataset.registryUrl ?? "", inquiry ? "/v1/inquiries" : "/v1/reports", { method: "POST", body: JSON.stringify(payload) }, { locale, validate: value => isObject(value) && value.accepted === true && typeof value.id === "string" && value.id.length > 0 });
        status.textContent = t("提交已保存，记录编号：", "Your submission was saved. Record ID: ") + result.id;
        form.reset(); requestId = crypto.randomUUID();
        if (contact) { contact.type = "email"; contact.autocomplete = "email"; }
      } catch (error) {
        status.textContent = (error instanceof Error ? error.message : String(error)) + t(" 填写内容已保留，可直接重试。", " Your input is preserved. You can retry.");
        status.className = "is-error";
      } finally { fieldset.disabled = false; }
    });
  }
</script>
<style>
  .public-form-shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; padding: 40px 0 100px; }
  .form-back { font-size: .8rem; }
  .form-heading { padding: 55px 0 50px; border-bottom: 2px solid var(--ink); }
  .form-heading h1 { max-width: 15ch; margin: 0 0 24px; font-family: var(--font-body); font-size: clamp(2.5rem,5vw,3.8rem); line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
  .form-heading > p:last-child { max-width: 65ch; color: var(--muted); line-height: 1.7; }
  .form-layout { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: clamp(36px,7vw,100px); padding-top: 44px; }
  .form-layout aside h2 { margin: 0 0 28px; font-family: var(--font-body); font-size: 1.65rem; }
  .form-layout aside p { font-size: .88rem; line-height: 1.85; color: var(--muted); }
  .form-layout aside nav { display: flex; gap: 15px; flex-wrap: wrap; margin-top: 28px; font-size: .82rem; }
  .form-api-note { border-left: 3px solid var(--accent); padding: 10px 16px; margin: 0 0 30px; font-size: .84rem; line-height: 1.6; }
  fieldset { display: grid; gap: 24px; border: 0; padding: 0; margin: 0; min-width: 0; }
  label { display: grid; gap: 9px; font-size: .85rem; font-weight: 600; }
  input, textarea, select { min-width: 0; width: 100%; box-sizing: border-box; background: transparent; border: 1px solid var(--ink); border-radius: 0; padding: 13px; font: inherit; color: var(--ink); }
  textarea { resize: vertical; line-height: 1.7; }
  .form-consent { display: flex; gap: 12px; align-items: start; line-height: 1.7; font-weight: 400; }
  .form-consent input { width: 18px; height: 18px; margin-top: 4px; flex: 0 0 18px; }
  button { display: flex; justify-content: space-between; border: 1px solid var(--accent); background: var(--accent); color: #fdfcf8; padding: 17px 20px; font: inherit; font-weight: 650; cursor: pointer; transition: background .2s; }
  button:hover:not(:disabled) { background: var(--ink); border-color: var(--ink); }
  button:disabled { opacity: .45; cursor: not-allowed; }
  :is(input,textarea,select,button,a):focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  [data-submit-status] { min-height: 1.8em; line-height: 1.7; overflow-wrap: anywhere; }
  .is-error { color: var(--accent); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media(max-width:720px) { .public-form-shell { width: calc(100% - 30px); } .form-layout { grid-template-columns: 1fr; } .form-heading { padding-top: 36px; } }
</style>
