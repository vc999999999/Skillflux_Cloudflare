---
import { getCategories, type Site } from '../lib/content';
import { DEFAULT_LANGUAGE, getSiteCopy, localizePath, translateCategory, translateRegion, type Language } from '../lib/i18n';
import Icon from './Icon.astro';
type Props = { sites: Site[]; showControls?: boolean; heading?: string; compact?: boolean; lang?: Language };
const { sites, showControls = false, heading, compact = false, lang = DEFAULT_LANGUAGE } = Astro.props;
const zh = lang === 'zh';
const resolvedHeading = heading ?? (showControls ? (zh ? '资源目录' : 'Resource directory') : (zh ? '全部资源' : 'All resources'));
const categories = getCategories();
const categoryNames = new Map(categories.map(category => [category.slug, translateCategory(category.slug, category.label, lang)]));
const kindLabels: Record<Site['kinds'][number], string> = { skill: 'Skills', mcp: 'MCP', plugin: zh ? '插件' : 'Plugins' };
const facets = [
  { key: 'kind', label: zh ? '资源类型' : 'RESOURCE TYPE', options: (['skill', 'mcp', 'plugin'] as const).map(kind => ({ value: kind, label: kindLabels[kind], count: sites.filter(site => site.kinds.includes(kind)).length })) },
  { key: 'category', label: zh ? '来源分类' : 'SOURCE', options: categories.map(category => ({ value: category.slug, label: categoryNames.get(category.slug)!, count: sites.filter(site => site.category === category.slug).length })) },
  { key: 'region', label: zh ? '地区' : 'REGION', options: ['cn', 'global'].map(region => ({ value: region, label: translateRegion(region, lang), count: sites.filter(site => site.region === region).length })) },
];
---
<section class:list={['resource-table-shell', compact && 'is-compact', showControls && 'has-controls']} data-directory={showControls ? 'true' : undefined} data-count-suffix={zh ? '个来源' : 'sources'}>
  {showControls && <div class="directory-topbar">
    <label class="directory-search"><Icon name="search" size={18} /><span class="sr-only">{zh ? '搜索资源' : 'Search resources'}</span><input type="search" data-directory-search placeholder={zh ? '搜索名称、功能、标签…' : 'Search names, capabilities, tags…'} autocomplete="off" maxlength="200" /><kbd>/</kbd></label>
  </div>}
  <div class="directory-layout">
    {showControls && <details class="directory-sidebar" open data-directory-sidebar>
      <summary>{zh ? '筛选资源' : 'Filter resources'}<span data-active-filters></span><span aria-hidden="true">⌄</span></summary>
      <div class="sidebar-inner">
        <div class="sidebar-top"><h2>{zh ? '筛选' : 'Filters'}</h2><button type="button" data-directory-reset>{zh ? '重置' : 'Reset'}</button></div>
        <div class="filter-group recommended-filter"><button type="button" data-recommended-filter="yes" aria-pressed="false"><span class="filter-checkbox" aria-hidden="true"></span><span>{zh ? '只看编辑推荐' : 'Editor recommendations'}</span></button></div>
        {facets.map(facet => <div class="filter-group" role="group" aria-label={facet.label}>
          <h3>{facet.label}</h3>
          <button type="button" {...{ [`data-${facet.key}-filter`]: 'all' }} aria-pressed="true"><span class="filter-checkbox" aria-hidden="true"></span><span>{zh ? '全部' : 'All'}</span><small>{sites.length}</small></button>
          {facet.options.filter(option => option.count > 0).map(option => <button type="button" {...{ [`data-${facet.key}-filter`]: option.value }} aria-pressed="false"><span class="filter-checkbox" aria-hidden="true"></span><span>{option.label}</span><small>{option.count}</small></button>)}
        </div>)}
        <p class="filter-help">{zh ? '目录收录外部来源；可安装的审核版本见精品 Registry。' : 'The directory lists external sources. Reviewed, installable releases live in the curated Registry.'}</p>
      </div>
    </details>}
    <div class="directory-results">
      <div class="results-toolbar"><h2>{resolvedHeading}<span data-result-count role="status" aria-live="polite">{sites.length} {zh ? '个来源' : 'sources'}</span></h2>{showControls && <label class="directory-sort"><span>{zh ? '排序' : 'Sort'}</span><select data-directory-sort aria-label={zh ? '资源排序' : 'Sort resources'}><option value="recommended">{zh ? '推荐优先' : 'Recommended'}</option><option value="newest">{zh ? '最近更新' : 'Recently updated'}</option><option value="name">{zh ? '名称排序' : 'Name'}</option></select></label>}</div>
      <div class="resource-table" role="list" aria-label={resolvedHeading} data-resource-list>
        {sites.map((site, index) => {
          const item = getSiteCopy(site, lang);
          const usecaseSlugs = site.editorial?.useCases ?? [];
          const searchable = [site.name, item.name, site.tagline, item.tagline, site.summary, item.summary, item.type, ...item.tags, ...site.tags, ...usecaseSlugs].join(' ');
          const kindIcon = { skill: 'spark', mcp: 'plug', plugin: 'layers' }[site.kinds[0]] ?? 'grid';
          return <article class="resource-row" role="listitem" data-site-row data-category={site.category} data-region={site.region} data-trust={site.trustLevel} data-kind={site.kinds.join(' ')} data-usecase={usecaseSlugs.join(' ')} data-recommended={site.recommended ? 'yes' : 'no'} data-search={searchable} data-name={item.name} data-updated={site.updatedAt} data-position={index}>
            <span class="resource-icon"><Icon name={kindIcon} size={23} /></span>
            <div class="resource-main"><div class="resource-title"><h3><a href={localizePath(`/resource/${site.resourceSlug}/`, lang)}>{item.name}</a></h3>{site.recommended && <span class="editor-badge">{zh ? '编辑推荐' : 'Editor pick'}</span>}</div><p>{item.summary}</p><div class="resource-labels"><span class="type-tag">{site.kinds.map(kind => kindLabels[kind]).join(' + ')}</span><span>{categoryNames.get(site.category)}</span>{item.tags.filter(tag => !['Agent Skills', '推荐', 'Recommended', '合集', 'Collection', translateRegion(site.region, lang)].includes(tag)).slice(0, 2).map(tag => <span>{tag}</span>)}<span class="resource-region">{translateRegion(site.region, lang)}</span></div></div>
            <a class="row-link" href={localizePath(`/resource/${site.resourceSlug}/`, lang)} aria-label={`${zh ? '查看' : 'View'} ${item.name}`}><span>{zh ? '查看' : 'View'}</span><span aria-hidden="true">↗</span></a>
          </article>;
        })}
      </div>
      {showControls && <div class="directory-empty" data-directory-empty hidden><Icon name="search" size={30} /><h3>{zh ? '没有找到匹配的资源' : 'No matching resources'}</h3><p>{zh ? '试试更简短的关键词，或清除筛选重新查找。' : 'Try a shorter keyword, or clear the filters to explore again.'}</p><button type="button" data-directory-reset>{zh ? '清除全部筛选' : 'Clear all filters'}</button></div>}
      {showControls && <noscript><p>{zh ? '下方保留完整来源目录；启用 JavaScript 后可使用搜索与筛选。' : 'The full directory is available. Enable JavaScript for search and filtering.'}</p></noscript>}
    </div>
  </div>
</section>

<style>
  .resource-table-shell { min-width: 0; margin-block: 28px 64px; }
  .directory-topbar { display: flex; gap: 20px; align-items: center; margin-bottom: 32px; }
  .directory-search { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: var(--radius-md); min-height: 48px; padding: 0 16px; flex: 1; background: var(--paper-strong); color: var(--muted); box-shadow: var(--shadow-sm); transition: border-color .18s ease, box-shadow .18s ease; }
  .directory-search:focus-within { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(23, 21, 15, 0.08); outline: none; }
  .directory-search input { width: 100%; border: 0; background: transparent; outline: 0; min-width: 0; font: inherit; font-size: .92rem; color: var(--ink); }
  .directory-search kbd { border: 1px solid var(--line); border-radius: 3px; font: 500 11px var(--font-mono); padding: 2px 6px; background: var(--paper); color: var(--faint); }

  .has-controls .directory-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 38px; align-items: start; }
  .directory-sidebar { border-right: 1px solid var(--line); padding-right: 25px; }
  .directory-sidebar summary { display: none; }
  .sidebar-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .sidebar-top h2 { margin: 0; font-size: .92rem; font-weight: 650; }
  .sidebar-top button { border: 0; background: none; font: inherit; font-size: .78rem; color: var(--muted); padding: 5px 0; cursor: pointer; }
  .sidebar-top button:hover { color: var(--ink); text-decoration: underline; }
  .filter-group { border-top: 1px solid var(--line); padding-block: 20px 16px; }
  .filter-group h3 { margin: 0 0 12px; color: var(--muted); font: 600 .75rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .filter-group button { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; border: none; background: none; font: inherit; font-size: .82rem; color: var(--muted); padding: 6px 0; cursor: pointer; line-height: 1.4; transition: color .15s ease; }
  .filter-group button[aria-pressed="true"] { color: var(--ink); font-weight: 650; }
  .filter-group button:hover { color: var(--ink); }
  .filter-checkbox { flex: 0 0 14px; height: 14px; width: 14px; border: 1px solid rgba(23, 21, 15, 0.28); border-radius: 3px; background: var(--paper-strong); transition: all .15s ease; }
  button[aria-pressed="true"] .filter-checkbox { border-color: var(--ink); background: var(--ink); box-shadow: inset 0 0 0 2px var(--paper-strong); }
  .filter-group small { margin-left: auto; color: var(--faint); font: 500 .72rem var(--font-mono); }
  .recommended-filter { border: 0; padding: 0 0 18px; }
  .filter-help { font-size: .75rem; color: var(--faint); line-height: 1.7; margin-top: 18px; }
  .results-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; min-height: 30px; }
  .results-toolbar h2 { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin: 0; font-size: .96rem; font-weight: 650; }
  .results-toolbar h2 span { font-size: .78rem; font-weight: 500; color: var(--muted); }
  .directory-sort { display: flex; align-items: center; gap: 8px; font-size: .78rem; color: var(--muted); }
  .directory-sort select { font: inherit; color: var(--ink); padding: 7px 24px 7px 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper-strong); max-width: 170px; font-size: .8rem; }
  .resource-table { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .resource-row { min-width: 0; display: flex; align-items: flex-start; gap: 20px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .resource-row:hover { transform: translateY(-1px); border-color: rgba(23, 21, 15, 0.28); box-shadow: var(--shadow-hover); }
  .resource-row[hidden], .directory-empty[hidden] { display: none !important; }
  .resource-icon { width: 48px; height: 48px; display: grid; place-items: center; flex: 0 0 48px; background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius-md); color: var(--ink); }
  .resource-main { flex: 1; min-width: 0; }
  .resource-title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .resource-title h3 { margin: 0; font-size: 1.05rem; line-height: 1.45; font-weight: 650; overflow-wrap: anywhere; }
  .resource-title h3 a { text-decoration: none; color: var(--ink); }
  .resource-title h3 a:hover { color: var(--accent); }
  .editor-badge { font-size: .72rem; font-weight: 550; border: 1px solid var(--ink); border-radius: 3px; padding: 1px 6px; white-space: nowrap; color: var(--ink); background: var(--paper); }
  .resource-main p { margin: 8px 0 14px; color: var(--muted); font-size: .84rem; line-height: 1.75; max-width: 78ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .resource-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .resource-labels span { overflow-wrap: anywhere; color: var(--muted); border: 1px solid var(--line); border-radius: 3px; padding: 3px 8px; font-size: .72rem; line-height: 1.4; background: var(--paper); }
  .resource-labels .type-tag { color: var(--ink); background: var(--cream); font-weight: 600; }
  .resource-labels .resource-region { border: 0; background: transparent; padding-left: 2px; }
  .row-link { display: flex; align-items: center; gap: 8px; text-decoration: none; font-size: .82rem; font-weight: 550; margin-top: 6px; padding: 6px 10px; border-radius: var(--radius-sm); flex-shrink: 0; color: var(--ink); border: 1px solid var(--line); background: var(--paper); transition: all .15s ease; }
  .row-link:hover { border-color: var(--line-strong); background: var(--cream); }
  .row-link span:first-child { color: var(--muted); }
  .directory-empty { text-align: center; padding: 72px 20px; border: 1px dashed var(--line); border-radius: var(--radius-lg); color: var(--muted); background: var(--paper-strong); }
  .directory-empty svg { margin: 0 auto 16px; color: var(--faint); }
  .directory-empty h3 { color: var(--ink); font-size: 1.05rem; font-weight: 650; }
  .directory-empty p { font-size: .88rem; line-height: 1.7; }
  .directory-empty button { margin-top: 14px; border: 1px solid var(--ink); padding: 9px 18px; border-radius: var(--radius-md); color: var(--paper-strong); background: var(--ink); cursor: pointer; font: inherit; font-size: .84rem; font-weight: 500; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 960px) { .has-controls .directory-layout { grid-template-columns: 190px minmax(0, 1fr); gap: 24px; }.directory-sidebar { padding-right: 20px; }.resource-row { padding: 20px; gap: 14px; }.row-link span:first-child { display: none; } }
  @media (max-width: 760px) {
    .resource-table-shell { margin-top: 24px; }.directory-topbar { flex-wrap: wrap; gap: 14px; margin-bottom: 22px; }.directory-search { flex-basis: 100%; }
    .has-controls .directory-layout { display: block; }.directory-sidebar { border: 1px solid var(--line); border-radius: var(--radius-md); padding: 0; margin-bottom: 24px; background: var(--paper-strong); }.directory-sidebar summary { display: flex; align-items: center; gap: 9px; cursor: pointer; padding: 14px 18px; font-size: .86rem; font-weight: 600; }.directory-sidebar summary span:last-child { margin-left: auto; }.sidebar-inner { padding: 10px 18px 18px; }.sidebar-top { margin-top: 5px; }.sidebar-top h2 { visibility: hidden; }.filter-group { padding-block: 15px; }.filter-group button { font-size: .84rem; padding-block: 8px; }
    .results-toolbar h2 { font-size: .88rem; gap: 8px; }.directory-sort > span { display: none; }.directory-sort select { max-width: 130px; }.resource-row { padding: 18px 16px; gap: 14px; }.resource-icon { width: 40px; height: 40px; flex-basis: 40px; border-radius: var(--radius-md); }.resource-title h3 { font-size: .96rem; }.resource-main p { font-size: .8rem; -webkit-line-clamp: 3; }.row-link { padding: 4px 8px; }.resource-labels { gap: 5px; }.resource-labels span { font-size: .7rem; }.resource-title { gap: 6px; }
  }
</style>
