---
import { getCategories, type Site } from '../lib/content';
import { DEFAULT_LANGUAGE, getSiteCopy, localizePath, translateCategory, translateRegion, translateTrust, type Language } from '../lib/i18n';
import { getSiteUseCases, useCases } from '../lib/editorial';
import Icon from './Icon.astro';
type Props = { sites: Site[]; showControls?: boolean; heading?: string; compact?: boolean; lang?: Language };
const { sites, showControls = false, heading, compact = false, lang = DEFAULT_LANGUAGE } = Astro.props;
const zh = lang === 'zh';
const resolvedHeading = heading ?? (zh ? '全部资源' : 'All resources');
const categories = getCategories();
const categoryNames = new Map(categories.map(category => [category.slug, translateCategory(category.slug, category.label, lang)]));
const kinds = (site: Site) => [site.tags.includes('Agent Skills') ? 'skill' : '', site.tags.includes('MCP') ? 'mcp' : ''].filter(Boolean);
const facets = [
  { key: 'kind', label: zh ? '资源类型' : 'RESOURCE TYPE', options: [{ value: 'skill', label: 'Agent Skills', count: sites.filter(site => kinds(site).includes('skill')).length }, { value: 'mcp', label: 'MCP', count: sites.filter(site => kinds(site).includes('mcp')).length }] },
  { key: 'usecase', label: zh ? '使用场景' : 'USE CASE', options: useCases.map(entry => ({ value: entry.slug, label: entry.title[lang], count: sites.filter(site => entry.siteSlugs.includes(site.slug)).length })) },
  { key: 'category', label: zh ? '来源分类' : 'SOURCE', options: categories.map(category => ({ value: category.slug, label: categoryNames.get(category.slug)!, count: sites.filter(site => site.category === category.slug).length })) },
  { key: 'region', label: zh ? '地区' : 'REGION', options: ['cn', 'global'].map(region => ({ value: region, label: translateRegion(region, lang), count: sites.filter(site => site.region === region).length })) },
  { key: 'trust', label: zh ? '来源信任度' : 'SOURCE TRUST', options: ['high', 'medium', 'emerging'].map(trust => ({ value: trust, label: translateTrust(trust, lang), count: sites.filter(site => site.trustLevel === trust).length })) },
];
---
<section class:list={['resource-table-shell', compact && 'is-compact', showControls && 'has-controls']} data-directory={showControls ? 'true' : undefined} data-count-suffix={zh ? '个来源' : 'sources'}>
  {showControls && <div class="directory-topbar">
    <label class="directory-search"><Icon name="search" size={18} /><span class="sr-only">{zh ? '搜索资源' : 'Search resources'}</span><input type="search" data-directory-search placeholder={zh ? '搜索名称、功能、标签…' : 'Search names, capabilities, tags…'} autocomplete="off" maxlength="200" /><kbd>/</kbd></label>
    <a class="all-collections" href={localizePath('/collections/', lang)}>{zh ? '浏览精选合集' : 'Browse collections'} <span aria-hidden="true">↗</span></a>
  </div>}
  <div class="directory-layout">
    {showControls && <details class="directory-sidebar" open data-directory-sidebar>
      <summary>{zh ? '筛选资源' : 'Filter resources'}<span data-active-filters></span><span aria-hidden="true">⌄</span></summary>
      <div class="sidebar-inner">
        <div class="sidebar-top"><h2>{zh ? '筛选' : 'Filters'}</h2><button type="button" data-directory-reset>{zh ? '重置' : 'Reset'}</button></div>
        <div class="filter-group recommended-filter"><button type="button" data-recommended-filter="yes" aria-pressed="false"><span class="filter-checkbox" aria-hidden="true"></span><span>{zh ? '只看编辑推荐' : 'Editor recommendations'}</span></button></div>
        {facets.map(facet => <div class="filter-group" role="group" aria-label={facet.label}>
          <h3>{facet.label}</h3>
          <button type="button" {...{ [`data-${facet.key}-filter`]: 'all' }} aria-pressed="true"><span class="filter-checkbox" aria-hidden="true"></span><span>{zh ? '全部' : 'All'}</span><small>{sites.length}</small></button>
          {facet.options.filter(option => option.count > 0).map(option => <button type="button" {...{ [`data-${facet.key}-filter`]: option.value }} aria-pressed="false"><span class="filter-checkbox" aria-hidden="true"></span><span>{option.label}</span><small>{option.count}</small></button>)}
        </div>)}
        <p class="filter-help">{zh ? '场景为编辑整理；来源信任度不代表安装审核。' : 'Use cases are editorial groupings. Source trust is not installation approval.'}</p>
      </div>
    </details>}
    <div class="directory-results">
      <div class="results-toolbar"><h2>{showControls ? (zh ? '资源目录' : 'Resource directory') : resolvedHeading}<span data-result-count role="status" aria-live="polite">{sites.length} {zh ? '个来源' : 'sources'}</span></h2>{showControls && <label class="directory-sort"><span>{zh ? '排序' : 'Sort'}</span><select data-directory-sort aria-label={zh ? '资源排序' : 'Sort resources'}><option value="recommended">{zh ? '推荐优先' : 'Recommended'}</option><option value="newest">{zh ? '最近更新' : 'Recently updated'}</option><option value="name">{zh ? '名称排序' : 'Name'}</option></select></label>}</div>
      <div class="resource-table" role="list" aria-label={resolvedHeading} data-resource-list>
        {sites.map((site, index) => {
          const item = getSiteCopy(site, lang);
          const cases = getSiteUseCases(site.slug);
          const searchable = [site.name, item.name, site.tagline, item.tagline, site.summary, item.summary, item.type, ...item.tags, ...site.tags, ...cases.flatMap(entry => [entry.title.zh, entry.title.en])].join(' ');
          return <article class="resource-row" role="listitem" data-site-row data-category={site.category} data-region={site.region} data-trust={site.trustLevel} data-kind={kinds(site).join(' ')} data-usecase={cases.map(entry => entry.slug).join(' ')} data-recommended={site.recommended ? 'yes' : 'no'} data-search={searchable} data-name={item.name} data-updated={site.updatedAt} data-position={index}>
            <span class="resource-icon"><Icon name={cases[0]?.icon ?? 'grid'} size={23} /></span>
            <div class="resource-main"><div class="resource-title"><h3><a href={localizePath(`/resource/${site.resourceSlug}/`, lang)}>{item.name}</a></h3>{site.recommended && <span class="editor-badge">{zh ? '编辑推荐' : 'Editor pick'}</span>}</div><p>{item.summary}</p><div class="resource-labels"><span class="type-tag">{kinds(site).map(kind => kind === 'mcp' ? 'MCP' : 'Skill').join(' + ')}</span><span>{categoryNames.get(site.category)}</span>{item.tags.filter(tag => !['Agent Skills', '推荐', 'Recommended', '合集', 'Collection', translateRegion(site.region, lang)].includes(tag)).slice(0, 2).map(tag => <span>{tag}</span>)}<span class="resource-region">{translateRegion(site.region, lang)}</span></div></div>
            <a class="row-link" href={localizePath(`/resource/${site.resourceSlug}/`, lang)} aria-label={`${zh ? '查看' : 'View'} ${item.name}`}><span>{zh ? '查看' : 'View'}</span><span aria-hidden="true">↗</span></a>
          </article>;
        })}
      </div>
      {showControls && <div class="directory-empty" data-directory-empty hidden><Icon name="search" size={30} /><h3>{zh ? '没有找到匹配的资源' : 'No matching resources'}</h3><p>{zh ? '试试更简短的关键词，或清除筛选重新查找。' : 'Try a shorter keyword, or clear the filters to explore again.'}</p><button type="button" data-directory-reset>{zh ? '清除全部筛选' : 'Clear all filters'}</button></div>}
      {showControls && <noscript><p>{zh ? '下方保留完整来源目录；启用 JavaScript 后可使用搜索与筛选。' : 'The full directory is available. Enable JavaScript for search and filtering.'}</p></noscript>}
    </div>
  </div>
</section>

<style>
  .resource-table-shell { min-width: 0; margin-block: 30px 64px; }
  .directory-topbar { display: flex; gap: 22px; align-items: center; margin-bottom: 35px; }
  .directory-search { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: 7px; min-height: 48px; padding: 0 15px; flex: 1; background: var(--paper, #fff); color: var(--muted); }
  .directory-search:focus-within { outline: 2px solid var(--ink); outline-offset: 2px; }
  .directory-search input { width: 100%; border: 0; background: transparent; outline: 0; min-width: 0; font: inherit; font-size: .84rem; color: var(--ink); }
  .directory-search kbd { border: 1px solid var(--line); border-radius: 3px; font-size: 11px; padding: 0 6px; }
  .all-collections { font-size: .8rem; font-weight: 550; white-space: nowrap; text-decoration: none; }
  .all-collections span { margin-left: 10px; }
  .has-controls .directory-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 38px; align-items: start; }
  .directory-sidebar { border-right: 1px solid var(--line); padding-right: 25px; }
  .directory-sidebar summary { display: none; }
  .sidebar-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13px; }
  .sidebar-top h2 { margin: 0; font-size: .87rem; }
  .sidebar-top button { border: 0; background: none; font: inherit; font-size: .71rem; color: var(--muted); padding: 5px 0; cursor: pointer; }
  .filter-group { border-top: 1px solid var(--line); padding-block: 21px 18px; }
  .filter-group h3 { margin: 0 0 11px; color: var(--muted); font-size: .66rem; font-weight: 600; letter-spacing: .08em; }
  .filter-group button { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; border: none; background: none; font: inherit; font-size: .75rem; color: var(--muted); padding: 7px 0; cursor: pointer; line-height: 1.4; }
  .filter-group button[aria-pressed="true"] { color: var(--ink); font-weight: 650; }
  .filter-group button:hover { color: var(--ink); }
  .filter-checkbox { flex: 0 0 12px; height: 12px; width: 12px; border: 1px solid #c9c9c9; border-radius: 3px; }
  button[aria-pressed="true"] .filter-checkbox { border-color: var(--ink); background: var(--ink); box-shadow: inset 0 0 0 2px var(--paper, #fff); }
  .filter-group small { margin-left: auto; color: #8a8a8a; font-weight: 400; font-size: .66rem; }
  .recommended-filter { border: 0; padding: 0 0 18px; }
  .filter-help { font-size: .66rem; color: var(--muted); line-height: 1.7; }
  .results-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; min-height: 28px; }
  .results-toolbar h2 { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin: 0; font-size: .9rem; }
  .results-toolbar h2 span { font-size: .7rem; font-weight: 400; color: var(--muted); }
  .directory-sort { display: flex; align-items: center; gap: 7px; font-size: .7rem; color: var(--muted); }
  .directory-sort select { font: inherit; color: var(--ink); padding: 7px 24px 7px 9px; border: 1px solid var(--line); border-radius: 5px; background: var(--paper, #fff); max-width: 170px; }
  .resource-table { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .resource-row { min-width: 0; display: flex; align-items: flex-start; gap: 18px; padding: 24px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper, #fff); transition: border-color .16s; }
  .resource-row:hover { border-color: #949494; }
  .resource-row[hidden], .directory-empty[hidden] { display: none !important; }
  .resource-icon { width: 46px; height: 46px; display: grid; place-items: center; flex: 0 0 46px; background: var(--cream, #f6f6f6); border: 1px solid var(--line); border-radius: 9px; }
  .resource-main { flex: 1; min-width: 0; }
  .resource-title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .resource-title h3 { margin: 0; font-size: .94rem; line-height: 1.5; overflow-wrap: anywhere; }
  .resource-title h3 a { text-decoration: none; }
  .editor-badge { font-size: .6rem; line-height: 1.5; border: 1px solid var(--ink); border-radius: 3px; padding: 1px 5px; white-space: nowrap; }
  .resource-main p { margin: 8px 0 14px; color: var(--muted); font-size: .76rem; line-height: 1.8; max-width: 78ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .resource-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .resource-labels span { overflow-wrap: anywhere; color: var(--muted); border: 1px solid var(--line); border-radius: 3px; padding: 2px 6px; font-size: .59rem; line-height: 1.5; }
  .resource-labels .type-tag { color: var(--ink); background: var(--cream, #f5f5f5); font-weight: 600; }
  .resource-labels .resource-region { border: 0; }
  .row-link { display: flex; align-items: center; gap: 11px; text-decoration: none; font-size: .72rem; margin-top: 7px; padding: 4px; flex-shrink: 0; }
  .row-link span:first-child { color: var(--muted); }
  .directory-empty { text-align: center; padding: 70px 20px; border: 1px dashed var(--line); border-radius: 8px; color: var(--muted); }
  .directory-empty svg { margin: 0 auto 16px; }
  .directory-empty h3 { color: var(--ink); font-size: 1rem; }
  .directory-empty p { font-size: .82rem; }
  .directory-empty button { margin-top: 12px; border: 1px solid var(--ink); padding: 9px 17px; border-radius: 5px; color: var(--paper, #fff); background: var(--ink); cursor: pointer; font: inherit; font-size: .78rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 960px) { .has-controls .directory-layout { grid-template-columns: 190px minmax(0, 1fr); gap: 24px; }.directory-sidebar { padding-right: 20px; }.resource-row { padding: 20px; gap: 13px; }.row-link span:first-child { display: none; } }
  @media (max-width: 760px) {
    .resource-table-shell { margin-top: 24px; }.directory-topbar { flex-wrap: wrap; gap: 13px; margin-bottom: 22px; }.directory-search { flex-basis: 100%; }.all-collections { margin-left: auto; font-size: .73rem; }
    .has-controls .directory-layout { display: block; }.directory-sidebar { border: 1px solid var(--line); border-radius: 6px; padding: 0; margin-bottom: 22px; }.directory-sidebar summary { display: flex; align-items: center; gap: 9px; cursor: pointer; padding: 13px 16px; font-size: .8rem; font-weight: 600; }.directory-sidebar summary span:last-child { margin-left: auto; }.sidebar-inner { padding: 10px 18px 18px; }.sidebar-top { margin-top: 5px; }.sidebar-top h2 { visibility: hidden; }.filter-group { padding-block: 15px; }.filter-group button { font-size: .8rem; padding-block: 9px; }
    .results-toolbar h2 { font-size: .83rem; gap: 8px; }.directory-sort > span { display: none; }.directory-sort select { max-width: 130px; }.resource-row { padding: 18px 15px; gap: 12px; }.resource-icon { width: 37px; height: 37px; flex-basis: 37px; border-radius: 7px; }.resource-title h3 { font-size: .85rem; }.resource-main p { font-size: .73rem; -webkit-line-clamp: 3; }.row-link { padding: 0; }.resource-labels { gap: 4px; }.resource-labels span { font-size: .57rem; }.resource-title { gap: 6px; }
  }
</style>
