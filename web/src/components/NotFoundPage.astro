---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, type Language } from '../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Language };
const zh = lang === 'zh';
---
<BaseLayout lang={lang} title={zh ? '没有找到这个页面' : 'Page not found'} noindex={true}>
  <main id="main-content" class="page-shell not-found">
    <p class="eyebrow">404 · SkillFlux</p>
    <h1>{zh ? '这个地址没有对应的页面。' : 'There is no page at this address.'}</h1>
    <p>{zh ? '地址可能有误，或这个页面已经下线。可以从黄页目录或指南重新开始。' : 'The address may be wrong, or the page has been retired. Start again from the directory or the guides.'}</p>
    <div><a class="button primary" href={localizePath('/directory/', lang)}>{zh ? '浏览 Skill 黄页' : 'Browse source directory'}</a><a class="button secondary" href={localizePath('/guides/', lang)}>{zh ? '查看指南' : 'Read guides'}</a><a href={localizePath('/', lang)}>{zh ? '返回首页' : 'Back home'}</a></div>
  </main>
</BaseLayout>
<style>
  .not-found { padding-block: 85px 120px; min-height: 55vh; }
  h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: 20ch; line-height: 1.15; }
  p:not(.eyebrow) { max-width: 65ch; color: var(--muted); line-height: 1.8; }
  .not-found > div { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 30px; }
</style>
