---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceTable from './ResourceTable.astro';
import Icon from './Icon.astro';
import { getUseCase, getCollection, getEditorialSites, useCases, collections } from '../lib/editorial';
import { absoluteUrl } from '../lib/content';
import { getGuideBySlug } from '../lib/guides';
import { localizePath, type Language } from '../lib/i18n';
type Props = { kind: 'use-case' | 'collection'; slug: string; lang?: Language };
const { kind, slug, lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
const isCase = kind === 'use-case';
const entry = isCase ? getUseCase(slug) : getCollection(slug);
if (!entry) throw new Error(`Unknown ${kind}: ${slug}`);
const sites = getEditorialSites(entry);
const indexPath = isCase ? '/use-cases/' : '/collections/';
const indexLabel = isCase ? (zh ? '使用场景' : 'Use cases') : (zh ? '精选合集' : 'Collections');
const canonicalPath = localizePath(`/${kind}/${entry.slug}/`, lang);
const related = (isCase ? collections : useCases).filter(candidate => candidate.siteSlugs.some(slug => entry.siteSlugs.includes(slug))).slice(0, 3);
const relatedKind = isCase ? 'collection' : 'use-case';
const relatedGuides = entry.details.relatedGuides.map(slug => {
  const guide = getGuideBySlug(slug);
  if (!guide) throw new Error(`Unknown related guide: ${slug}`);
  return guide;
});
const comparisons = entry.details.comparisons.map(comparison => {
  const site = sites.find(site => site.slug === comparison.siteSlug);
  if (!site) throw new Error(`Comparison source is not in ${entry.slug}: ${comparison.siteSlug}`);
  return { ...comparison, site };
});
const homeLabel = zh ? '首页' : 'Home';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: entry.title[lang], description: entry.summary[lang], url: absoluteUrl(canonicalPath), dateModified: entry.updatedAt, inLanguage: zh ? 'zh-CN' : 'en', mainEntity: { '@type': 'ItemList', numberOfItems: sites.length, itemListElement: sites.map((site, index) => ({ '@type': 'ListItem', position: index + 1, name: site.name, url: absoluteUrl(localizePath(`/resource/${site.resourceSlug}/`, lang)) })) } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: absoluteUrl(localizePath('/', lang)) },
    { '@type': 'ListItem', position: 2, name: indexLabel, item: absoluteUrl(localizePath(indexPath, lang)) },
    { '@type': 'ListItem', position: 3, name: entry.title[lang], item: absoluteUrl(canonicalPath) },
  ] },
];
---
<BaseLayout lang={lang} title={entry.title[lang]} description={entry.summary[lang]} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <main id="main-content" class="page-shell editorial-detail">
    <nav class="editorial-breadcrumb" aria-label={zh ? '面包屑导航' : 'Breadcrumb'}><a href={localizePath('/', lang)}>{homeLabel}</a><span aria-hidden="true">/</span><a href={localizePath(indexPath, lang)}>{indexLabel}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.title[lang]}</span></nav>
    <header><span class="detail-icon"><Icon name={entry.icon} size={28} /></span><p class="eyebrow">{isCase ? 'CHOOSE BY TASK' : 'CURATED COLLECTION'}</p><h1>{entry.title[lang]}</h1><p class="detail-intro">{entry.summary[lang]}</p><div class="detail-meta"><span>{sites.length} {zh ? '个相关来源' : 'related sources'}</span><span>{zh ? 'SkillFlux 编辑整理' : 'Curated by SkillFlux'}</span></div></header>
    <section class="editorial-copy" aria-labelledby="overview-title"><h2 id="overview-title">{isCase ? (zh ? '理解任务与选择范围' : 'Understand the task and options') : (zh ? '这份合集解决什么问题' : 'What this collection is for')}</h2>{entry.details.overview.map(paragraph => <p>{paragraph[lang]}</p>)}</section>
    <section class="selection-guide" aria-labelledby="selection-title"><div><h2>{zh ? '适合谁' : 'Who this is for'}</h2><p>{entry.details.audience[lang]}</p></div><div><h2 id="selection-title">{isCase ? (zh ? '如何选择' : 'How to choose') : (zh ? '入选理由与选择方法' : 'Selection rationale and how to choose')}</h2><p>{entry.details.selection[lang]}</p></div></section>
    {'steps' in entry && <section class="workflow" aria-labelledby="workflow-title"><div><p class="eyebrow">A PRACTICAL START</p><h2 id="workflow-title">{zh ? '从这三步开始' : 'A practical way to start'}</h2></div><ol>{entry.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step[lang]}</p></li>)}</ol></section>}
    <div class="source-boundary"><Icon name="compass" size={18} /><p>{zh ? '下面是相关来源与发现入口。点击查看原始资料、来源信息和适用背景；收录不代表 SkillFlux 已审核或支持直接安装。' : 'These are relevant sources and discovery entry points. Open each for original links and context; inclusion does not imply SkillFlux approval or direct installation support.'}</p></div>
    <section class="source-comparison" aria-labelledby="comparison-title"><h2 id="comparison-title">{zh ? '来源差异与选择依据' : 'Compare sources and their roles'}</h2><div class="comparison-scroll"><table><thead><tr><th scope="col">{zh ? '来源' : 'Source'}</th><th scope="col">{zh ? '在本主题中的用途' : 'Role in this shortlist'}</th><th scope="col">{zh ? '选择时需要考虑' : 'What to consider'}</th></tr></thead><tbody>{comparisons.map(comparison => <tr><th scope="row"><a href={localizePath(`/resource/${comparison.site.resourceSlug}/`, lang)}>{comparison.site.name}</a></th><td>{comparison.role[lang]}</td><td>{comparison.tradeoff[lang]}</td></tr>)}</tbody></table></div></section>
    <ResourceTable sites={sites} heading={zh ? '这份清单里的来源' : 'Sources in this shortlist'} lang={lang} />
    <section class="continue-exploring"><div class="related-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>{isCase ? (zh ? '相关精选合集' : 'Related collections') : (zh ? '继续按场景探索' : 'Explore related use cases')}</h2></div><a href={localizePath(isCase ? '/collections/' : '/use-cases/', lang)}>{zh ? '查看全部' : 'View all'} <Icon size={15} /></a></div><div class="related-grid">{related.map(item => <a href={localizePath(`/${relatedKind}/${item.slug}/`, lang)}><Icon name={item.icon} size={20} /><h3>{item.title[lang]}</h3><p>{item.summary[lang]}</p><span>{getEditorialSites(item).length} {zh ? '个来源' : 'sources'} <Icon name="arrow" size={15} /></span></a>)}</div></section>
    <section class="related-guides" aria-labelledby="guides-title"><h2 id="guides-title">{zh ? '相关指南' : 'Related guides'}</h2><ul>{relatedGuides.map(guide => <li><a href={localizePath(`/guides/${guide.slug}/`, lang)}>{guide.title[lang]}</a><p>{guide.description[lang]}</p></li>)}</ul></section>
    <aside class="install-note"><div><h2>{zh ? '准备在项目里使用？' : 'Ready to use skills in your project?'}</h2><p>{zh ? '查看精品 Registry 中实际发布的审核版本，或阅读 SkillFlux 本地接入步骤。' : 'Check published, reviewed releases in the curated Registry, or read the local SkillFlux setup guide.'}</p></div><a href={localizePath('/registry/', lang)}>{zh ? '查看精品 Skill' : 'Explore curated skills'} <Icon size={15} /></a><a href={localizePath('/install/', lang)}>{zh ? '接入指南' : 'Setup guide'} <Icon size={15} /></a></aside>
  </main>
</BaseLayout>
<style>
  .editorial-detail { padding-top: 30px; padding-bottom: 70px; }.editorial-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; font-size: .72rem; color: var(--muted); margin-bottom: 43px; }.editorial-breadcrumb a { text-decoration: none; }.editorial-breadcrumb > span:last-child { color: var(--ink); }
  header { max-width: 820px; margin-bottom: 42px; }.detail-icon { display: grid; place-items: center; width: 57px; height: 57px; border: 1px solid var(--line); border-radius: 11px; margin-bottom: 23px; }
  .eyebrow { margin: 0 0 12px; font-size: .65rem; letter-spacing: .1em; color: var(--muted); }h1 { margin: 0 0 18px; font-size: clamp(2rem, 4.2vw, 3.2rem); line-height: 1.2; letter-spacing: -.045em; }.detail-intro { font-size: .9rem; line-height: 1.9; color: var(--muted); margin: 0; }.detail-meta { display: flex; gap: 20px; margin-top: 22px; color: var(--muted); font-size: .71rem; }.detail-meta span + span { padding-left: 20px; border-left: 1px solid var(--line); }
  .workflow { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 40px; padding: 28px 30px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 28px; background: var(--cream, #f7f7f7); }.workflow h2 { margin: 0; font-size: 1.1rem; line-height: 1.5; }.workflow ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 25px; }.workflow li > span { font-size: .67rem; font-family: monospace; color: var(--muted); }.workflow li p { font-size: .75rem; line-height: 1.8; margin: 10px 0 0; }
  .source-boundary { display: flex; align-items: flex-start; gap: 11px; color: var(--muted); max-width: 1000px; }.source-boundary svg { flex-shrink: 0; margin-top: 4px; }.source-boundary p { font-size: .74rem; line-height: 1.8; margin: 0; }
  .editorial-copy { max-width: 850px; margin: 0 0 34px; }.editorial-copy h2, .selection-guide h2, .source-comparison h2, .related-guides h2 { font-size: 1.15rem; margin: 0 0 16px; }.editorial-copy p { font-size: .86rem; line-height: 1.95; margin: 0 0 17px; color: var(--muted); }.selection-guide { display: grid; grid-template-columns: 1fr 2fr; gap: 36px; border-top: 1px solid var(--line); padding-top: 28px; margin-bottom: 34px; }.selection-guide p { font-size: .8rem; line-height: 1.85; margin: 0; color: var(--muted); }.source-comparison { margin-top: 30px; }.comparison-scroll { overflow-x: auto; }.source-comparison table { border-collapse: collapse; width: 100%; min-width: 560px; text-align: left; }.source-comparison th, .source-comparison td { border-bottom: 1px solid var(--line); padding: 16px 18px 16px 0; font-size: .77rem; line-height: 1.8; vertical-align: top; }.source-comparison thead th { font-size: .7rem; color: var(--muted); }.source-comparison tbody th { width: 25%; font-weight: 500; }.source-comparison td { width: 37.5%; color: var(--muted); }.source-comparison a { text-underline-offset: 4px; }.related-guides { margin-top: 38px; border-top: 1px solid var(--line); padding-top: 28px; }.related-guides ul { padding-left: 20px; }.related-guides li { margin: 0 0 16px; font-size: .83rem; line-height: 1.8; }.related-guides p { margin: 4px 0 0; font-size: .76rem; color: var(--muted); }
  .continue-exploring { margin-top: 50px; }.related-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 25px; margin-bottom: 22px; }.related-heading h2 { font-size: 1.3rem; margin: 0; }.related-heading > a { display: flex; gap: 10px; text-decoration: none; font-size: .72rem; white-space: nowrap; }.related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }.related-grid > a { border: 1px solid var(--line); border-radius: 7px; padding: 24px; text-decoration: none; display: flex; flex-direction: column; }.related-grid > a:hover { border-color: #888; }.related-grid h3 { margin: 17px 0 10px; font-size: .94rem; }.related-grid p { color: var(--muted); font-size: .76rem; line-height: 1.8; margin: 0 0 20px; }.related-grid a > span { display: flex; justify-content: space-between; font-size: .68rem; margin-top: auto; }
  .install-note { display: flex; align-items: center; gap: 25px; border-top: 1px solid var(--line); padding-top: 30px; margin-top: 45px; }.install-note > div { flex: 1; }.install-note h2 { font-size: 1rem; margin: 0 0 10px; }.install-note p { font-size: .76rem; line-height: 1.8; color: var(--muted); margin: 0; }.install-note a { display: flex; gap: 10px; align-items: center; font-size: .73rem; text-decoration: none; white-space: nowrap; }
  @media (max-width: 960px) { .workflow { grid-template-columns: 1fr; gap: 20px; }.related-grid { gap: 12px; }.related-grid > a { padding: 20px; }.install-note { flex-wrap: wrap; }.install-note > div { flex-basis: 100%; } }
  @media (max-width: 600px) { .editorial-breadcrumb { margin-bottom: 30px; }header { margin-bottom: 30px; }.detail-intro { font-size: .84rem; }.selection-guide { grid-template-columns: 1fr; gap: 25px; }.workflow { padding: 23px; }.workflow ol { grid-template-columns: 1fr; gap: 18px; }.workflow li { display: flex; gap: 15px; align-items: baseline; }.workflow li p { margin: 0; }.related-grid { grid-template-columns: 1fr; }.related-heading h2 { font-size: 1.1rem; }.related-grid > a { padding: 23px; }.detail-meta { gap: 12px; font-size: .66rem; }.detail-meta span + span { padding-left: 12px; } }
</style>
