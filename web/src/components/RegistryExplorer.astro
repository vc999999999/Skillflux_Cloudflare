---
import { getPublication, skillPath } from '../lib/publication';
import { localizePath, type Language } from '../lib/i18n';
import { PUBLICATION_PAGE_SIZE, readPublicationFilters, registryPageCount, registryPagePath, searchPublication } from '../lib/publication-search';
const { lang = 'zh', mode = 'full', page = 1 } = Astro.props as { lang?: Language; mode?: 'full' | 'preview'; page?: number };
const zh = lang === 'zh';
const publication = getPublication();
const sourceSkills = publication.latest.map(item => item.skill);
const skills = mode === 'preview' ? sourceSkills : searchPublication(sourceSkills, readPublicationFilters(new URLSearchParams()));
const shown = mode === 'preview' ? skills.slice(0, 3) : skills;
const pages = registryPageCount(skills.length);
const visibleIds = new Set((mode === 'preview' ? shown : skills.slice((page - 1) * PUBLICATION_PAGE_SIZE, page * PUBLICATION_PAGE_SIZE)).map(skill => skill.id));
const categories = [...new Set(skills.map(skill => skill.category))].sort();
---
<section class="published-explorer" data-publication-explorer={mode === 'full' ? 'true' : undefined} data-lang={lang}>
  <p class="publication-time">{publication.snapshot.fetchedAt
    ? `${zh ? '目录同步于' : 'Snapshot synchronized'} ${publication.snapshot.fetchedAt.replace('T', ' ').replace(/\.\d+Z$/, ' UTC')}`
    : zh ? '尚未导入人工实测通过的云端发布快照。' : 'No human-tested registry publication has been synchronized yet.'}</p>
  {mode === 'full' && <form class="publication-filters" data-skill-filters role="search">
    <label>{zh ? '关键词' : 'Keywords'}<input type="search" name="q" maxlength="200" placeholder={zh ? '输入用途、名称或标签' : 'Purpose, name or tag'} /></label>
    <label>{zh ? '能力分类' : 'Category'}<select name="category"><option value="">{zh ? '全部分类' : 'All categories'}</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label>
    <label>{zh ? '宿主' : 'Host'}<select name="host"><option value="">{zh ? '全部宿主' : 'All hosts'}</option>{['codex', 'claude', 'cursor', 'generic'].map(host => <option value={host}>{host}</option>)}</select></label>
    <label>{zh ? '排序' : 'Sort'}<select name="sort"><option value="relevance">{zh ? '相关度' : 'Relevance'}</option><option value="newest">{zh ? '最近发布' : 'Newest'}</option><option value="name">{zh ? '名称' : 'Name'}</option></select></label>
    <button class="button primary" type="submit">{zh ? '搜索' : 'Search'}</button><button class="button secondary" type="reset">{zh ? '清空' : 'Clear'}</button>
  </form>}
  <p data-skill-count aria-live="polite">{shown.length} {zh ? '个精品 Skill' : 'curated skills'}</p>
  <div class="publication-results" data-skill-results>
    {shown.map(skill => <article class="published-skill" data-skill-id={skill.id} hidden={!visibleIds.has(skill.id)}>
      <div><span class="quality-stamp">{zh ? '安全检查＋人工实测' : 'Safety checked · usage tested'}</span><code>{skill.version}</code></div>
      <h3><a href={localizePath(skillPath(skill.id), lang)}>{skill.name}</a></h3>
      <p>{skill.description}</p>
      <p class="published-meta">{skill.category} · {skill.hosts.join(' / ')} · {skill.publisher}</p>
      <div class="published-links"><a href={localizePath(skillPath(skill.id, skill.version), lang)}>{zh ? '查看该版本与质检证据' : 'View release & evidence'} →</a><button type="button" data-copy-text={`skillflux install ${skill.id}@${skill.version}`}>{zh ? '复制安装命令' : 'Copy install command'}</button></div>
    </article>)}
  </div>
  <div class="publication-empty" data-skill-empty hidden={shown.length > 0}>
    <h3>{skills.length ? (zh ? '没有匹配的 Skill' : 'No matching skills') : (zh ? '精品目录暂未发布内容' : 'No curated releases published')}</h3>
    <p>{skills.length ? (zh ? '换一个关键词，或清空筛选条件。' : 'Try another keyword or clear the filters.') : (zh ? '只有完成自动检查和真实人工测试的版本才会在这里出现。来源黄页可以继续浏览；开发示例不会被当作精品填入。' : 'Only safety-checked releases with human test records appear here. The source directory remains available. Development fixtures are never listed as curated releases.')}</p>
    <a href={localizePath('/directory/', lang)}>{zh ? '浏览来源黄页' : 'Browse the source directory'}</a>
  </div>
  {mode === 'full' && <nav class="publication-pagination" aria-label={zh ? '搜索分页' : 'Result pages'} data-skill-pagination hidden={pages <= 1}>
    <a href={registryPagePath(Math.max(1, page - 1), lang)} data-skill-prev rel="prev" hidden={page === 1}>{zh ? '上一页' : 'Previous'}</a>
    <span data-skill-page>{page} / {pages}</span>
    <a href={registryPagePath(Math.min(pages, page + 1), lang)} data-skill-next rel="next" hidden={page === pages}>{zh ? '下一页' : 'Next'}</a>
  </nav>}
  {mode === 'full' && <script type="application/json" is:inline data-publication-search set:html={JSON.stringify(skills).replace(/</g, '\\u003c')} />}
  <noscript><p>{zh ? 'JavaScript 未开启：可读取本页条目，并使用上一页、下一页浏览其他公开条目。交互式筛选需要启用 JavaScript。' : 'JavaScript is off: this page and its detail links remain readable. Use Previous and Next to browse other releases. Enable JavaScript for interactive filtering.'}</p></noscript>
</section>
<script>
  import { PUBLICATION_PAGE_SIZE, hasPublicationFilters, readPublicationFilters, readPublicationUrl, registryPageCount, registryPagePath, searchPublication, writePublicationFilters, type SearchableSkill } from '../lib/publication-search';
  import { updateClientRobots } from '../lib/indexing';
  document.querySelectorAll<HTMLElement>('[data-publication-explorer="true"]').forEach(root => {
    const form = root.querySelector<HTMLFormElement>('[data-skill-filters]')!;
    const results = root.querySelector<HTMLElement>('[data-skill-results]')!;
    const all = JSON.parse(root.querySelector('[data-publication-search]')!.textContent ?? '[]') as SearchableSkill[];
    const nodes = new Map([...results.querySelectorAll<HTMLElement>('[data-skill-id]')].map(node => [node.dataset.skillId!, node]));
    const zh = root.dataset.lang === 'zh';
    let state = readPublicationUrl(new URL(location.href));
    const control = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
    const render = (recordHistory = false) => {
      const matches = searchPublication(all, state);
      const pages = registryPageCount(matches.length);
      state.page = Math.min(state.page, pages);
      for (const node of nodes.values()) node.hidden = true;
      for (const skill of matches.slice((state.page - 1) * PUBLICATION_PAGE_SIZE, state.page * PUBLICATION_PAGE_SIZE)) { const node = nodes.get(skill.id)!; node.hidden = false; results.append(node); }
      root.querySelector('[data-skill-count]')!.textContent = `${matches.length} ${zh ? '个精品 Skill' : 'curated skills'}`;
      (root.querySelector('[data-skill-empty]') as HTMLElement).hidden = matches.length > 0;
      (root.querySelector('[data-skill-pagination]') as HTMLElement).hidden = pages <= 1;
      const previous = root.querySelector<HTMLAnchorElement>('[data-skill-prev]')!;
      const next = root.querySelector<HTMLAnchorElement>('[data-skill-next]')!;
      previous.hidden = state.page === 1;
      next.hidden = state.page === pages;
      previous.href = writePublicationFilters(new URL(location.href), { ...state, page: Math.max(1, state.page - 1) }).href;
      next.href = writePublicationFilters(new URL(location.href), { ...state, page: Math.min(pages, state.page + 1) }).href;
      root.querySelector('[data-skill-page]')!.textContent = `${state.page} / ${pages}`;
      for (const key of ['q', 'category', 'host', 'sort'] as const) control(key).value = state[key];
      const target = writePublicationFilters(new URL(location.href), state);
      if (recordHistory) history.pushState(null, '', target); else history.replaceState(null, '', target);
      updateClientRobots();
      const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
      if (canonical) canonical.href = new URL(registryPagePath(hasPublicationFilters(state) ? 1 : state.page, zh ? 'zh' : 'en'), canonical.href).href;
      document.dispatchEvent(new Event('skillflux:filters'));
    };
    const submit = () => {
      state = readPublicationFilters(new URLSearchParams(new FormData(form) as unknown as Record<string, string>));
      if (!hasPublicationFilters(state)) { location.assign(writePublicationFilters(new URL(location.href), state).href); return; }
      render(true);
    };
    form.addEventListener('submit', event => { event.preventDefault(); submit(); });
    form.querySelectorAll('select').forEach(select => select.addEventListener('change', submit));
    form.addEventListener('reset', event => { event.preventDefault(); location.assign(writePublicationFilters(new URL(location.href), readPublicationFilters(new URLSearchParams())).href); });
    const paginate = (event: MouseEvent, direction: number) => {
      // Ordinary pages use real navigation. Only filtered results need client pagination.
      if (!hasPublicationFilters(state) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); state.page += direction; render(true);
    };
    root.querySelector<HTMLAnchorElement>('[data-skill-prev]')!.addEventListener('click', event => paginate(event, -1));
    root.querySelector<HTMLAnchorElement>('[data-skill-next]')!.addEventListener('click', event => paginate(event, 1));
    window.addEventListener('popstate', () => { state = readPublicationUrl(new URL(location.href)); render(); });
    render();
  });
</script>
<style>
  .publication-time { color: var(--faint); font: 500 .82rem var(--font-mono); line-height: 1.7; overflow-wrap: anywhere; margin-bottom: 20px; }
  .publication-filters { display: grid; grid-template-columns: minmax(180px, 2fr) repeat(3, minmax(100px, 1fr)) auto auto; gap: 14px; padding: 24px 0; align-items: end; }
  .publication-filters label { display: grid; gap: 8px; font-size: .84rem; font-weight: 600; color: var(--ink); }
  .publication-filters input, .publication-filters select { width: 100%; min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper-strong); color: var(--ink); box-shadow: var(--shadow-sm); font-size: .88rem; transition: border-color .15s ease, box-shadow .15s ease; }
  .publication-filters input:focus, .publication-filters select:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(23, 21, 15, 0.08); }
  .publication-filters button { cursor: pointer; min-height: 44px; }
  .publication-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 16px; }
  .published-skill { padding: 26px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); min-width: 0; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .published-skill:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); border-color: rgba(23, 21, 15, 0.28); }
  .published-skill > div:first-child { display: flex; gap: 10px; justify-content: space-between; font-size: .8rem; flex-wrap: wrap; }
  .quality-stamp { color: var(--green); font-weight: 600; font-size: .78rem; background: var(--green-subtle); padding: 3px 8px; border-radius: var(--radius-sm); }
  .published-skill h3 { font-size: 1.35rem; margin: 18px 0 10px; font-weight: 650; letter-spacing: -.025em; }
  .published-skill h3 a { text-decoration: none; color: var(--ink); }
  .published-skill h3 a:hover { color: var(--accent); }
  .published-skill p { line-height: 1.75; overflow-wrap: anywhere; color: var(--muted); font-size: .88rem; margin: 0 0 14px; }
  .published-meta { color: var(--faint); font: 500 .78rem var(--font-mono); }
  .published-links { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; font-size: .84rem; padding-top: 16px; border-top: 1px solid var(--line); }
  .published-links a { font-weight: 600; text-decoration: none; color: var(--ink); }
  .published-links a:hover { color: var(--accent); }
  .published-links button, .publication-pagination a { padding: 8px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper); cursor: pointer; color: var(--ink); font-weight: 500; font-size: .8rem; transition: all .15s ease; }
  .published-links button:hover, .publication-pagination a:hover { border-color: var(--line-strong); background: var(--cream); }
  .published-skill[hidden], .publication-pagination[hidden], .publication-pagination a[hidden] { display: none; }
  .publication-empty { padding: 36px; border: 1px dashed var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); }
  .publication-empty h3 { margin: 0 0 10px; font-size: 1.1rem; color: var(--ink); }
  .publication-empty p { max-width: 65ch; color: var(--muted); line-height: 1.8; font-size: .9rem; margin-bottom: 16px; }
  .publication-empty a { font-weight: 600; text-decoration: none; color: var(--ink); }
  .publication-pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin: 32px 0; }
  @media (max-width: 960px) { .publication-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .publication-results { grid-template-columns: 1fr; } .publication-filters label:first-child { grid-column: 1 / -1; } .published-skill { padding: 20px; } }
</style>
