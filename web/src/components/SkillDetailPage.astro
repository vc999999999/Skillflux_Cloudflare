---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../lib/content';
import { getPublication, skillPath } from '../lib/publication';
import { compareSkillVersions } from '../lib/publication-search';
import { localizePath, type Language } from '../lib/i18n';
const { id, version, lang = 'zh' } = Astro.props as { id: string; version?: string; lang?: Language };
const zh = lang === 'zh';
const publication = getPublication();
const versions = publication.items.filter(item => item.skill.id === id).sort((a, b) => compareSkillVersions(b.skill.version, a.skill.version));
const record = version ? versions.find(item => item.skill.version === version) : versions[0];
const statuses = publication.statuses.filter(item => item.id === id).sort((a, b) => compareSkillVersions(b.version, a.version));
const status = version ? statuses.find(item => item.version === version) : statuses[0];
const skill = record?.skill;
const name = skill?.name ?? status?.name ?? id;
const title = `${name} (${id}${version ? `@${version}` : ''})`;
const selectedVersion = skill?.version ?? status?.version ?? version ?? '';
const canonicalPath = localizePath(skillPath(id, version), lang);
const summary = skill?.description ?? (zh ? '此版本当前不可安装。查看发布状态和其他可用版本。' : 'This release is not installable. Check its status and other available releases.');
const availableVersions = new Map([...statuses.map(item => [item.version, item] as const), ...versions.map(item => [item.skill.version, { ...item.skill, qualification: 'qualified' as const }] as const)]);
const evidence = skill?.quality.evaluation;
---
<BaseLayout lang={lang} title={title} description={summary} canonicalPath={canonicalPath} jsonLd={{ '@context': 'https://schema.org', '@type': 'TechArticle', headline: name, description: summary, url: absoluteUrl(canonicalPath), ...(skill ? { dateModified: skill.release?.maintainedAt ?? skill.createdAt } : {}) }}>
  <main id="main-content" class="page-shell skill-detail">
    <nav aria-label={zh ? '面包屑' : 'Breadcrumb'} class="detail-breadcrumb"><a href={localizePath('/registry/', lang)}>{zh ? '精品 Skill' : 'Curated skills'}</a> / {name}</nav>
    <header class="skill-heading"><div><p class="eyebrow">{id}</p><h1>{name}</h1><p class="page-lede">{summary}</p></div><aside><code>{selectedVersion}</code><span>{skill ? (zh ? '人工实测通过' : 'Usage tested') : status?.qualification === 'revoked' ? (zh ? '已撤销' : 'Revoked') : (zh ? '待补实测 / 不可安装' : 'Needs testing / unavailable')}</span></aside></header>
    <p class="snapshot-notice">{zh ? '静态发布快照：' : 'Static publication snapshot: '}{publication.snapshot.fetchedAt ?? '—'}。{zh ? '实际安装或加载前，本地客户端仍会核验最新资格与撤销状态。' : 'The local client rechecks live eligibility and revocations before installing or loading.'}</p>
    {lang === 'en' && <p class="section-note">Skill text and operator summaries are preserved in their original language; interface translation does not change the release.</p>}
    {!skill && status?.reason && <p class="content-disclosure">{zh ? '公开状态说明：' : 'Public status note: '}{status.reason}</p>}
    <nav class="version-links" aria-label={zh ? '版本历史' : 'Release history'}><strong>{zh ? '版本历史' : 'Releases'}</strong>{[...availableVersions.keys()].sort((a, b) => compareSkillVersions(b, a)).map(item => <a href={localizePath(skillPath(id, item), lang)} aria-current={item === selectedVersion ? 'page' : undefined}>{item}{availableVersions.get(item)?.qualification !== 'qualified' ? ' ×' : ''}</a>)}<a href={localizePath(skillPath(id), lang)}>{zh ? '当前合格版本' : 'Current qualified release'}</a></nav>
    {skill && record ? <>
      <section class="skill-install"><div><h2>{zh ? '在当前项目安装这个版本' : 'Install this release in your project'}</h2><p>{zh ? '先完成 SkillFlux 初始化。复制命令不会安装或修改本地文件。' : 'Initialize SkillFlux first. Copying this command does not install or change local files.'}</p><code>{`skillflux install ${id}@${skill.version}`}</code></div><div><button class="button primary" type="button" data-copy-text={`skillflux install ${id}@${skill.version}`}>{zh ? '复制安装命令' : 'Copy install command'}</button><a href={localizePath('/install/', lang)}>{zh ? '首次接入？查看完整步骤' : 'First time? Read setup steps'} →</a></div></section>
      <dl class="skill-facts"><div><dt>{zh ? '维护者' : 'Maintainer'}</dt><dd>{skill.release?.maintainedBy ?? skill.publisher}</dd></div><div><dt>{zh ? '宿主' : 'Hosts'}</dt><dd>{skill.hosts.join(' / ')}</dd></div><div><dt>{zh ? '许可证' : 'License'}</dt><dd>{skill.license}</dd></div><div><dt>{zh ? '最低客户端' : 'Minimum client'}</dt><dd>{skill.release?.minClientVersion ?? '—'}</dd></div><div><dt>{zh ? '维护时间' : 'Maintained'}</dt><dd>{skill.release?.maintainedAt ?? skill.createdAt}</dd></div><div><dt>{zh ? '分类与标签' : 'Category & tags'}</dt><dd>{[skill.category, ...skill.tags].join(' · ')}</dd></div></dl>
      <section class="detail-section"><h2>{zh ? '版本变更与适用边界' : 'Release changes and limits'}</h2><p class="pre-line">{skill.release?.notes ?? (zh ? '此历史版本没有变更说明。' : 'No release notes were recorded for this historical version.')}</p>{skill.release?.breaking && <p class="risk-note">{zh ? '包含破坏性变更。先阅读说明并确认项目兼容，再选择更新。' : 'Contains breaking changes. Review compatibility before updating.'}</p>}<a href={localizePath('/scenarios/maintain-project-skills/', lang)}>{zh ? '如何检查更新并固定项目版本' : 'How to check updates and pin project versions'} →</a></section>
      <section class="detail-section"><h2>{zh ? '质检证据' : 'Quality evidence'}</h2><div class="evidence-grid"><div><h3>{zh ? '自动安全检查' : 'Automated safety checks'}</h3><p>{skill.quality.automated.checkedAt}</p><ul>{skill.quality.automated.checks.map(check => <li>{check}</li>)}</ul></div><div><h3>{zh ? '人工实测公开摘要' : 'Public usage-test summary'}</h3><p class="pre-line">{evidence?.summary ?? (zh ? '没有可公开的实测摘要。' : 'No public test summary is available.')}</p><p>{zh ? '测试时间' : 'Tested'}：{evidence?.testedAt ?? '—'}</p><p>{zh ? '安装与读取验证' : 'Installation and reading checked'}：{evidence?.hosts.join(' / ') ?? '—'}</p><p>{zh ? '主要用途与边界案例均通过；完整原始测试材料仅供授权运营者查看。' : 'Purpose and boundary cases passed. Raw test materials remain operator-only.'}</p></div></div></section>
      <section class="detail-section"><h2>{zh ? '权限与固定依赖' : 'Permissions and exact dependencies'}</h2><p>{zh ? '仅文本资源；不授予执行脚本、网络访问或读取密钥的权限。' : 'Text resources only; no shell, network or secret access is granted.'}</p>{skill.dependencies.length ? <ul>{skill.dependencies.map(dependency => <li><a href={localizePath(skillPath(dependency.id, dependency.version), lang)}>{dependency.id}@{dependency.version}</a></li>)}</ul> : <p>{zh ? '没有依赖包。' : 'No dependencies.'}</p>}<p class="digest">SHA-256: {skill.digest}</p></section>
      <section class="detail-section"><h2>{zh ? '完整文本资源' : 'Complete text resources'}</h2><p>{zh ? '以下是该签名版本的原始文本，不会在网页中执行。' : 'Original text from this signed release. Nothing is executed in the browser.'}</p>{Object.entries(record.bundle.files).sort(([a], [b]) => a === skill.entry ? -1 : b === skill.entry ? 1 : a.localeCompare(b)).map(([path, content]) => <details class="skill-file" open={path === skill.entry}><summary>{path}{path === skill.entry ? (zh ? ' · 主入口' : ' · entry') : ''}</summary><pre><code>{content}</code></pre></details>)}</section>
    </> : <section class="publication-unavailable"><h2>{zh ? '此版本不提供安装和文本下载' : 'This release cannot be installed or downloaded'}</h2><p>{status?.qualification === 'revoked' ? (zh ? '该版本已经被撤销，或其固定依赖已失效。已下载的文件不会被网站远程删除，但运行时会在检查后阻止继续加载。' : 'The release or an exact dependency was revoked. The website cannot delete downloaded files, but the runtime blocks activation after checking.') : (zh ? '此版本尚未满足当前安全与人工实测发布条件。它不会被自动替换为其他版本。' : 'This release does not satisfy current safety and usage-test requirements. It is never silently replaced with another version.')}</p>{versions.length > 0 && <a href={localizePath(skillPath(id), lang)}>{zh ? '查看其他合格版本' : 'View another qualified release'} →</a>}</section>}
  </main>
</BaseLayout>
<style>
  .skill-detail { padding-bottom: 80px; }
  .detail-breadcrumb { margin: 30px 0; color: var(--muted); font-size: .85rem; }
  .skill-heading { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: start; }
  .skill-heading h1 { font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 1.12; margin: 20px 0; overflow-wrap: anywhere; }
  .skill-heading aside { display: grid; gap: 14px; border-top: 2px solid var(--accent); padding-top: 18px; font-size: .9rem; }
  .snapshot-notice { border-block: 1px solid var(--line); padding: 15px 0; color: var(--muted); font-size: .8rem; line-height: 1.8; }
  .version-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 25px 0; font-size: .85rem; }
  .version-links a { border: 1px solid var(--line); padding: 8px; }
  .version-links a[aria-current] { background: var(--ink); color: var(--paper); }
  .skill-install { padding: 24px; display: grid; grid-template-columns: 1fr auto; gap: 24px; background: var(--cream); }
  .skill-install h2 { margin-top: 0; font-size: 1.3rem; }
  .skill-install > div:last-child { display: grid; gap: 12px; align-content: center; font-size: .8rem; }
  .skill-install code { overflow-wrap: anywhere; }
  .skill-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin: 35px 0; }
  .skill-facts dt { color: var(--muted); margin-bottom: 8px; font-size: .8rem; }
  .skill-facts dd { margin: 0; overflow-wrap: anywhere; }
  .detail-section { border-top: 1px solid var(--line); padding-top: 25px; margin-top: 35px; line-height: 1.8; }
  .detail-section h2 { font-size: 1.6rem; }
  .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; }
  .pre-line { white-space: pre-line; }
  .risk-note { border-left: 3px solid var(--accent); padding-left: 15px; }
  .digest { overflow-wrap: anywhere; font: .8rem/1.7 var(--font-mono); color: var(--muted); }
  .skill-file { margin: 14px 0; border: 1px solid var(--line); background: var(--paper-strong); }
  .skill-file summary { cursor: pointer; padding: 14px; font: .85rem/1.7 var(--font-mono); overflow-wrap: anywhere; }
  .skill-file pre { margin: 0; padding: 20px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 620px; font: .82rem/1.8 var(--font-mono); border-top: 1px solid var(--line); }
  .publication-unavailable { border: 1px solid var(--accent); padding: 25px; line-height: 1.8; }
  @media (max-width: 760px) { .skill-heading, .skill-install, .evidence-grid { grid-template-columns: 1fr; } .skill-facts { grid-template-columns: 1fr 1fr; } }
</style>
