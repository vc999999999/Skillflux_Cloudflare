---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizePath, type Language } from "../lib/i18n";
import RegistryExplorer from "./RegistryExplorer.astro";
import { getPublication } from '../lib/publication';
import { registryPageCount, registryPagePath } from '../lib/publication-search';

type Props = { lang?: Language; page?: number };
const { lang = "zh", page = 1 } = Astro.props;
const isZh = lang === "zh";
const total = getPublication().latest.length;
const hasReleases = total > 0;
const pageCount = registryPageCount(total);
if (!Number.isSafeInteger(page) || page < 1 || page > pageCount) throw new Error(`Invalid registry page: ${page}`);
const canonicalPath = registryPagePath(page, lang);
const title = isZh ? `精品 Skill Registry${page > 1 ? ` — 第 ${page} 页` : ''}` : `Curated Skill Registry${page > 1 ? ` — Page ${page}` : ''}`;
const description = isZh
  ? `${page > 1 ? `第 ${page} 页，共 ${pageCount} 页。` : ''}查看 Registry 的当前发布状态、审核标准，以及经过安全检查和人工实测的具体 Skill 版本。`
  : `${page > 1 ? `Page ${page} of ${pageCount}. ` : ''}See the Registry's publication status, review criteria, and skill releases that passed safety checks and hands-on testing.`;
---

<BaseLayout
  lang={lang}
  canonicalPath={canonicalPath}
  title={title}
  description={description}
  noindex={total === 0}
  pageClass="registry-page"
>
  <main id="main-content" class="registry-page-shell">
    <section class="registry-page-hero" aria-labelledby="registry-title">
      <div class="registry-hero-copy">
        <p class="eyebrow"><span></span> SKILLFLUX / REGISTRY</p>
        <h1 id="registry-title">{page > 1 ? (isZh ? `精品 Skill · 第 ${page} 页` : `Curated skills · page ${page}`) : hasReleases ? (isZh ? <>先看证据，<br /><em>再安装 Skill。</em></> : <>See the evidence.<br /> <em>Then install.</em></>) : (isZh ? <>好用的 Skill，<br /><em>要经得起实测。</em></> : <>Useful skills need<br /> <em>real-world testing.</em></>)}</h1>
        <p class="registry-hero-lede">{isZh ? (hasReleases ? "这里只发布能追溯具体版本、安全检查与人工使用记录的 Skill。安装前，可先查看证据和权限。" : "这里只发布能追溯具体版本、安全检查与人工使用记录的 Skill。目录仍在建立中；没有通过审核的版本，不会展示安装入口。") : (hasReleases ? "Every entry identifies a version, safety checks and a hands-on test. Review its evidence and permissions before installing." : "Every entry identifies a version, safety checks and a hands-on test. The catalog is being built; releases without approval never get an install link.")}</p>
        <div class="registry-hero-actions"><a class="registry-primary-link" href={localizePath(hasReleases ? '/registry/#releases' : '/directory/', lang)}>{hasReleases ? (isZh ? '浏览已审核版本' : 'Browse reviewed releases') : (isZh ? '先浏览资源目录' : 'Explore the source directory')} ↗</a><a href={localizePath('/quality/', lang)}>{isZh ? '查看审核标准 →' : 'Read review criteria →'}</a></div>
      </div>
      <aside class="registry-status" aria-label={isZh ? 'Registry 当前状态' : 'Registry status'}>
        <div class="registry-status-top"><span>{isZh ? '当前发布状态' : 'PUBLICATION STATUS'}</span><span aria-hidden="true">↗</span></div>
        <div class="registry-status-count"><strong>{String(total).padStart(2, '0')}</strong><span>{isZh ? '个可安装的审核版本' : 'approved installable releases'}</span></div>
        <p>{hasReleases ? (isZh ? '版本详情公开质检记录；安装时客户端再次核验。' : 'Review evidence is public; the client checks again at install time.') : (isZh ? '尚无通过完整审核的版本。这里不会用示例或外部链接充数。' : 'No release has passed the full review yet. Samples and external links do not fill this count.')}</p>
      </aside>
    </section>

    {hasReleases ? <section id="releases" class="registry-releases" aria-label={isZh ? '已发布版本' : 'Published releases'}><div class="registry-section-heading"><span>01 / RELEASES</span><h2>{isZh ? '已发布版本' : 'Published releases'}</h2></div><RegistryExplorer lang={lang} mode="full" page={page} /></section> : <section id="releases" class="registry-empty" aria-labelledby="registry-empty-title"><div class="registry-empty-index">01 / RELEASES <span>— 00</span></div><div class="registry-empty-body"><p class="registry-empty-overline">{isZh ? '目录建立中' : 'BUILDING THE CATALOG'}</p><h2 id="registry-empty-title">{isZh ? '还没有已发布的 Skill。' : 'No releases have been published yet.'}</h2><p>{isZh ? '你现在可以在资源目录发现候选项目，查看原始仓库和使用说明。资源推荐与 Registry 上架是两个流程：推荐不会自动变成可安装版本。' : 'Discover candidates in the source directory and check their original repositories. Recommending a resource is separate from publishing an installable Registry release.'}</p><div class="registry-empty-links"><a href={localizePath('/directory/', lang)}>{isZh ? '去资源目录看看 ↗' : 'Browse the directory ↗'}</a><a href={localizePath('/submit/', lang)}>{isZh ? '推荐一个资源 →' : 'Recommend a resource →'}</a></div></div></section>}

    <section class="registry-process" aria-labelledby="registry-process-title">
      <div class="registry-section-heading"><span>02 / HOW IT WORKS</span><h2 id="registry-process-title">{isZh ? '从候选项目，到可安装版本。' : 'From candidate to installable release.'}</h2></div>
      <div class="registry-process-steps">
        <article><span>01</span><h3>{isZh ? '核对来源与文件' : 'Check source and files'}</h3><p>{isZh ? '确认来源、版本、文件、权限和依赖；自动检查先拦下明显风险。' : 'Verify source, version, files, permissions and dependencies. Automated checks catch obvious risks.'}</p></article>
        <article><span>02</span><h3>{isZh ? '真实使用与记录' : 'Test and record usage'}</h3><p>{isZh ? '在声明支持的宿主中实际使用，记录用途、边界、结果和限制。' : 'Run it in a declared host and record its purpose, outcome and limits.'}</p></article>
        <article><span>03</span><h3>{isZh ? '审核后发布' : 'Approve and publish'}</h3><p>{isZh ? '只有通过审核的具体版本才能进入目录；安装时客户端再次核验。' : 'Only the approved version enters the catalog. The client checks it again when installing.'}</p></article>
      </div>
      <a class="registry-process-link" href={localizePath('/quality/', lang)}>{isZh ? '阅读完整收录与质检标准 ↗' : 'Read the full quality standards ↗'}</a>
    </section>
  </main>
</BaseLayout>

<style>
  .registry-page-shell { width: min(1160px, calc(100% - 48px)); margin: 0 auto; padding-bottom: clamp(76px, 9vw, 128px); }
  .registry-page-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 340px); align-items: end; gap: clamp(36px, 7vw, 100px); padding: clamp(60px, 8vw, 118px) 0 clamp(64px, 8vw, 108px); }
  .registry-page-hero .eyebrow { margin: 0 0 30px; color: var(--muted); font: 600 .75rem/1.4 var(--font-mono); letter-spacing: .08em; }
  .registry-page-hero .eyebrow span { display: inline-block; width: 8px; height: 8px; margin-right: 8px; background: var(--accent); transform: rotate(45deg); }
  .registry-page-hero h1 { margin: 0; font-size: clamp(3.1rem, 6.3vw, 5.6rem); font-weight: 650; line-height: 1.1; letter-spacing: -.055em; text-wrap: balance; }
  .registry-page-hero h1 em { color: var(--accent); font-style: normal; }
  .registry-hero-lede { max-width: 54ch; margin: 30px 0 0; color: var(--muted); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.85; text-wrap: pretty; }
  .registry-hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px 28px; margin-top: 32px; }
  .registry-hero-actions a { display: inline-flex; align-items: center; font-size: .88rem; font-weight: 600; text-decoration: none; transition: background .2s, color .2s, transform .2s; }
  .registry-primary-link { min-height: 48px; padding: 12px 20px; background: var(--ink); color: var(--paper-strong); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .registry-primary-link:hover { background: #2f2c22; transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .registry-primary-link:active { transform: translateY(0); }
  .registry-hero-actions a:not(.registry-primary-link) { border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .registry-hero-actions a:not(.registry-primary-link):hover { color: var(--accent); }
  .registry-status { min-height: 320px; padding: 26px 26px; display: flex; flex-direction: column; justify-content: space-between; background: var(--cream); border: 1px solid var(--line); border-top: 3px solid var(--ink); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .registry-status-top { display: flex; justify-content: space-between; gap: 12px; font: 600 .75rem var(--font-mono); letter-spacing: .06em; color: var(--muted); }
  .registry-status-top span:last-child { color: var(--accent); font-size: 1.1rem; }
  .registry-status-count { display: flex; align-items: baseline; gap: 16px; }
  .registry-status-count strong { font: 500 clamp(5rem, 9vw, 7.5rem)/.9 var(--font-mono); letter-spacing: -.08em; font-variant-numeric: tabular-nums; color: var(--ink); }
  .registry-status-count > span { max-width: 13ch; color: var(--muted); font-size: .84rem; line-height: 1.5; font-weight: 500; }
  .registry-status > p { margin: 0; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; line-height: 1.75; }
  .registry-releases, .registry-empty, .registry-process { border-top: 1px solid var(--line); }
  .registry-section-heading { display: flex; align-items: baseline; gap: clamp(24px, 5vw, 70px); padding: 36px 0 24px; }
  .registry-section-heading > span, .registry-empty-index, .registry-empty-overline { font: 600 .75rem/1.4 var(--font-mono); letter-spacing: .08em; }
  .registry-section-heading > span { min-width: 120px; color: var(--accent); }
  .registry-section-heading h2 { margin: 0; font-size: clamp(1.7rem, 3.3vw, 2.6rem); font-weight: 650; letter-spacing: -.04em; line-height: 1.2; }
  .registry-empty { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; min-height: 342px; padding: 36px 0 72px; }
  .registry-empty-index { color: var(--accent); }
  .registry-empty-index span { margin-left: 13px; color: var(--faint); }
  .registry-empty-body { max-width: 630px; }
  .registry-empty-overline { margin: 0 0 18px; color: var(--muted); }
  .registry-empty-body h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.1rem); letter-spacing: -.05em; line-height: 1.2; text-wrap: balance; font-weight: 650; }
  .registry-empty-body > p:not(.registry-empty-overline) { max-width: 57ch; margin: 22px 0 0; color: var(--muted); font-size: .98rem; line-height: 1.8; }
  .registry-empty-links { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 32px; }
  .registry-empty-links a, .registry-process-link { display: inline-flex; align-items: center; padding-bottom: 4px; border-bottom: 1px solid var(--ink); font-size: .88rem; font-weight: 600; text-decoration: none; transition: color .2s; }
  .registry-empty-links a:hover, .registry-process-link:hover { color: var(--accent); }
  .registry-process-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .registry-process-steps article { padding: 28px 30px 30px 0; }
  .registry-process-steps article + article { padding-left: 30px; border-left: 1px solid var(--line); }
  .registry-process-steps article > span { color: var(--accent); font: 600 .8rem var(--font-mono); }
  .registry-process-steps h3 { margin: 36px 0 12px; font-size: 1.2rem; font-weight: 650; letter-spacing: -.025em; }
  .registry-process-steps p { max-width: 36ch; margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.8; }
  .registry-process-link { margin-top: 32px; }
  .registry-page-shell a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 760px) {
    .registry-page-shell { width: min(100% - 32px, 1160px); }
    .registry-page-hero { grid-template-columns: 1fr; align-items: start; gap: 44px; padding: 58px 0 64px; }
    .registry-page-hero h1 { font-size: clamp(2.5rem, 10vw, 4.2rem); }
    .registry-status { min-height: 246px; }
    .registry-status-count strong { font-size: 5.5rem; }
    .registry-empty { grid-template-columns: 1fr; gap: 32px; min-height: 0; padding-bottom: 72px; }
    .registry-section-heading { display: block; }
    .registry-section-heading h2 { margin-top: 16px; }
    .registry-process-steps { grid-template-columns: 1fr; }
    .registry-process-steps article, .registry-process-steps article + article { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .registry-process-steps h3 { margin-top: 20px; }
  }
</style>
