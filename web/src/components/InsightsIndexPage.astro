---
import { getCollection } from "astro:content";
import { SITE } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { absoluteUrl } from "../lib/content";
import { DEFAULT_LANGUAGE, getPageCopy, localizePath, type Language } from "../lib/i18n";
import Breadcrumb from "./Breadcrumb.astro";
import PackCta from "./PackCta.astro";

type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const copy = getPageCopy(lang);
const canonicalPath = localizePath("/insights/", lang);

const entries = (await getCollection("insights", (entry) => !entry.data.draft)).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);

const breadcrumbItems = [
  { label: copy.breadcrumb.home, href: localizePath("/", lang) },
  { label: copy.breadcrumb.insights }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.insightsPage.indexTitle,
    url: absoluteUrl(canonicalPath),
    description: copy.insightsPage.indexDescription,
    inLanguage: copy.locale,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: entry.data.title,
        url: absoluteUrl(`/insights/${entry.id}/`)
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.label,
      ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {})
    }))
  }
];
---

<BaseLayout
  lang={lang}
  title={copy.insightsPage.indexTitle}
  description={copy.insightsPage.indexDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <main id="main-content" class="page-shell">
    <section class="page-hero">
      <div>
        <Breadcrumb items={breadcrumbItems} ariaLabel={copy.breadcrumb.insights} />
        <p class="eyebrow"><span></span> {copy.insightsPage.eyebrow}</p>
        <h1 class="page-title">{copy.insightsPage.indexTitle}</h1>
        <p class="page-lede">{copy.insightsPage.indexLede}</p>
        <p class="insights-feed-link">
          RSS: <a href="/insights/feed.xml">/insights/feed.xml</a>
          {lang === "en" && <span> · {copy.insightsPage.zhOnlyNote}</span>}
        </p>
      </div>
    </section>

    <section class="insight-list">
      {entries.map((entry) => (
        <a class="insight-card" href={`/insights/${entry.id}/`}>
          <p class="insight-card-meta">
            <span class="insight-card-industry">{entry.data.industry}</span>
            <span>{copy.insightsPage.updatedPrefix} {entry.data.dateModified}</span>
          </p>
          <h2>{entry.data.title}</h2>
          <p class="insight-card-desc">{entry.data.description}</p>
          <span class="insight-card-more">{copy.insightsPage.readMore} →</span>
        </a>
      ))}
    </section>

    <PackCta lang={lang} />
  </main>
</BaseLayout>

<style>
  .insights-feed-link {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  .insights-feed-link a {
    color: var(--green);
  }

  .insight-list {
    display: grid;
    gap: 18px;
    margin-top: 8px;
  }

  .insight-card {
    display: block;
    padding: 26px;
    border: 1px solid var(--line-strong);
    background: var(--paper-strong);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease;
  }

  .insight-card:hover {
    transform: translateY(-2px);
  }

  .insight-card-meta {
    display: flex;
    gap: 14px;
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .insight-card-industry {
    color: var(--green);
  }

  .insight-card h2 {
    margin: 0 0 10px;
    font-size: 1.4rem;
  }

  .insight-card-desc {
    margin: 0 0 14px;
    color: var(--muted);
    line-height: 1.65;
  }

  .insight-card-more {
    font-weight: 600;
    color: var(--green);
  }
</style>
