---
import { getCollection } from "astro:content";
import { SITE } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import { absoluteUrl } from "../lib/content";
import { HREFLANG, insightPath, DEFAULT_LANGUAGE, getPageCopy, localizePath, type Language } from "../lib/i18n";

type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const copy = getPageCopy(lang);
const canonicalPath = localizePath("/insights/", lang);

const entries = (await getCollection("insights", (entry) => !entry.data.draft)).sort((a, b) =>
  b.data.dateModified.localeCompare(a.data.dateModified) || a.id.localeCompare(b.id)
);

const breadcrumbItems = [
  { label: copy.breadcrumb.home, href: localizePath("/", lang) },
  { label: copy.breadcrumb.insights }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.insightsPage.indexTitle,
    url: absoluteUrl(canonicalPath),
    description: copy.insightsPage.indexDescription,
    inLanguage: copy.locale,
    ...(entries[0] ? { dateModified: entries[0].data.dateModified } : {}),
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: entry.data.title,
        url: absoluteUrl(insightPath(entry))
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.label,
      ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {})
    }))
  }
];
---

<BaseLayout
  lang={lang}
  title={copy.insightsPage.indexTitle}
  description={copy.insightsPage.indexDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <main id="main-content" class="page-shell">
    <PageHeader title={copy.insightsPage.indexTitle} eyebrow={copy.insightsPage.eyebrow} lede={copy.insightsPage.indexLede} breadcrumb={breadcrumbItems} breadcrumbLabel={copy.breadcrumb.insights}>
      <p class="page-meta">
        RSS: <a href="/insights/feed.xml">/insights/feed.xml</a>
        {lang === "en" && <span> · {copy.insightsPage.zhOnlyNote}</span>}
      </p>
    </PageHeader>

    <section class="insight-list">
      {entries.map((entry) => (
        <a class="card insight-card" href={insightPath(entry)}>
          <p class="insight-card-meta">
            <span class="insight-card-industry">{entry.data.industry}</span>
            <span>{copy.insightsPage.updatedPrefix} <time datetime={entry.data.dateModified}>{entry.data.dateModified}</time></span>
          </p>
          <h2 lang={HREFLANG[entry.data.lang]}>{entry.data.title}</h2>
          <p class="insight-card-desc" lang={HREFLANG[entry.data.lang]}>{entry.data.description}</p>
          <span class="insight-card-more">{copy.insightsPage.readMore} →</span>
        </a>
      ))}
    </section>

  </main>
</BaseLayout>

<style>
  .insight-list { display: grid; gap: 16px; }
  .insight-card-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 10px; color: var(--faint); font: 500 .75rem var(--font-mono); letter-spacing: .04em; }
  .insight-card-industry { color: var(--green); }
  .insight-card h2 { margin: 0 0 10px; font-size: 1.3rem; font-weight: 600; line-height: 1.4; letter-spacing: -.02em; transition: color .15s ease; }
  .insight-card:hover h2 { color: var(--accent); }
  .insight-card-desc { max-width: 78ch; margin: 0 0 16px; color: var(--muted); font-size: .92rem; line-height: 1.75; }
  .insight-card-more { font-size: .84rem; font-weight: 500; }
</style>
