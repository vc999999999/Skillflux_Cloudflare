---
import { SITE } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import { absoluteUrl } from "../lib/content";
import { getGuides } from "../lib/guides";
import { DEFAULT_LANGUAGE, getPageCopy, localizePath, type Language } from "../lib/i18n";

type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const copy = getPageCopy(lang);
const guides = getGuides();
const canonicalPath = localizePath("/guides/", lang);

const breadcrumbItems = [
  { label: copy.breadcrumb.home, href: localizePath("/", lang) },
  { label: copy.breadcrumb.guides }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.guidesPage.indexTitle,
    url: absoluteUrl(canonicalPath),
    description: copy.guidesPage.indexDescription,
    inLanguage: copy.locale,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: guides.length,
      itemListElement: guides.map((guide, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: guide.title[lang],
        url: absoluteUrl(localizePath(`/guides/${guide.slug}/`, lang))
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.label,
      ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {})
    }))
  }
];
---

<BaseLayout
  lang={lang}
  title={copy.guidesPage.indexTitle}
  description={copy.guidesPage.indexDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <main id="main-content" class="page-shell">
    <PageHeader title={copy.guidesPage.indexTitle} eyebrow={copy.guidesPage.eyebrow} lede={copy.guidesPage.indexLede} breadcrumb={breadcrumbItems} breadcrumbLabel={copy.breadcrumb.guides} />

    <section class="guide-list">
      {guides.map((guide) => (
        <a class="card guide-card" href={localizePath(`/guides/${guide.slug}/`, lang)}>
          <p class="guide-card-date">{copy.guidesPage.updatedPrefix} {guide.dateModified}</p>
          <h2>{guide.title[lang]}</h2>
          <p class="guide-card-desc">{guide.description[lang]}</p>
          <span class="guide-card-more">{copy.guidesPage.readMore} →</span>
        </a>
      ))}
    </section>

  </main>
</BaseLayout>

<style>
  .guide-list { display: grid; gap: 16px; }
  .guide-card-date { margin: 0 0 10px; color: var(--faint); font: 500 .75rem var(--font-mono); letter-spacing: .04em; }
  .guide-card h2 { margin: 0 0 10px; font-size: 1.3rem; font-weight: 600; line-height: 1.4; letter-spacing: -.02em; transition: color .15s ease; }
  .guide-card:hover h2 { color: var(--accent); }
  .guide-card-desc { max-width: 78ch; margin: 0 0 16px; color: var(--muted); font-size: .92rem; line-height: 1.75; }
  .guide-card-more { font-size: .84rem; font-weight: 500; }
</style>
