---
// Pass / warning / fail (optionally info) counts of a static health check, in the shared tone colours.
// The group carries a spoken summary, so screen readers don't hear three bare numbers.
import type { Language } from "../lib/i18n";

type Counts = { pass: number; warn: number; fail: number; info: number };
type Props = { counts: Counts; lang: Language; info?: boolean; size?: "sm" | "lg" };
const { counts, lang, info = false, size = "sm" } = Astro.props;
const zh = lang === "zh";
const parts: Array<{ tone: string; value: number; label: string }> = [
  { tone: "pass", value: counts.pass, label: zh ? "通过" : "pass" },
  { tone: "warn", value: counts.warn, label: zh ? "警告" : counts.warn === 1 ? "warning" : "warnings" },
  { tone: "fail", value: counts.fail, label: zh ? "失败" : counts.fail === 1 ? "failure" : "failures" },
  ...(info ? [{ tone: "info", value: counts.info, label: zh ? "提示" : "info" }] : []),
];
const summary = parts.map(part => zh ? `${part.value} 项${part.label}` : `${part.value} ${part.label}`).join(zh ? "，" : ", ");
---
<span class:list={["health-badges", `is-${size}`]} role="img" aria-label={summary} title={summary}>
  {parts.map(part => <span class={`health-badge tone-${part.tone}`}>{part.value}{size === "lg" && <small>{part.label}</small>}</span>)}
</span>
<style>
  .health-badges { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .health-badge { display: inline-flex; align-items: baseline; justify-content: center; gap: 5px; min-width: 26px; padding: 1px 6px; border-radius: 8px; font: .76rem var(--font-mono); }
  .is-lg { gap: 8px; }
  .is-lg .health-badge { min-width: 0; padding: 5px 12px; border-radius: var(--radius-md); font: 600 1.05rem var(--font-mono); }
  .is-lg small { font: 500 .78rem var(--font-body); }
</style>
