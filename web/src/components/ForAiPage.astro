---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ENDPOINTS } from "../config";
import { absoluteUrl } from "../lib/content";
import { localizePath, type Language } from "../lib/i18n";

type Props = { lang?: Language };
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
const t = (cn: string, en: string) => zh ? cn : en;
const descriptions: Record<string, [string, string]> = {
  "/llms.txt": ["先读这一份。了解站点定位、主要入口和数据的使用边界。", "Start here for the site's purpose, main entry points and data boundaries."],
  "/llms-full.txt": ["完整来源目录的纯文本版本，适合直接阅读、检索和引用。", "The complete source catalog in plain text, ready to read, search and cite."],
  "/index.json": ["来源名称、类型、标签、摘要与链接，以及场景和技能发布入口。", "Source names, types, tags, summaries and links, plus scenario and skill-release entry points."],
  "/feed.xml": ["资源来源的 RSS 订阅流，用于跟进收录与更新。", "An RSS feed of source entries for following additions and updates."],
  "/insights/feed.xml": ["编辑解读与工作流分析的 RSS；文章解读不等于安装包实测。", "RSS for editorial analysis and workflows. Articles are not install-package evaluations."],
  "/skills-index.json": ["签名发布快照中的 Skill 和版本状态，安装前仍需实时检查资格。", "Skills and version states from a signed publication snapshot. Recheck live qualification before installation."],
  "/scenarios/index.json": ["按任务组织的场景、选型与维护指南，含中英文页面链接。", "Task-based scenarios, selection and maintenance guides, with Chinese and English page links."]
};
const agentPrompt = t(
  `请先读取 ${absoluteUrl("/llms.txt")}，再用 ${absoluteUrl("/index.json")} 查找与我的任务相关的能力来源（Skills、MCP 工具、插件）。比较功能定位、来源类型和适用边界，给出原始链接及推荐理由。黄页收录不代表已获官方担保；需要安装时，先核对当前资格，再由我确认具体计划。`,
  `Read ${absoluteUrl("/llms.txt")} first, then use ${absoluteUrl("/index.json")} to find agent capabilities (skills, MCP tools, plugins) relevant to my task. Compare purpose, source type, and limitations; include original links and recommendations. Yellow pages inclusion does not imply official endorsement. Before installation, check qualification and ask me to approve the plan.`
);
---
<BaseLayout lang={lang} canonicalPath={localizePath("/for-ai/", lang)} title={t("给 AI 的黄页入口", "For AI agents")} description={t("SkillFlux 机器可读黄页：llms.txt、JSON、RSS 与结构化索引，让 AI 直接读懂全网 Agent 能力。", "Machine-readable capability directory for AI agents: llms.txt, JSON, RSS, and structured endpoints.")}>
  <main id="main-content" class="page-shell ai-shell">
    <header class="page-hero">
      <div><p class="eyebrow">{t("面向智能体设计", "BUILT FOR AGENTS")}</p><h1 class="page-title">{t("人类看得懂，Agent 直接读。", "Readable by humans. Native to agents.")}</h1><p class="page-lede">{t("把结构清晰的能力黄页交给 AI。纯文本、JSON 索引与订阅流，均与网站实时数据完全同源。", "Deliver a structured capability directory directly to your agent. Plain text, JSON indexes, and feeds generated from the exact same source.")}</p></div>
    <div class="ai-symbol" aria-hidden="true">
      <span class="ai-symbol-status"></span>
      <code>/api/live</code>
    </div>
    </header>
    <section class="ai-start" aria-labelledby="ai-start-title">
      <div><span class="ai-kicker">01 / START HERE</span><h2 id="ai-start-title">{t("让 AI 帮你选配能力", "Ask your AI to explore")}</h2><p>{t("复制这段提示词，粘贴到支持网络或文件读取的 AI 工具中，输入你的具体任务。", "Copy this prompt into any AI agent with web or context reading capabilities, then describe your task.")}</p><button class="button primary" type="button" data-copy-text={agentPrompt}>{t("复制给 AI 的指令", "Copy agent prompt")} <span aria-hidden="true">↗</span></button></div>
      <div class="ai-prompt"><div><span>AGENT PROMPT</span><span aria-hidden="true">↗</span></div><p>{agentPrompt}</p></div>
    </section>
    <section class="ai-endpoints" aria-labelledby="ai-endpoints-title">
      <div class="section-heading-row"><div><p class="eyebrow">02 / OPEN ENDPOINTS</p><h2 id="ai-endpoints-title">{t("选一个适合的格式", "Choose the right format")}</h2></div><span class="ai-open-label">{t("公开读取 · 无需登录", "Public access · No login")}</span></div>
      <div class="endpoint-grid">{ENDPOINTS.map(endpoint => <a class="endpoint-card" href={endpoint.path}><div class="endpoint-top"><span class:list={['format-tag', endpoint.path.endsWith('.json') && 'is-json', endpoint.path.endsWith('.xml') && 'is-xml']}>{endpoint.path.endsWith(".json") ? "JSON" : endpoint.path.endsWith(".xml") ? "RSS" : "TXT"}</span><span aria-hidden="true">↗</span></div><h3>{endpoint.path}</h3><p>{descriptions[endpoint.path][zh ? 0 : 1]}</p></a>)}</div>
    </section>
    <section class="ai-boundaries" aria-labelledby="ai-boundaries-title"><div><p class="eyebrow">03 / READ WITH CONTEXT</p><h2 id="ai-boundaries-title">{t("读对数据，也读懂边界。", "Understand the data and its limits.")}</h2></div><div class="ai-rules"><article><span>01</span><div><h3>{t("黄页目录 ≠ 随意安装", "Directory entries and verified installation")}</h3><p>{t("黄页条目用于全景发现和对比。需要安装时，请选择经由审核流水线验证、具备完整签名与测试报告的具体版本。", "Directory entries enable open discovery and comparison. When installing, select verified releases with signed manifests and review records.")}</p></div></article><article><span>02</span><div><h3>{t("静态快照有更新时间", "Snapshots have a timestamp")}</h3><p>{t("页面和 JSON 在构建时生成。引用时保留来源与时间，安装或升级时交由 Runtime 重新检查实时状态。", "Pages and JSON are generated at build time. Keep source links and timestamps when citing, and let the runtime check live status before installing or upgrading.")}</p></div></article><article><span>03</span><div><h3>{t("读取资料与执行操作分开", "Reading and acting are separate")}</h3><p>{t("公开端点用于读取。连接项目、安装和升级需由用户明确发起，并遵循项目权限与精确版本计划。", "Public endpoints provide data. Connecting a project, installing and upgrading require explicit user intent, project permissions and exact-version plans.")}</p></div></article></div></section>
    <div class="ai-next"><p>{t("想让 AI 直接接入能力？", "Want to equip your agent directly?")}</p><a class="button secondary" href={localizePath("/install/", lang)}>{t("查看运行时接入指南", "Read the setup guide")} <span aria-hidden="true">→</span></a></div>
  </main>
</BaseLayout>
<style>
  .ai-symbol { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 24px; background: var(--paper-strong); box-shadow: var(--shadow-sm); }
  .ai-symbol-status { width: 7px; height: 7px; border-radius: 50%; background: var(--green); flex-shrink: 0; box-shadow: 0 0 0 2px var(--green-subtle); }
  .ai-symbol code { font-size: .8rem; font-weight: 600; color: var(--muted); }
  .ai-start { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: center; padding: 56px 0; border-bottom: 1px solid var(--line); }
  .ai-kicker { font: 500 .75rem var(--font-mono); color: var(--faint); letter-spacing: .08em; }
  .ai-start h2, .ai-boundaries h2 { margin: 14px 0 16px; font-size: 1.75rem; letter-spacing: -.03em; font-weight: 650; }
  .ai-start > div > p { color: var(--muted); font-size: .95rem; line-height: 1.8; margin-bottom: 26px; }
  .ai-prompt { min-width: 0; border-radius: var(--radius-lg); overflow: hidden; background: #191712; color: #edebe1; border: 1px solid #332f26; box-shadow: var(--shadow-card); }
  .ai-prompt > div { display: flex; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid #2e2a22; color: #a6a193; font: 500 .72rem var(--font-mono); letter-spacing: .06em; }
  .ai-prompt p { padding: 8px 22px 14px; font: .82rem/1.9 var(--font-mono); overflow-wrap: anywhere; color: #edebe1 !important; margin: 0; }
  .ai-endpoints { padding: 56px 0; }
  .ai-open-label { font-size: .82rem; color: var(--muted); white-space: nowrap; font-weight: 500; }
  .endpoint-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .endpoint-card { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); text-decoration: none; background: var(--paper-strong); box-shadow: var(--shadow-sm); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease; }
  .endpoint-card:hover { border-color: rgba(23, 21, 15, 0.28); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .endpoint-top { display: flex; justify-content: space-between; align-items: center; }
  .format-tag { padding: 3px 8px; border-radius: var(--radius-sm); background: var(--cream); font: 600 .72rem var(--font-mono); color: var(--muted); letter-spacing: .04em; }
  .format-tag.is-json { background: var(--green-subtle); color: var(--green); }
  .format-tag.is-xml { background: #fbeee9; color: var(--accent); }
  .endpoint-top span:last-child { color: var(--faint); }
  .endpoint-card h3 { margin: 18px 0 10px; font: 600 .92rem var(--font-mono); overflow-wrap: anywhere; color: var(--ink); }
  .endpoint-card p { margin: 0; font-size: .84rem; line-height: 1.75; color: var(--muted); }
  .ai-boundaries { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; padding: 52px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ai-rules { display: grid; gap: 26px; }
  .ai-rules article { display: flex; gap: 18px; }
  .ai-rules article > span { color: var(--accent); font: 600 .85rem/1.6 var(--font-mono); }
  .ai-rules h3 { margin: 0 0 8px; font-size: .98rem; font-weight: 620; color: var(--ink); }
  .ai-rules p { margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.8; }
  .ai-next { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 18px; margin-top: 40px; padding: 24px 28px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-strong); }
  .ai-next p { margin: 0; font-weight: 600; font-size: .98rem; color: var(--ink); }
  @media(max-width: 900px) { .endpoint-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ai-start, .ai-boundaries { gap: 32px; } }
  @media(max-width: 620px) { .ai-symbol { display: none; } .ai-start, .ai-boundaries { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 36px 0; } .endpoint-grid { grid-template-columns: minmax(0, 1fr); } .ai-open-label { display: none; } .ai-endpoints { padding: 36px 0; } .endpoint-card h3 { margin-top: 14px; } }
</style>
