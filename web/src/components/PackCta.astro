---
import { DEFAULT_LANGUAGE, localizePath, type Language } from "../lib/i18n";

type Props = { lang?: Language };
const { lang = DEFAULT_LANGUAGE } = Astro.props;
const isZh = lang === "zh";
---

<section class="pack-cta" aria-label={isZh ? "SkillFlux 安装入口" : "SkillFlux setup"}>
  <div class="pack-cta-body">
    <p class="eyebrow"><span></span>CURATED REGISTRY</p>
    <h2>{isZh ? "来源目录之外，还有真正可验证的安装链路。" : "Beyond the source map, there is a verifiable install path."}</h2>
    <p>{isZh
      ? "通过公开 npm 包 @skillflux/mcp 接入工具，再用 MCP 搜索已审核的 Skill。从 GitHub 下载完整发布包、加载所需内容后，由你的 AI 执行任务。"
      : "Connect with the public @skillflux/mcp npm package, then search reviewed skills through MCP. Download complete releases from GitHub, load the needed content, and let your AI carry out the task."}</p>
  </div>
  <div class="pack-cta-actions">
    <a href={localizePath("/registry/", lang)}>{isZh ? "搜索精品 Skill" : "Search curated skills"}<span>→</span></a>
    <a href={localizePath("/install/", lang)}>{isZh ? "安装与使用指南" : "Setup and usage guide"}<span>↗</span></a>
  </div>
</section>

<style>
  .pack-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .pack-cta-actions a {
    display: inline-flex;
    justify-content: space-between;
    gap: 24px;
    min-width: 190px;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 13px 14px;
    color: var(--ink);
    text-decoration: none;
    font-size: .82rem;
    font-weight: 750;
  }

  .pack-cta-actions a:first-child {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }
</style>
