---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizePath, type Language } from "../lib/i18n";
type Props = { lang?: Language; kind: "quality" | "privacy" | "terms" | "contact" };
const { lang = "en", kind } = Astro.props;
const zh = lang === "zh";
const t = (cn: string, en: string) => zh ? cn : en;
const documents = {
  quality: {
    title: t("一个来源怎样被收录。", "How a source gets listed."),
    label: t("收录标准", "Listing policy"),
    intro: t("黄页收录的是 Skill 的来源：官方合集、市场、开源仓库、社区榜单和导航站。收录说明来源存在、可访问且用途清楚，不代表其中每个 Skill 都经过测试。", "The directory lists skill sources: vendor collections, marketplaces, open-source repositories, community lists and directories. Listing means a source exists, is reachable and has a clear purpose. It does not mean every skill in it was tested."),
    sections: [
      [t("收录条件", "What qualifies"), t("来源需要公开可访问，能说明提供什么类型的 Skill、面向哪些宿主，并能找到作者或维护方。只做转载、没有原始来源的页面不收录。", "A source must be publicly reachable, say what kind of skills it offers and for which hosts, and identify an author or maintainer. Pages that only repost content without an original source are not listed.")],
      [t("我们写什么", "What we write"), t("每个来源页包含编辑整理的用途、适用场景、局限和替代选择，并链接原始网站。这些是编辑判断；来源中的能力说法属于作者自述。", "Each source page has an editorial summary of purpose, fit, limitations and alternatives, and links to the original. These are editorial judgments; capability claims made by the source belong to its author.")],
      [t("复核与下架", "Review and delisting"), t("来源页标注最后复核日期。失效、长期无人维护或内容与描述明显不符的来源会被标为观察中或归档。发现错误可以通过提交页或 GitHub Issue 反馈。", "Source pages show their last review date. Sources that go offline, stop being maintained or clearly differ from their description are marked as watching or archived. Report errors through the submit page or a GitHub issue.")],
      [t("没有付费收录", "No paid placement"), t("收录、排序和推荐不接受付费。编辑推荐只表示值得优先阅读，不是官方背书。", "Listing, ordering and recommendations are not paid for. An editorial pick means a source is worth reading first; it is not an official endorsement.")],
      [t("标准的边界", "Limits of this policy"), t("收录标准帮助你更快找到可追溯的来源，不保证某个 Skill 在你的模型、宿主和任务上有效。使用前请在不含生产密钥的测试项目中验证。", "This policy helps you find traceable sources faster. It does not guarantee that a skill works with your model, host or task. Verify in a test project without production secrets before relying on one.")]
    ]
  },
  privacy: {
    title: t("哪些信息会留下。", "What information is retained."),
    label: t("隐私说明", "Privacy notice"),
    intro: t("本站是静态内容站，浏览无需注册，不收集表单提交的个人信息。", "This is a static content site. Browsing needs no account, and the site collects no form-submitted personal information."),
    sections: [
      [t("基础访问日志", "Operational logs"), t("Cloudflare 可能收到 IP、时间、请求路径、浏览器信息和错误日志，用于提供服务和排障。我们不在页面中嵌入广告或第三方追踪脚本。", "Cloudflare may receive IP addresses, timestamps, request paths, browser details and error logs to serve the site and troubleshoot. Pages embed no ads or third-party tracking scripts.")],
      [t("站内搜索", "On-site search"), t("站内搜索在浏览器中对静态索引进行，检索词不会发送到服务器。", "On-site search runs in your browser over a static index; queries are not sent to a server.")],
      [t("反馈与更正", "Feedback and corrections"), t("通过 GitHub 提交反馈时，你的 GitHub 账号与内容由 GitHub 按其政策处理。请不要在反馈中提交密钥或私人对话。", "Feedback submitted through GitHub is handled by GitHub under its own policy, including your account details. Do not include secrets or private conversations in feedback.")]
    ]
  },
  terms: {
    title: t("内容如何使用。", "How the content may be used."),
    label: t("服务条款", "Terms of service"),
    intro: t("本页说明站内内容的性质与使用边界。", "This page explains what the site's content is and how it may be used."),
    sections: [
      [t("第三方来源", "Third-party sources"), t("目录收录第三方入口及简介，相关权利归原作者。使用或再分发第三方 Skill 前，请阅读其许可证；不可借本站收录声称第三方背书。", "The directory lists third-party sources with summaries; rights belong to their authors. Read each license before using or redistributing a third-party skill, and do not present a listing as an endorsement.")],
      [t("本站内容", "Our content"), t("编辑摘要与分析文章可以在注明来源和链接的前提下引用。引用时请保留页面上的更新日期。", "Editorial summaries and analyses may be quoted with attribution and a link. Keep the page's update date when citing.")],
      [t("不作保证", "No warranty"), t("内容按发布时的资料整理，外部仓库可能随时变化。我们不保证被搜索引擎或 AI 收录，也不保证某个 Skill 适合你的任务。", "Content reflects sources as of publication, and external repositories can change at any time. We do not guarantee search or AI inclusion, or that any skill fits your task.")]
    ]
  },
  contact: {
    title: t("把问题交给合适的入口。", "Choose the right contact path."),
    label: t("联系与反馈", "Contact and feedback"),
    intro: t("浏览和搜索无需登录。以下入口分别接收合作需求、内容更正与收录推荐。", "Browsing and search require no login. The paths below cover cooperation inquiries, corrections and listing suggestions."),
    sections: [
      [t("产品与合作", "Product and cooperation inquiries"), t("通过仓库 Issue 或页面底部联系方式留下需求与背景。说明产品、期望的协作方式和至少一种联系渠道。", "Open a repository issue or use a contact link in the page footer. Describe the product, the kind of cooperation you want and at least one way to reach you.")],
      [t("内容更正", "Corrections"), t("发现来源信息过期或描述有误，请在 GitHub Issue 中注明页面地址和具体问题，最好附上原始来源链接。", "If a source page is outdated or wrong, open a GitHub issue with the page URL, the specific problem and ideally a link to the original source.")],
      [t("推荐收录", "Suggest a source"), t("通过提交页推荐值得收录的来源，说明它提供什么、面向哪些宿主以及作者是谁。", "Use the submit page to suggest a source, with what it offers, which hosts it targets and who maintains it.")]
    ]
  }
};
const document = documents[kind];
const updatedAt = "2026-10-29";
---
<BaseLayout lang={lang} canonicalPath={localizePath("/" + kind + "/", lang)} title={document.label} description={document.intro} pageClass="policy-page">
  <main id="main-content" class="policy-shell">
    <a href={localizePath("/",lang)} class="policy-back">← {t("返回首页", "Home")}</a>
    <header><p class="eyebrow"><span></span>{document.label}</p><h1>{document.title}</h1><p class="policy-intro">{document.intro}</p><small>{t("更新于 ", "Updated ")}{updatedAt}</small></header>
    <div class="policy-body">
      <nav aria-label={t("相关说明", "Related information")}>
        {[["quality",t("收录标准","Listing policy")],["privacy",t("隐私说明","Privacy")],["terms",t("服务条款","Terms")],["contact",t("联系与反馈","Contact")]].map(([path,label])=><a href={localizePath("/"+path+"/",lang)} aria-current={path===kind?"page":undefined}>{label}</a>)}
      </nav>
      <article>{document.sections.map(([heading,body],index)=><section><p class="policy-number">{String(index+1).padStart(2,"0")}</p><div><h2>{heading}</h2><p>{body}</p></div></section>)}
      </article>
    </div>
  </main>
</BaseLayout>
<style>
  .policy-shell { width:min(1180px,calc(100% - 48px)); margin:0 auto; padding:40px 0 100px; }
  .policy-back { font-size:.8rem; }
  .policy-shell > header { padding:55px 0 44px; border-bottom:2px solid var(--ink); }
  h1 { font:800 clamp(2.5rem,5vw,3.8rem)/1.08 var(--font-body); letter-spacing:-.045em; max-width:17ch; margin:0 0 30px; text-wrap:balance; }
  .policy-intro { max-width:65ch; line-height:1.8; color:var(--muted); }
  header small { font: .7rem var(--font-mono); color:var(--accent); }
  .policy-body { display:grid;grid-template-columns:minmax(150px,.3fr) minmax(0,1fr);gap:80px;padding-top:45px; }
  nav { display:flex; flex-direction:column; gap:0; align-self:start; position:sticky; top:100px; }
  nav a { text-decoration:none; border-bottom:1px solid var(--line); padding:15px 0; font-size:.85rem; }
  nav a[aria-current="page"] { color:var(--accent); font-weight:700; }
  article > section { display:grid;grid-template-columns:36px minmax(0,1fr);gap:20px;border-bottom:1px solid var(--ink);padding:0 0 30px;margin-bottom:30px; }
  .policy-number { font: .75rem var(--font-mono); color:var(--accent); margin:5px 0; }
  h2 { margin:0 0 18px;font:700 1.65rem/1.25 var(--font-body); }
  section div > p { margin:0;line-height:1.85;max-width:70ch;color:var(--muted);font-size:.94rem; }
  .policy-actions { display:flex;gap:20px;flex-wrap:wrap;padding-top:16px;font-size:.85rem; }
  a:focus-visible { outline:3px solid var(--accent);outline-offset:5px; }
  @media(max-width:700px) { .policy-shell {width:calc(100% - 30px);} .policy-body {grid-template-columns:1fr;gap:32px;} nav {position:static;flex-direction:row;flex-wrap:wrap;gap:18px;} nav a {padding:10px 0;} }
</style>
