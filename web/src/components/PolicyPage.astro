---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizePath, type Language } from "../lib/i18n";
type Props = { lang?: Language; kind: "quality" | "privacy" | "terms" | "contact" };
const { lang = "zh", kind } = Astro.props;
const zh = lang === "zh";
const t = (cn: string, en: string) => zh ? cn : en;
const documents = {
  quality: {
    title: t("怎样才算通过审核。", "What approval requires."),
    label: t("质量标准", "Quality standards"),
    intro: t("审核针对一个确定版本和它的内容指纹。自动扫描与人工实测分别记录；发布索引由 GitHub 目录仓库生成。", "Review applies to an exact version and content fingerprint. Automated checks and human evaluation are recorded separately; the publication index is generated from the GitHub catalog."),
    sections: [
      [t("先检查全部包内容", "Inspect the complete package"), t("入库需提供文本文件、入口、权限、依赖、许可证、发布者及版本维护信息。当前 Registry 仅接受无网络、Shell 或密钥权限的文本包。自动检查记录可见；纯文本不等于安全，检查不能代替人工实测。", "Submissions include all text files, an entry point, permissions, dependencies, license, publisher and release metadata. The current registry accepts text packages without network, shell or secret capabilities. Automated check results are visible; text alone is not proof of safety, and checks do not replace human testing.")],
      [t("真实运行主要用途和边界场景", "Run the purpose and boundary cases"), t("发布前需由人实际执行主要用途成功场景和边界场景，并在全部声明支持的宿主中成功安装和读取。记录测试者、测试时间、环境与模型、输入、预期、实际结果、步骤、限制和证据。模拟结果不能充当人工实测。", "Before publication, a person must execute a successful primary-purpose case and a boundary case, and successfully install and read the package in every declared host. Records capture the tester, time, environment and model, input, expected and actual results, steps, limitations and evidence. Simulations do not qualify as human tests.")],
      [t("公开脱敏摘要，保留原始记录", "Publish a redacted summary"), t("公开详情展示质量结论、适用宿主、测试时间及脱敏摘要。原始测试记录供内部复核，不进入公开目录仓库。批准、拒绝、撤销应在仓库审核记录中注明理由。", "Public details show qualification, tested hosts, test time and a redacted summary. Raw test records remain available for internal review and do not enter the public catalog. Approval, rejection and revocation should include reasons in the repository review records.")],
      [t("每个版本都需重新确认", "Review each version independently"), t("更新需说明变更、是否破坏兼容、最低客户端版本、维护时间和维护者。审批不会改写已发布的旧版本。已撤销版本从可安装集合移除，客户端在线检查撤销信息；离线状态不能保证已知最新撤销。", "Updates declare changes, breaking compatibility, minimum client version, maintenance time and maintainer. Approval does not overwrite an older published version. Revoked versions are removed from the installable set, and online clients check revocations; offline operation cannot guarantee knowledge of the latest revocations.")],
      [t("标准的边界", "Limits of the standard"), t("审核提高可追溯性，不保证模型每次执行正确，也不保证第三方服务、宿主更新后仍兼容。使用者仍需检查权限、输入适用性和模型输出；声明的限制是选择 Skill 的一部分。", "Review improves traceability. It does not guarantee correct model output on every run or compatibility after third-party service or host changes. Users still need to inspect capabilities, suitability of inputs and model outputs. Declared limitations matter when choosing a skill.")]
    ]
  },
  privacy: {
    title: t("哪些信息会留下。", "What information is retained."),
    label: t("隐私说明", "Privacy notice"),
    intro: t("公开浏览无需注册。静态页面与本地客户端的网络访问范围不同；本站不收集任何表单提交的个人信息。", "Public browsing needs no account. The static site and the local client have different network footprints; this site collects no form-submitted personal data."),
    sections: [
      [t("公开访问与基础日志", "Public access and operational logs"), t("公开页面不要求用户身份，也不在线运行 AI。Cloudflare 和 GitHub 可能收到 IP、时间、请求路径、浏览器信息和错误日志，用于提供服务和排障。无需账号不等于不产生访问数据。", "Public pages do not require identity and do not run AI online. Cloudflare and GitHub may receive IP addresses, timestamps, request paths, browser information and error logs for delivery and diagnostics. Account-free access does not mean no access data is generated.")],
      [t("本地项目与 Registry", "Local projects and the registry"), t("本地 Runtime 管理项目配置、目录索引缓存和版本锁定。搜索在本地缓存索引上进行，检索词不会离开你的机器；客户端仅连接 GitHub 目录仓库下载索引与技能文件。该机制不要求把整个项目、密钥或完整对话上传到任何服务器。外部模型供应商的数据处理以使用者选择的服务为准。", "The local runtime manages project configuration, the cached catalog index and version locks. Search runs locally over the cached index; queries never leave your machine. The client only contacts the GitHub catalog repository to download the index and skill files. This mechanism does not require uploading an entire project, secrets or full conversations to any server. External model providers process data under the user's chosen service.")],
      [t("内部权限与联系", "Internal access and contact"), t("技能内容由 GitHub 目录仓库管理，访问权限由仓库与 GitHub 账号体系控制。人工实测的原始记录不进入公开目录仓库；公开内容仅包含允许公开的摘要。如需更正目录内容，请通过仓库 Issue 或既有联系渠道说明。", "Skill content is managed in a GitHub catalog repository; access is governed by the repository and GitHub accounts. Raw evaluation records never enter the public catalog repository; only approved summaries are public. To correct catalog content, open a repository issue or use an established contact channel.")]
    ]
  },
  terms: {
    title: t("服务如何使用。", "How the service is used."),
    label: t("服务条款", "Terms of service"),
    intro: t("本页解释当前产品机制与使用边界。", "This page explains current product behavior and usage limits."),
    sections: [
      [t("目录与软件包", "Directory and packages"), t("来源目录提供第三方入口及简介，权利归原作者。GitHub 目录仓库提供具备版本与质量记录的技能包。使用或再分发前应阅读对应许可证；不可借来源收录声称第三方背书。", "The source directory links to third-party resources and summaries; rights remain with their authors. The GitHub catalog repository provides skill packages with version and quality records. Read each license before using or redistributing it, and do not treat directory inclusion as third-party endorsement.")],
      [t("本地执行边界", "Local execution limits"), t("网站不代替宿主执行 AI。安装需要本地 Runtime、宿主配置及适用权限；外部模型服务可有自己的费用和限制。固定版本、更新检查和主动升级是不同操作，用户应检查变更与破坏性更新。", "The website does not execute AI on behalf of a host. Installation needs the local runtime, host configuration and appropriate permissions. External model services may have separate costs and limits. Version pinning, update checks and explicit upgrades are distinct operations; users should inspect changes and breaking updates.")],
      [t("内容责任与问题处理", "Content responsibility and review"), t("目录仓库维护者应提供真实且有权使用的内容与许可证声明，不得提交误导、侵权或恶意内容。我们不保证被搜索引擎或 AI 收录，也不承诺审核等同于零风险。", "Catalog maintainers should provide truthful, authorized content and license statements, without misleading, infringing or malicious material. We do not guarantee search-engine or AI indexing, or risk-free outcomes from review.")]
    ]
  },
  contact: {
    title: t("把问题交给合适的入口。", "Choose the right contact path."),
    label: t("联系与反馈", "Contact and feedback"),
    intro: t("浏览、搜索和本地安装无需登录。以下入口分别接收合作需求与接入问题。", "Browsing, search and local installation require no login. The paths below cover cooperation inquiries and setup questions."),
    sections: [
      [t("产品与合作", "Product and cooperation inquiries"), t("通过仓库 Issue 或页面底部联系方式留下需求与背景。说明产品、期望的协作方式和至少一种联系渠道。", "Open a repository issue or use a contact link in the page footer. Describe the product, the desired collaboration and at least one contact channel.")],
      [t("目录内容问题", "Catalog content concerns"), t("目录内容问题可直接在对应 GitHub 仓库提交 Issue，说明技能 ID、版本和具体问题。", "For catalog content concerns, open an issue in the corresponding GitHub repository with the skill ID, version and the specific problem.")],
      [t("本地接入与资料请求", "Local setup and data requests"), t("先阅读接入指南，检查客户端安装与版本、宿主配置和目录仓库地址。资料更正或删除请求可沿用既有联系渠道说明。不要提交项目密钥或完整私人对话。", "Start with the setup guide and check your client installation and version, host configuration and catalog repository. For data corrections or deletions, use an established contact channel. Do not submit project secrets or complete private conversations.")]
    ]
  }
};
const document = documents[kind];
const updatedAt = kind === "contact" ? "2026-10-09" : "2026-10-01";
---
<BaseLayout lang={lang} canonicalPath={localizePath("/" + kind + "/", lang)} title={document.label} description={document.intro} pageClass="policy-page">
  <main id="main-content" class="policy-shell">
    <a href={localizePath("/",lang)} class="policy-back">← {t("返回首页", "Home")}</a>
    <header><p class="eyebrow"><span></span>{document.label}</p><h1>{document.title}</h1><p class="policy-intro">{document.intro}</p><small>{t("适用当前实现 · 更新于 ", "Current implementation · Updated ")}{updatedAt}</small></header>
    <div class="policy-body">
      <nav aria-label={t("相关说明", "Related information")}>
        {[["quality",t("质量标准","Quality standards")],["privacy",t("隐私说明","Privacy")],["terms",t("服务条款","Terms")],["contact",t("联系与反馈","Contact")]].map(([path,label])=><a href={localizePath("/"+path+"/",lang)} aria-current={path===kind?"page":undefined}>{label}</a>)}
      </nav>
      <article>{document.sections.map(([heading,body],index)=><section><p class="policy-number">{String(index+1).padStart(2,"0")}</p><div><h2>{heading}</h2><p>{body}</p></div></section>)}
        <div class="policy-actions"><a href={localizePath("/install/",lang)}>{t("本地接入指南","Local setup guide")} →</a></div>
      </article>
    </div>
  </main>
</BaseLayout>
<style>
  .policy-shell { width:min(1180px,calc(100% - 48px)); margin:0 auto; padding:40px 0 100px; }
  .policy-back { font-size:.8rem; }
  .policy-shell > header { padding:55px 0 44px; border-bottom:2px solid var(--ink); }
  h1 { font:800 clamp(2.5rem,5vw,3.8rem)/1.08 var(--font-body); letter-spacing:-.045em; max-width:17ch; margin:0 0 30px; text-wrap:balance; }
  .policy-intro { max-width:65ch; line-height:1.8; color:var(--muted); }
  header small { font: .7rem var(--font-mono); color:var(--accent); }
  .policy-body { display:grid;grid-template-columns:minmax(150px,.3fr) minmax(0,1fr);gap:80px;padding-top:45px; }
  nav { display:flex; flex-direction:column; gap:0; align-self:start; position:sticky; top:100px; }
  nav a { text-decoration:none; border-bottom:1px solid var(--line); padding:15px 0; font-size:.85rem; }
  nav a[aria-current="page"] { color:var(--accent); font-weight:700; }
  article > section { display:grid;grid-template-columns:36px minmax(0,1fr);gap:20px;border-bottom:1px solid var(--ink);padding:0 0 30px;margin-bottom:30px; }
  .policy-number { font: .75rem var(--font-mono); color:var(--accent); margin:5px 0; }
  h2 { margin:0 0 18px;font:700 1.65rem/1.25 var(--font-body); }
  section div > p { margin:0;line-height:1.85;max-width:70ch;color:var(--muted);font-size:.94rem; }
  .policy-actions { display:flex;gap:20px;flex-wrap:wrap;padding-top:16px;font-size:.85rem; }
  a:focus-visible { outline:3px solid var(--accent);outline-offset:5px; }
  @media(max-width:700px) { .policy-shell {width:calc(100% - 30px);} .policy-body {grid-template-columns:1fr;gap:32px;} nav {position:static;flex-direction:row;flex-wrap:wrap;gap:18px;} nav a {padding:10px 0;} }
</style>
