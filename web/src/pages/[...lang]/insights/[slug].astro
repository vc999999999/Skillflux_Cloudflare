---
import { getCollection, render } from "astro:content";
import { SITE } from "../../../config";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { absoluteUrl, getSiteBySlug } from "../../../lib/content";
import { LANGUAGE_PREFIX, getPageCopy, getSiteCopy, localizePath } from "../../../lib/i18n";

export async function getStaticPaths() {
  const entries = await getCollection("insights", (entry) => !entry.data.draft);
  // An article is published only in the language it was written in.
  return entries.map((entry) => ({ params: { lang: LANGUAGE_PREFIX[entry.data.lang].slice(1) || undefined, slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const lang = data.lang;
const copy = getPageCopy(lang);
const t = copy.insightsPage;
const canonicalPath = localizePath(`/insights/${entry.id}/`, lang);

const relatedSites = data.relatedSites
  .map((slug) => getSiteBySlug(slug))
  .filter((site) => site !== undefined);

const breadcrumbItems = [
  { label: copy.breadcrumb.home, href: localizePath("/", lang) },
  { label: copy.breadcrumb.insights, href: localizePath("/insights/", lang) },
  { label: data.title }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: data.title,
    description: data.description,
    abstract: data.tldr,
    url: absoluteUrl(canonicalPath),
    inLanguage: copy.locale,
    datePublished: data.datePublished,
    dateModified: data.dateModified,
    about: { "@type": "SoftwareSourceCode", name: data.skillName, codeRepository: data.source.repo },
    isBasedOn: data.source.repo,
    author: { "@type": "Organization", name: SITE.name, url: SITE.url },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      logo: { "@type": "ImageObject", url: absoluteUrl("/skillflux-mark.svg") }
    },
    mainEntityOfPage: absoluteUrl(canonicalPath)
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.label,
      ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {})
    }))
  }
];
---

<BaseLayout lang={lang} alternateLanguages={[lang]} title={data.title} description={data.description} canonicalPath={canonicalPath} jsonLd={jsonLd} articleDates={{ published: data.datePublished, modified: data.dateModified }}>
  <main id="main-content" class="page-shell">
    <article class="insight">
      <PageHeader title={data.title} eyebrow={t.eyebrow} lede={data.description} breadcrumb={breadcrumbItems} breadcrumbLabel={copy.breadcrumb.insights}>
        <p class="content-disclosure">本文是基于原始资料的编辑分析，不是 SkillFlux 的实测报告。文中对 Skill 能力的描述来自其原始文档与源码，效果请在自己的任务中验证。</p>
        <p class="page-meta">{t.industryLabel}: {data.industry} · {t.updatedPrefix} <time datetime={data.dateModified}>{data.dateModified}</time> · {t.sourceAuthor}: {data.source.author}</p>
      </PageHeader>

      <div class="insight-body prose">
        <aside class="callout callout-accent insight-tldr" aria-label={t.tldrLabel}>
          <p class="insight-block-kicker">{t.tldrLabel}</p>
          <p class="insight-tldr-text">{data.tldr}</p>
        </aside>

        <section>
          <h2>{t.scenariosTitle}</h2>
          <ul class="insight-scenarios">
            {data.scenarios.map((scenario) => <li>{scenario}</li>)}
          </ul>
        </section>

        <section>
          <h2>{t.painPointsTitle}</h2>
          <div class="table-scroll"><table class="data-table insight-table">
            <thead>
              <tr>
                <th>{t.painHeader}</th>
                <th>{t.solutionHeader}</th>
              </tr>
            </thead>
            <tbody>
              {data.painPoints.map((item) => (
                <tr>
                  <td>{item.pain}</td>
                  <td>{item.solution}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        </section>

        <section>
          <h2>{t.workflowTitle}</h2>
          <ol class="insight-workflow">
            {data.workflow.map((item) => (
              <li>
                <strong>{item.step}</strong>
                <p>{item.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <section>
          <h2>{t.judgmentsTitle}</h2>
          <ul class="insight-judgments">
            {data.judgments.map((judgment) => <li>{judgment}</li>)}
          </ul>
        </section>

        <section>
          <h2>{t.deepDiveTitle}</h2>
          <div class="insight-prose">
            <Content />
          </div>
        </section>

        <section>
          <h2>{t.limitationsTitle}</h2>
          <ul>
            {data.limitations.map((limitation) => <li>{limitation}</li>)}
          </ul>
        </section>

        <section class="card insight-source">
          <h2>{t.sourceTitle}</h2>
          <dl>
            <div>
              <dt>{t.sourceRepo}</dt>
              <dd><a href={data.source.repo} rel="noopener noreferrer">{data.source.repo}</a></dd>
            </div>
            <div>
              <dt>{t.sourceAuthor}</dt>
              <dd>
                {data.source.authorUrl
                  ? <a href={data.source.authorUrl} rel="noopener noreferrer">{data.source.author}</a>
                  : data.source.author}
              </dd>
            </div>
            <div>
              <dt>{t.sourceLicense}</dt>
              <dd>{data.source.license}</dd>
            </div>
          </dl>
          <p class="insight-source-note">{t.sourceNote}</p>
          <a class="insight-source-visit" href={data.source.repo} rel="noopener noreferrer">{t.visitRepo} →</a>
        </section>

        {relatedSites.length > 0 && (
          <section>
            <h2>{t.relatedTitle}</h2>
            <div class="insight-related">
              {relatedSites.map((site) => {
                const siteCopy = getSiteCopy(site, lang);
                return (
                  <a class="card insight-related-card" href={localizePath(`/resource/${site.resourceSlug}/`, lang)}>
                    <strong>{siteCopy.name}</strong>
                    <span>{siteCopy.tagline}</span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <p class="insight-machine-note">{t.machineNote}</p>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .insight-body > section > h2 { margin-top: 40px; }
  .insight-block-kicker { margin: 0 0 8px; color: var(--muted); font: 500 .75rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .insight-tldr-text { line-height: 1.7; }
  .insight-table { font-size: .9rem; }
  .insight-table td { line-height: 1.65; }
  .insight-workflow li { margin-bottom: 14px; }
  .insight-workflow li p { margin: 4px 0 0; color: var(--muted); line-height: 1.7; }
  .insight-prose :global(h2), .insight-prose :global(h3) { margin: 26px 0 10px; font-size: 1.15rem; }
  .insight-source { margin-top: 40px; }
  .insight-body > .insight-source > h2 { margin-top: 0; }
  .insight-source dl { display: grid; gap: 10px; margin: 0 0 14px; }
  .insight-source dt { color: var(--muted); font: 500 .75rem var(--font-mono); }
  .insight-source dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .insight-source-note { color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .insight-source-visit { font-weight: 500; text-decoration: none; }
  .insight-related { display: grid; gap: 12px; }
  .insight-related-card { display: grid; gap: 4px; padding: 16px 18px; }
  .insight-related-card strong { font-weight: 600; transition: color .15s ease; }
  .insight-related-card:hover strong { color: var(--accent); }
  .insight-related-card span { color: var(--muted); font-size: .9rem; }
  .insight-machine-note { margin: 36px 0 0; color: var(--muted); font: .82rem/1.7 var(--font-mono); }
</style>
