---
import SitePage from "../../../components/SitePage.astro";
import { getSites } from "../../../lib/content";
import { langStaticPaths } from "../../../lib/i18n";

export function getStaticPaths() {
  return langStaticPaths().flatMap(({ params, props }) => getSites().map((site) => ({
    params: { ...params, slug: site.resourceSlug },
    props: { ...props, site }
  })));
}

const { site, lang } = Astro.props;
---
<SitePage site={site} lang={lang} />
