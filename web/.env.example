# Astro development falls back to http://127.0.0.1:8787 when this is unset.
# Live console/inquiry/report API only. Public catalog pages use a signed build snapshot.
# Production builds must set this explicitly. Use / for the bundled nginx proxy.
PUBLIC_REGISTRY_URL=http://127.0.0.1:8787

SITE_URL=http://127.0.0.1:4321

# Publication scripts require the process environment or explicit CLI flags; they do not load this file.
# SKILLFLUX_REGISTRY_URL=https://registry.example
# SKILLFLUX_PUBLICATION_KEY=/absolute/path/registry-public-key.json
# SKILLFLUX_PUBLICATION_PATH=/absolute/path/registry-publication.json
# SKILLFLUX_PUBLICATION_OUTPUT=/absolute/path/skillflux-publication/current
