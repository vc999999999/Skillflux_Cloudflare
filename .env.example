# Docker Compose / production operator configuration.
# Copy to .env for Compose. npm/Node do not automatically inherit this file.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SKILLFLUX_ADMIN_TOKEN=
SKILLFLUX_PUBLIC_URL=http://localhost:8080
SKILLFLUX_ALLOWED_ORIGINS=http://localhost:8080
SKILLFLUX_WEB_PORT=8080
SITE_URL=http://localhost:8080
# Optional exact proxy IPs. Never trust arbitrary client-provided forwarding headers.
SKILLFLUX_TRUSTED_PROXIES=

# Static publication tools need an absolute Registry origin, not the browser's / proxy.
# Supply these explicitly to npm via the process environment or CLI flags.
# SKILLFLUX_REGISTRY_URL=https://registry.example
# SKILLFLUX_PUBLICATION_KEY=/absolute/path/to/registry-public-key.json
# publication:sync writes this snapshot, then rebuild Web:
# SKILLFLUX_PUBLICATION_PATH=/absolute/path/to/skillflux/web/data/registry-publication.json
# publication:build/watch instead atomically switches this pointer; serve POINTER/dist:
# SKILLFLUX_PUBLICATION_OUTPUT=/absolute/path/to/skillflux/web/.publication/current
