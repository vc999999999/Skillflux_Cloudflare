# Cloud registry process only. Do not send the admin token to end users.
SKILLFLUX_HOST=127.0.0.1
SKILLFLUX_PORT=8787
# Relative paths use the process working directory; this example assumes the repository root.
SKILLFLUX_DATA_DIR=./mcp/var
SKILLFLUX_PUBLIC_URL=http://127.0.0.1:8787
SKILLFLUX_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Set a high-entropy value for operator API access. Without it admin is disabled.
SKILLFLUX_ADMIN_TOKEN=
# Comma-separated exact addresses of trusted reverse proxies; empty means none.
SKILLFLUX_TRUSTED_PROXIES=
