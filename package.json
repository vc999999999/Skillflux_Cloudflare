{
  "name": "skillflux",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "bench"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @skillflux/web -- --host 127.0.0.1",
    "build": "npm run build --workspace @skillflux/web",
    "preview": "npm run preview --workspace @skillflux/web",
    "test": "npm test --workspace @skillflux/bench && npm test --workspace @skillflux/web",
    "typecheck": "npm run typecheck --workspace @skillflux/bench && npm run typecheck --workspace @skillflux/web",
    "validate": "npm run validate --workspace @skillflux/web",
    "deploy": "npm run deploy --workspace @skillflux/web",
    "bench": "npm run bench --workspace @skillflux/bench --",
    "health": "npm run health --workspace @skillflux/bench --"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "yaml-language-server": "^1.23.0"
  }
}
