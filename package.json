{
  "name": "skillflux",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "mcp",
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @skillflux/web -- --host 127.0.0.1",
    "build": "npm run build --workspace @skillflux/mcp && npm run build --workspace @skillflux/web",
    "preview": "npm run preview --workspace @skillflux/web",
    "test": "npm test --workspace @skillflux/mcp && npm test --workspace @skillflux/web",
    "typecheck": "npm run typecheck --workspace @skillflux/mcp && npm run typecheck --workspace @skillflux/web",
    "validate": "npm run validate --workspace @skillflux/web",
    "pack:mcp": "npm pack --workspace @skillflux/mcp",
    "smoke:package": "node scripts/smoke-package.mjs",
    "publication:sync": "npm run publication:sync --workspace @skillflux/web",
    "publication:build": "npm run publication:build --workspace @skillflux/web",
    "publication:watch": "npm run publication:watch --workspace @skillflux/web"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "yaml-language-server": "^1.23.0"
  }
}
